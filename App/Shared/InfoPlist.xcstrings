  "strings": {
    "CFBundleDisplayName": {
      "comment": "The app's name under its icon. DELOS is never translated. The catalog also gives the app bundle its languages, so iOS shows the package's strings in the user's language.",
      "extractionState": "manual",
      "localizations": {
