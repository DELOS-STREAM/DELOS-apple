// Build settings shared by every configuration of the DELOS app target. The personal values (the signing team) are
// in Config/Local.xcconfig, which is not tracked: copy Config/Local.example.xcconfig to create it.

PRODUCT_NAME = DELOS
PRODUCT_BUNDLE_IDENTIFIER = io.github.meitoncz.delos
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = auto
SUPPORTED_PLATFORMS = iphoneos iphonesimulator appletvos appletvsimulator macosx
ALWAYS_SEARCH_USER_PATHS = NO
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
TARGETED_DEVICE_FAMILY = 1,2,3
IPHONEOS_DEPLOYMENT_TARGET = 18.0
TVOS_DEPLOYMENT_TARGET = 18.0
MACOSX_DEPLOYMENT_TARGET = 15.0

SWIFT_VERSION = 6.0
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
// The package's OpenSSL is a dynamic framework embedded in the app: the app must find it in its Frameworks folder
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
// A macOS bundle keeps its frameworks in Contents/Frameworks, next to Contents/MacOS
LD_RUNPATH_SEARCH_PATHS[sdk=macosx*] = $(inherited) @executable_path/../Frameworks
CODE_SIGN_STYLE = Automatic

GENERATE_INFOPLIST_FILE = YES
// Arrays (NSBonjourServices, UIBackgroundModes) and keys without an INFOPLIST_KEY_* setting (CADisableMinimumFrameDurationOnPhone) cannot
// be written here; they are in this partial plist.
INFOPLIST_FILE = Config/Info.plist
INFOPLIST_KEY_NSLocalNetworkUsageDescription = DELOS uses the local network to find your gaming PC and stream from it.
INFOPLIST_KEY_CFBundleDisplayName = DELOS
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.games
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
// The full-screen and status bar keys are iOS and iPadOS keys; the Apple TV build does not carry them
INFOPLIST_KEY_UIRequiresFullScreen[sdk=iphone*] = YES
INFOPLIST_KEY_UIStatusBarHidden[sdk=iphone*] = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_GCSupportsControllerUserInteraction = YES
// iPhone and iPad: the app's Documents folder shows in the Files app as DELOS, where a problem report saves its cleaned log
INFOPLIST_KEY_UIFileSharingEnabled[sdk=iphone*] = YES

// The app icon (App/Shared/Assets.xcassets, drawn by tools/icon/generate_app_icon.py from the Android icon's vector).
// One name for Debug and Release, so both builds carry the same icon. tvOS takes its layered icon and the Top Shelf
// images from a brand assets folder instead of an icon set.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_APPICON_NAME[sdk=appletv*] = App Icon & Top Shelf Image

// macOS: App Sandbox (network client and server for Bonjour and the stream, see Config/DELOS-macOS.entitlements) and
// the hardened runtime. A build without a team is signed ad hoc (tools/mac.sh), which the data protection keychain
// does not accept: the Mac keeps its secrets in the login keychain (KeychainStorage).
// tools/mac.sh signs ad hoc with DELOS_ENTITLEMENTS=DELOS-macOS-adhoc.entitlements (library validation off)
DELOS_ENTITLEMENTS = DELOS-macOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/$(DELOS_ENTITLEMENTS)
ENABLE_HARDENED_RUNTIME[sdk=macosx*] = YES
// The scene manifest and the launch screen of UIKit mean nothing on the Mac
INFOPLIST_KEY_UIApplicationSceneManifest_Generation[sdk=macosx*] = NO
INFOPLIST_KEY_UILaunchScreen_Generation[sdk=macosx*] = NO
INFOPLIST_KEY_NSHumanReadableCopyright[sdk=macosx*] = DELOS for Apple is free software under the GNU General Public License, version 3.

// Empty disables all game metadata requests. The optional local file overrides this value.
DELOS_METADATA_URL =

// The Delos report service (docs/DIAGNOSTICS.md, "The report service"). Empty: a report saves the cleaned log as a file and
// nothing is uploaded. The optional local file overrides this value.
DELOS_REPORTS_URL =

#include? "Local.xcconfig"
