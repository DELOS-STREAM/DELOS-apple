<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
Entitlements of the macOS build (Config/Shared.xcconfig, CODE_SIGN_ENTITLEMENTS[sdk=macosx*]).
- App Sandbox: the app reads and writes only its own container.
- Network client: HTTP(S) to the PC, the stream, SteamGridDB, the metadata Worker.
- Network server: Bonjour discovery (NWBrowser) and the stream's UDP sockets receive datagrams.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
