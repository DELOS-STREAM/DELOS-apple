    "metadata_error_update": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Informace o hře se nepodařilo aktualizovat. Otevři Metadata a obnov je, nebo vyber shodu."
          }
