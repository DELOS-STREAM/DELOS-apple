    "settings_native_diag_logs_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovává malý záznam toho, co aplikace Delos dělala, pro hlášení problému. Zůstává na tomto zařízení, dokud ho nesdílíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt ein kleines Protokoll darüber, was Delos getan hat, für einen Problembericht. Bleibt auf diesem Gerät, außer du teilst es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a small log of what Delos did, for a problem report. Stays on this device unless you share it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un pequeño registro de lo que ha hecho Delos, para informar de un problema. Se queda en este dispositivo salvo que lo compartas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde un petit journal de ce qu’a fait Delos, pour un rapport de problème. Reste sur cet appareil sauf si tu le partages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題報告用に、Delosの動作の小さなログを保存します。共有しない限り、この端末から出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 신고에 쓸 수 있도록 Delos의 동작을 짧게 기록해 둬요. 직접 공유하지 않는 한 이 기기에만 남아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda um pequeno log do que o app Delos fez, para um relatório de problema. Fica neste dispositivo, a menos que você o compartilhe."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веде невеликий журнал дій Delos для звіту про проблему. Лишається на цьому пристрої, поки ти ним не поділишся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留一份记录 Delos 操作的小型日志，用于问题反馈。除非你分享，否则只保存在此设备上。"
          }
        }
      }
    },
