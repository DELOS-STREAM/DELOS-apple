    "debug_share_description_apple": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře sdílecí nabídku s textem zobrazeným v náhledu. Nic se neodešle, dokud nevybereš aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Teilen-Menü mit dem Text aus der Vorschau. Es wird nichts gesendet, bis du eine App wählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the share sheet with the text shown in the preview. Nothing is sent until you pick an app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el menú de compartir con el texto de la vista previa. No se envía nada hasta que elijas una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la feuille de partage avec le texte affiché dans l’aperçu. Rien n’est envoyé tant que tu n’as pas choisi une appli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューに表示されているテキストで共有シートを開きます。アプリを選ぶまで何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에 표시된 텍스트로 공유 시트를 열어요. 앱을 선택하기 전에는 아무것도 전송되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a tela de compartilhamento com o texto exibido na prévia. Nada é enviado até você escolher um app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває меню «Поділитися» з текстом із попереднього перегляду. Нічого не надсилається, доки ти не обереш застосунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用预览中显示的文本打开分享面板。选择应用之前不会发送任何内容。"
          }
        }
      }
    },
