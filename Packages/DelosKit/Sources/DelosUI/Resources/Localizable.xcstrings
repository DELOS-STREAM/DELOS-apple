        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "suporta %1$@; %2$@ precisa de %3$@, cerca de %4$@ de imagem após FEC e overhead."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "тягне %1$@; для %2$@ потрібно %3$@, на зображення лишається близько %4$@ після FEC і службових даних."
