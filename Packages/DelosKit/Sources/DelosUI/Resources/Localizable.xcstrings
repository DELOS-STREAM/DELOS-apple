    "devices_start_pair_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spáruj PC a můžeš začít hrát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel einen PC, um loszuspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair a PC to start playing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un PC para empezar a jugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associe un PC pour commencer à jouer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCをペアリングして、プレイを始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC를 페어링하면 플레이를 시작할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pareie um PC para começar a jogar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створи пару з ПК, щоб почати грати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对一台 PC，开始游戏。"
          }
        }
      }
    },
