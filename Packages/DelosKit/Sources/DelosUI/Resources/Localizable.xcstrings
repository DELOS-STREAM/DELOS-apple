    "help_frame_pacing_balanced": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobí snímky obnovování displeje s malou frontou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt Frames mit einer kleinen Warteschlange an die Display-Wiederholrate an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches frames to the display refresh with a small queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta los fotogramas a la frecuencia de la pantalla con una cola pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligne les images sur la fréquence de l’écran avec une petite file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さなキューで、フレームをディスプレイのリフレッシュに合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 큐로 프레임을 디스플레이 주사율에 맞춰요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta os quadros à atualização da tela com uma fila pequena."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Узгоджує кадри з оновленням екрана з малою чергою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用小型队列让帧与屏幕刷新保持一致。"
          }
        }
      }
    },
    "help_frame_pacing_latency": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí nejnovější snímek hned; může sekat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt sofort das neueste Bild; kann ruckeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the newest frame at once; may stutter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra al instante el fotograma más reciente; puede entrecortarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche aussitôt l’image la plus récente ; peut saccader."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のフレームをすぐに表示します。カクつくことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최신 프레임을 바로 표시해요. 끊길 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o quadro mais recente na hora; pode travar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу показує найновіший кадр; можливі підвисання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即显示最新一帧；可能卡顿。"
          }
        }
      }
    },
    "help_frame_pacing_smoothness": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovnoměrné doručování; přidává buffering a latenci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßige Lieferung; erhöht Pufferung und Latenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady delivery; adds buffering and latency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega constante; añade búfer y latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Livraison régulière ; ajoute de la mise en tampon et de la latence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定して配信しますが、バッファリングと遅延が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정하게 전달해요. 버퍼링과 지연이 늘어나요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega estável; adiciona buffer e latência."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівна подача; додає буферизацію й затримку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定输出；会增加缓冲和延迟。"
          }
        }
      }
    },
    "help_list_fps": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet snímků za sekundu, který PC posílá. Přizpůsob ho svému displeji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder pro Sekunde, die der PC sendet. Passe sie an dein Display an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frames per second the PC sends. Match your display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotogramas por segundo que envía el PC. Iguálalo a tu pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Images par seconde envoyées par le PC. Adapte-les à ton écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCが送信する毎秒のフレーム数です。ディスプレイに合わせてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC가 보내는 초당 프레임 수예요. 디스플레이에 맞춰 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quadros por segundo enviados pelo PC. Combine com a sua tela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кадрів за секунду від ПК. Вибери під свій екран."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 每秒发送的帧数。请与屏幕刷新率保持一致。"
          }
        }
      }
    },
    "help_list_languages": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jazyk rozhraní, jeho nápovědy a zpráv streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache der Oberfläche, ihrer Hilfe und der Stream-Meldungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language of the shell, its help and the stream messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma de la interfaz, su ayuda y los mensajes del stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Langue de l’interface, de son aide et des messages du stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シェル、そのヘルプ、ストリームメッセージの言語です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "셸, 도움말, 스트림 메시지의 언어예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Idioma da interface, da ajuda e das mensagens do stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мова оболонки, її довідки й повідомлень стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面、帮助以及串流消息使用的语言。"
          }
        }
      }
    },
    "help_list_resolution": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozlišení, které PC posílá. Víc pixelů znamená víc detailů i větší zátěž."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auflösung, die der PC sendet. Mehr Pixel bedeuten mehr Details und mehr Last."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolution the PC sends. More pixels mean more detail and load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolución que envía el PC. Más píxeles significan más detalle y más carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résolution envoyée par le PC. Plus de pixels, c’est plus de détails et plus de charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCが送信する解像度です。ピクセル数が多いほど精細になり、負荷も増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC가 보내는 해상도예요. 픽셀이 많을수록 디테일이 살아나지만 부하도 커져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolução enviada pelo PC. Mais pixels significam mais detalhe e mais carga."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Роздільна здатність, яку надсилає ПК. Більше пікселів — більше деталей і навантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 发送的分辨率。像素越多，画面越细腻，负载也越高。"
          }
        }
      }
    },
    "help_note_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená volba není dostupná"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Auswahl ist nicht verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved choice is unavailable"
          }
        },
        "es": {
          "stringUnit": {
