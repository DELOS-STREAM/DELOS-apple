        }
      }
    },
    "help_seekbar_touchpad_sensitivity_opacity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodorovná citlivost ukazatele pro režim trackpadu na dotykové obrazovce a vlastní virtuální touchpady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontale Zeigerempfindlichkeit für den Touchscreen-Trackpad-Modus und eigene virtuelle Touchpads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal pointer sensitivity for touchscreen trackpad mode and custom virtual touchpads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidad horizontal del puntero para el modo de trackpad de la pantalla táctil y los paneles táctiles virtuales personalizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilité horizontale du pointeur pour le mode trackpad tactile et les pavés tactiles virtuels personnalisés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチスクリーンのトラックパッドモードと、カスタム仮想タッチパッドの横方向のポインター感度です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치스크린 트랙패드 모드와 사용자 지정 가상 터치패드의 가로 포인터 감도예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidade horizontal do ponteiro no modo trackpad da tela touch e em touchpads virtuais personalizados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальна чутливість вказівника в режимі трекпада на сенсорі й для власних віртуальних тачпадів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸屏触控板模式和自定义虚拟触控板的水平指针灵敏度。"
          }
        }
      }
    },
    "help_seekbar_touchpad_sensitivity_y_opacity": {
