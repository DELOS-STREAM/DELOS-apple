    "debug_kick_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Začne z ticha nárazem plnou silou a pak se ustálí na přeložené amplitudě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet aus der Stille mit einem Kick voller Stärke und pendelt sich dann auf die übersetzte Amplitude ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start from silence with a full-strength kick, then settle to the translated amplitude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arranca desde el silencio con un impulso a plena intensidad y luego se estabiliza en la amplitud traducida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre du silence par un coup à pleine intensité, puis se stabilise sur l’amplitude traduite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無振動から最大の強さでキックして始まり、その後、変換された振幅に落ち着きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무진동 상태에서 최대 세기의 킥으로 시작한 뒤 변환된 진폭으로 안정돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa do silêncio com um impulso em força máxima e depois se estabiliza na amplitude traduzida."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старт із тиші з поштовхом на повну силу, потім перехід до перетвореної амплітуди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从静止开始先以全力冲击，再逐渐稳定到转换后的振幅。"
          }
        }
      }
    },
