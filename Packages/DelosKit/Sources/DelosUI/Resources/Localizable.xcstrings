    "artwork_no_key_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení → Obaly → Klíč API SteamGridDB. Je zdarma na steamgriddb.com (Preferences → API)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen → Cover → SteamGridDB-API-Schlüssel. Er ist kostenlos auf steamgriddb.com (Preferences → API)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings → Covers → SteamGridDB API key. It is free on steamgriddb.com (Preferences → API)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes → Portadas → Clave de API de SteamGridDB. Es gratis en steamgriddb.com (Preferences → API)."
          }
        },
        "fr": {
