    "settings_native_sgdb_auto_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při načtení knihovny stáhne u nových aplikací nejlépe hodnocený obal, široký obal, pozadí a logo ze SteamGridDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt beim Laden der Bibliothek für neue Apps das bestbewertete Cover, breite Cover, Hintergrund und Logo von SteamGridDB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches SteamGridDB's best-rated cover, wide cover, background and logo for new apps when the library loads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene la portada, la portada panorámica, el fondo y el logo mejor valorados de SteamGridDB para las apps nuevas al cargar la biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère la jaquette, la jaquette large, l’arrière-plan et le logo les mieux notés de SteamGridDB pour les nouvelles applis au chargement de la bibliothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの読み込み時に、新しいアプリについてSteamGridDBで最高評価のカバー、ワイドカバー、背景、ロゴを取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리를 불러올 때 새 앱에 SteamGridDB에서 평점이 가장 높은 커버, 와이드 커버, 배경, 로고를 가져와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca no SteamGridDB a capa, a capa larga, o fundo e o logo mais bem avaliados dos apps novos ao carregar a biblioteca."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час завантаження бібліотеки бере з SteamGridDB найкраще оцінені обкладинку, широку обкладинку, тло та логотип для нових застосунків."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用库加载时，为新应用获取 SteamGridDB 上评分最高的封面、横版封面、背景和标志。"
          }
        }
      }
    },
