            "value": "La opción guardada no está disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le choix enregistré est indisponible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した選択肢は利用できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 선택을 사용할 수 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escolha salva está indisponível"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережений вибір недоступний"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的选项不可用"
          }
        }
      }
    },
    "help_video_format": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodek, kterým PC kóduje; PC i dekodér ho musí podporovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec, mit dem der PC kodiert; Host und Decoder müssen ihn unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec the PC encodes with; host and decoder must support it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Códec con el que codifica el PC; el host y el decodificador deben admitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec avec lequel le PC encode ; le PC et le décodeur doivent le gérer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCがエンコードに使うコーデックです。ホストとデコーダーが対応している必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC가 인코딩에 사용할 코덱이에요. 호스트와 디코더가 지원해야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec usado pelo PC para codificar; PC e decodificador precisam suportá-lo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодек, яким кодує ПК; його мають підтримувати хост і декодер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 使用的编码格式；电脑端和解码器都必须支持。"
          }
        }
      }
    },
    "help_video_format_auto": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybere H.264 nebo HEVC. AV1 a PyroWave je potřeba vybrat ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt H.264 oder HEVC. AV1 und PyroWave müssen gewählt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks H.264 or HEVC. AV1 and PyroWave need selecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige H.264 o HEVC. AV1 y PyroWave hay que seleccionarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit H.264 ou HEVC. AV1 et PyroWave doivent être sélectionnés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264またはHEVCを自動で選びます。AV1とPyroWaveは、選択が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 또는 HEVC를 골라요. AV1과 PyroWave는 직접 선택해야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe H.264 ou HEVC. AV1 e PyroWave precisam ser selecionados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирає H.264 або HEVC. AV1 і PyroWave треба вибирати вручну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动选择 H.264 或 HEVC。AV1 和 PyroWave 需要手动选择。"
          }
        }
      }
    },
    "help_video_format_forceav1": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Efektivní při nízkém bitrate. Vyžaduje kódování AV1 v PC a dekódování tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Effizient bei niedrigen Bitraten. Erfordert AV1-Encoding am Host und Decoding hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Efficient at low bitrates. Needs AV1 encode on the host and decode here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eficiente con bitrates bajos. Requiere codificación AV1 en el host y decodificación aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efficace à bas débit. Nécessite l’encodage AV1 sur le PC et le décodage ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低ビットレートで効率的です。ホストでのAV1エンコードと、この端末でのデコードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 비트레이트에서 효율적이에요. 호스트의 AV1 인코딩과 이 기기의 디코딩이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eficiente em bitrates baixos. Requer codificação AV1 no PC e decodificação aqui."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ефективний на низьких бітрейтах. Потрібне кодування AV1 на хості й декодування тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低码率下效率高。需要电脑端支持 AV1 编码，且本机支持 AV1 解码。"
          }
        }
      }
    },
    "help_video_format_forceh265": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Méně šířky pásma než H.264; podporuje 10bitové HDR. Může se vrátit na jiný kodek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Bandbreite als H.264; unterstützt 10-Bit-HDR. Kann zurückfallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less bandwidth than H.264; supports 10-bit HDR. May fall back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos ancho de banda que H.264; admite HDR de 10 bits. Puede volver a otro códec."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de bande passante que H.264 ; gère le HDR 10 bits. Peut se rabattre sur autre chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264より帯域が少なく、10ビットHDRに対応します。切り替わる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264보다 대역폭이 적게 들고 10비트 HDR을 지원해요. 다른 코덱으로 바뀔 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa menos largura de banda que H.264; suporta HDR de 10 bits. Pode voltar ao padrão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менше трафіку, ніж H.264; підтримує 10-бітний HDR. Можливий відкат на інший кодек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比 H.264 占用更少带宽；支持 10-bit HDR。可能回退。"
          }
        }
      }
    },
    "help_video_format_neverh265": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejširší kompatibilita; potřebuje víc šířky pásma. Bez HDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breiteste Kompatibilität; braucht mehr Bandbreite. Kein HDR."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadest compatibility; needs more bandwidth. No HDR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor compatibilidad; necesita más ancho de banda. Sin HDR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibilité maximale ; demande plus de bande passante. Pas de HDR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も互換性が高いですが、帯域が多く必要です。HDRは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환성이 가장 넓지만 대역폭이 더 필요해요. HDR은 사용할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibilidade mais ampla; requer mais largura de banda. Sem HDR."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найширша сумісність; потрібно більше трафіку. Без HDR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容性最广；需要更多带宽。不支持 HDR。"
          }
        }
      }
    },
