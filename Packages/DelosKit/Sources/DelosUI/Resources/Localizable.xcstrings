    "help_checkbox_host_audio": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrává zvuk aplikace i na PC, nejen tady. Vypni, aby reproduktory PC mlčely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt den App-Ton auf dem PC und hier wieder. Ausschalten, damit die PC-Lautsprecher still bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays app audio on the PC as well as here. Turn off to keep the PC speakers quiet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el audio de la app también en el PC. Desactívalo para que los altavoces del PC no suenen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue le son de l’appli sur le PC en plus d’ici. Désactive pour garder les haut-parleurs du PC silencieux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音声を、こちらに加えてPCでも再生します。PCのスピーカーを静かにしたい場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오를 여기뿐 아니라 PC에서도 재생해요. PC 스피커를 조용히 두려면 꺼 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz o áudio do app no PC além daqui. Desative para manter as caixas de som do PC em silêncio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворює звук застосунку і на ПК, і тут. Вимкни, щоб динаміки ПК мовчали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用声音同时在 PC 上播放。关闭后 PC 扬声器保持安静。"
          }
        }
      }
    },
    "help_dynamic_resolution": {
      "extractionState": "manual",
