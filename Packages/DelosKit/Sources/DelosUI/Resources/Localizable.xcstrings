    "clipboard_sync_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento server nepodporuje synchronizaci schránky. Nainstaluj nebo aktualizuj server na nejnovější verzi Apollo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server unterstützt keinen Zwischenablage-Abgleich. Installiere die neueste Version von Apollo oder aktualisiere deinen Server darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server does not support clipboard sync. Please install or upgrade your server to the latest version of Apollo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no admite la sincronización del portapapeles. Instala o actualiza tu servidor a la última versión de Apollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne gère pas la synchro du presse-papiers. Installe ou mets à jour ton serveur avec la dernière version d’Apollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーはクリップボード同期に対応していません。サーバーを最新版のApolloにインストールまたはアップグレードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 클립보드 동기화를 지원하지 않아요. 서버를 최신 버전의 Apollo로 설치하거나 업그레이드해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não é compatível com a sincronização da área de transferência. Instale ou atualize seu servidor para a versão mais recente do Apollo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сервер не підтримує синхронізацію буфера обміну. Встанови або онови сервер до останньої версії Apollo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器不支持剪贴板同步。请安装或将服务器升级到最新版本的 Apollo。"
          }
        }
      }
    },
