        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 가득 채워요. 화면 비율이 다르면 잘려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche a tela; corta se as proporções diferirem."
