          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung: Deine aktive Netzwerkverbindung ist getaktet!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: Your active network connection is metered!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: ¡tu conexión de red activa es de datos limitados!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
