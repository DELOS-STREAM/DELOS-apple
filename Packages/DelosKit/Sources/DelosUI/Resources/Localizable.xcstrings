          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o log. Compartilhe-o em Configurações → Sobre → Informações de depuração."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти журнал. Поділися ним у Налаштування → Про застосунок → Налагодження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存日志。请在 设置 > 关于 > 调试信息 中分享。"
          }
        }
      }
    },
