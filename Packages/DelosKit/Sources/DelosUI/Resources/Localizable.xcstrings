    "artwork_no_game_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledání pod jiným názvem ji najde pod jménem, které zná SteamGridDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit „Nach anderem Namen suchen“ findest du es unter dem Namen, den SteamGridDB kennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for another name finds it under the name SteamGridDB knows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar otro nombre lo encuentra con el nombre que conoce SteamGridDB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chercher un autre nom le trouve sous le nom que SteamGridDB connaît."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「別の名前で検索」で、SteamGridDBに登録されている名前から探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이름으로 검색하면 SteamGridDB에 등록된 이름으로 찾을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar por outro nome o encontra pelo nome que o SteamGridDB conhece."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Шукати за іншою назвою» знайде її під назвою, яку знає SteamGridDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索其他名称，即可找到 SteamGridDB 收录的对应名称。"
