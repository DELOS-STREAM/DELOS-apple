    "debug_report_save_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží stejný vyčištěný záznam do Stažených a otevře koncept na GitHubu, kam ho přiložíš. Nic se nenahrává."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert dasselbe bereinigte Protokoll in Downloads und öffnet den GitHub-Entwurf, an den du es anhängst. Es wird nichts hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the same cleaned log to Downloads and opens the GitHub draft for you to attach it. Nothing is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el mismo registro limpio en Descargas y abre el borrador de GitHub para que lo adjuntes. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le même journal nettoyé dans Téléchargements et ouvre le brouillon GitHub pour que tu le joignes. Rien n’est envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ整理済みのログをダウンロードフォルダに保存し、添付できるようにGitHubの下書きを開きます。何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 정리된 로그를 다운로드 폴더에 저장하고, 첨부할 수 있도록 GitHub 초안을 열어요. 아무것도 업로드되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva o mesmo log limpo em Downloads e abre o rascunho do GitHub para você anexá-lo. Nada é enviado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає той самий очищений журнал у Завантаження й відкриває чернетку GitHub, щоб ти його додав. Нічого не надсилається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把同一份清理后的日志保存到“下载”文件夹，并打开 GitHub 草稿供你附加。不会上传任何内容。"
          }
        }
      }
    },
    "debug_report_save_description_files": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží stejný vyčištěný záznam do Souborů (složka DELOS) a otevře koncept na GitHubu, kam ho přiložíš. Nic se nenahrává."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert dasselbe bereinigte Protokoll in Dateien (Ordner DELOS) und öffnet den GitHub-Entwurf, an den du es anhängst. Es wird nichts hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the same cleaned log to Files (DELOS folder) and opens the GitHub draft for you to attach it. Nothing is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el mismo registro limpio en Archivos (carpeta DELOS) y abre el borrador de GitHub para que lo adjuntes. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le même journal nettoyé dans Fichiers (dossier DELOS) et ouvre le brouillon GitHub pour que tu le joignes. Rien n’est envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ整理済みのログを「ファイル」（DELOSフォルダ）に保存し、添付できるようにGitHubの下書きを開きます。何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 정리된 로그를 파일 앱(DELOS 폴더)에 저장하고, 첨부할 수 있도록 GitHub 초안을 열어요. 아무것도 업로드되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva o mesmo log limpo em Arquivos (pasta DELOS) e abre o rascunho do GitHub para você anexá-lo. Nada é enviado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає той самий очищений журнал у Файли (папка DELOS) й відкриває чернетку GitHub, щоб ти його додав. Нічого не надсилається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把同一份清理后的日志保存到“文件”（DELOS 文件夹），并打开 GitHub 草稿供你附加。不会上传任何内容。"
          }
        }
      }
    },
    "debug_reset_description": {
      "extractionState": "manual",
      "localizations": {
