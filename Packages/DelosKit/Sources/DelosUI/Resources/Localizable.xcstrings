    "help_async_decode_frames": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekodér vrací snímky asynchronně, místo aby se čekalo na každý zvlášť. Jen pro H.264, HEVC a AV1. Vypni, pokud je dekódování nestabilní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Decoder liefert Frames asynchron, statt auf jeden einzeln zu warten. Nur H.264, HEVC und AV1. Ausschalten, wenn das Decodieren instabil ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The decoder returns frames asynchronously instead of waiting for each one. H.264, HEVC and AV1 only. Turn off if decoding is unstable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El decodificador entrega los fotogramas de forma asíncrona en lugar de esperar a cada uno. Solo H.264, HEVC y AV1. Desactívalo si la decodificación es inestable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le décodeur rend les images de façon asynchrone au lieu d’attendre chacune. H.264, HEVC et AV1 uniquement. Désactive si le décodage est instable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームを1枚ずつ待たずに、デコーダーが非同期で返します。H.264、HEVC、AV1のみ。デコードが不安定な場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프레임마다 기다리지 않고 디코더가 비동기로 프레임을 돌려줘요. H.264, HEVC, AV1에만 적용돼요. 디코딩이 불안정하면 꺼 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O decodificador entrega os quadros de forma assíncrona em vez de esperar por cada um. Apenas H.264, HEVC e AV1. Desative se a decodificação ficar instável."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Декодер повертає кадри асинхронно, а не чекає на кожен окремо. Лише H.264, HEVC і AV1. Вимкни, якщо декодування нестабільне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解码器异步返回帧，而不是逐帧等待。仅限 H.264、HEVC 和 AV1。解码不稳定时请关闭。"
          }
        }
      }
    },
    "help_checkbox_absolute_mouse_mode": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolutní polohování místo relativního pohybu ve hrách. Hodí se pro vzdálenou plochu; mnoho her potřebuje relativní vstup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolute Positionierung statt relativer Spielbewegung. Passt zu Remote-Desktop; viele Spiele brauchen relative Eingabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolute positioning instead of relative game movement. Suits remote desktop; many games need relative input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicionamiento absoluto en lugar del movimiento relativo de los juegos. Va bien para escritorio remoto; muchos juegos necesitan entrada relativa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Positionnement absolu au lieu du mouvement relatif des jeux. Convient au bureau à distance ; beaucoup de jeux exigent l’entrée relative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム内の相対的な動きではなく、絶対位置で指定します。リモートデスクトップ向きで、多くのゲームは相対入力が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대적인 게임 움직임 대신 절대 위치를 사용해요. 원격 데스크톱에 적합하고, 많은 게임은 상대 입력이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posicionamento absoluto em vez de movimento relativo de jogo. Serve para área de trabalho remota; muitos jogos precisam de entrada relativa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Абсолютне позиціонування замість відносного руху в іграх. Підходить для віддаленого робочого столу; багатьом іграм потрібне відносне введення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用绝对定位，而不是游戏中的相对移动。适合远程桌面；许多游戏需要相对输入。"
          }
        }
      }
    },
    "help_checkbox_disable_warnings": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje varování o kvalitě připojení na obrazovce při streamování. Statistiky zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Warnungen zur Verbindungsqualität beim Streamen aus. Die Statistik bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides on-screen connection-quality warnings during streaming. Statistics stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los avisos de calidad de conexión en pantalla durante el streaming. Las estadísticas se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les avertissements de qualité de connexion pendant le stream. Les statistiques restent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミング中の、画面上の接続品質の警告を隠します。統計は表示されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍 중 화면에 표시되는 연결 품질 경고를 숨겨요. 통계는 그대로 표시돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta os avisos de qualidade da conexão na tela durante o stream. As estatísticas continuam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ховає екранні попередження про якість з’єднання під час стріму. Статистика лишається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流时隐藏屏幕上的连接质量警告。统计信息仍会保留。"
          }
        }
      }
    },
    "help_checkbox_enable_analog_stick_new": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Umožní středům virtuálních sticků pohybovat se v jejich oblasti dotyku místo toho, aby zůstaly pevné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die Mittelpunkte virtueller Sticks innerhalb ihres Bedienbereichs wandern, statt fest zu bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets virtual stick centers move within their interaction area instead of staying fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el centro de los sticks virtuales se mueva dentro de su área de interacción en lugar de quedarse fijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse le centre des sticks virtuels bouger dans leur zone d’interaction au lieu de rester fixe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想スティックの中心を固定せず、操作エリア内で動かせるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 스틱의 중심이 고정되지 않고 조작 영역 안에서 움직이게 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa o centro dos analógicos virtuais se mover dentro da área de interação em vez de ficar fixo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє центрам віртуальних стіків переміщуватися в межах області взаємодії, а не стояти на місці."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许虚拟摇杆的中心在其触控区域内移动，而不是固定不动。"
          }
        }
      }
    },
    "help_checkbox_enable_clear_default_special_button": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Skryje vestavěné kombinace kláves z nabídky „Odeslat klávesy“ v menu streamu a nechá jen tvoje importované příkazy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die eingebauten Tastenkombinationen aus „Tasten senden“ im Stream-Menü aus und lässt deine importierten Befehle übrig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides the built-in key combinations from the stream menu's Send keys, leaving your imported commands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las combinaciones de teclas integradas de Enviar teclas del menú del stream y deja tus comandos importados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les combinaisons de touches intégrées dans Envoyer des touches du menu du stream, ne laissant que tes commandes importées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームメニューの「キーを送信」から内蔵のキーの組み合わせを隠し、インポートしたコマンドだけにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림 메뉴의 키 보내기에서 기본 제공 키 조합을 숨기고 가져온 명령만 남겨요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta as combinações de teclas integradas em Enviar teclas no menu do stream, deixando seus comandos importados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ховає вбудовані комбінації клавіш із розділу «Надіслати клавіші» меню стріму, лишаючи імпортовані команди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在串流菜单的发送按键中隐藏内置组合键，只保留你导入的命令。"
          }
        }
      }
    },
    "help_checkbox_enable_commit_text": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předává text z psaní tahem a diktování po částech. Dobré na ploše; některé hry čekají jednotlivé stisky kláves."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitet Text aus Wischtippen und Diktat in Blöcken weiter. Gut am Desktop; manche Spiele erwarten einzelne Tastendrücke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forwards text from swipe typing and dictation in chunks. Good on the desktop; some games expect single key presses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenvía por bloques el texto de la escritura por gestos y del dictado. Bien en el escritorio; algunos juegos esperan pulsaciones de una sola tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmet par blocs le texte de la saisie gestuelle et de la dictée. Pratique sur le bureau ; certains jeux attendent des appuis de touches uniques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワイプ入力や音声入力のテキストを、まとめて転送します。デスクトップ向きで、1キーずつの入力を想定するゲームもあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스와이프 입력과 음성 받아쓰기 텍스트를 묶음으로 전달해요. 데스크톱에서는 좋지만 일부 게임은 키를 하나씩 누르는 입력을 기대해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminha em blocos o texto de digitação por deslize e ditado. Bom na área de trabalho; alguns jogos esperam teclas individuais."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передає текст зі свайп-набору й диктування шматками. Добре на робочому столі; деякі ігри очікують окремих натискань клавіш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将滑行输入和语音输入的文字分块转发。适合在桌面使用；部分游戏需要单个按键。"
          }
        }
      }
    },
    "help_checkbox_enable_device_rumble": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije vibrační motor handheldu, i když gamepad vibrace podporuje. Ne pro vestavěný USB ovladač."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt den Vibrationsmotor des Handhelds auch dann, wenn ein Controller Rumble unterstützt. Nicht für den eingebauten USB-Treiber."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the handheld's vibration motor even when a controller supports rumble. Not for the built-in USB driver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el motor de vibración de la consola portátil aunque un mando admita vibración. No sirve con el controlador USB integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le moteur de vibration de la console portable même quand une manette gère la vibration. Pas pour le pilote USB intégré."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーが振動に対応していても、携帯機の振動モーターを使います。内蔵USBドライバーでは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤러가 럼블을 지원해도 휴대용 기기의 진동 모터를 사용해요. 내장 USB 드라이버에는 적용되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o motor de vibração do portátil mesmo quando o controle suporta vibração. Não vale para o driver USB integrado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує вібромотор портативного пристрою, навіть якщо контролер підтримує вібрацію. Не для вбудованого USB-драйвера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使手柄支持震动，也使用掌机的震动马达。不适用于内置 USB 驱动。"
          }
        }
      }
    },
    "help_checkbox_enable_fullexdisplay": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí stream a menu na připojeném monitoru nebo televizi v nastaveném rozlišení a FPS. Menu ovládáš handheldem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Stream und Menü auf einem angeschlossenen Monitor oder TV mit der eingestellten Auflösung und FPS. Der Handheld steuert das Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the stream and menu on an attached monitor or TV at the configured resolution and FPS. The handheld controls the menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el stream y el menú en un monitor o TV conectado con la resolución y los FPS configurados. La consola portátil controla el menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le stream et le menu sur un moniteur ou une TV branchés, à la résolution et aux FPS configurés. La console portable pilote le menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続したモニターやテレビに、設定した解像度とFPSでストリームとメニューを表示します。メニューは携帯機側で操作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 모니터나 TV에 설정한 해상도와 FPS로 스트림과 메뉴를 표시해요. 메뉴는 휴대용 기기로 조작해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o stream e o menu em um monitor ou TV conectado, na resolução e nos FPS configurados. O portátil controla o menu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує стрім і меню на підключеному моніторі чи телевізорі з налаштованими роздільною здатністю й FPS. Меню керується з портативного пристрою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已连接的显示器或电视上，以设定的分辨率和 FPS 显示串流画面和菜单。菜单由掌机操控。"
          }
        }
      }
    },
    "help_checkbox_enable_global_touch_sensitivity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uplatní citlivost dotyku na celou obrazovku; když je vypnuto, jen na pravou polovinu, levá zůstane pro ovládání pohybu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wendet die Touch-Empfindlichkeit auf den ganzen Bildschirm an; ist es aus, nur auf die rechte Hälfte, damit die linke für Bewegungssteuerung frei bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies touch sensitivity to the whole screen; when off, only to the right half, leaving the left for movement controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica la sensibilidad táctil a toda la pantalla; si está desactivado, solo a la mitad derecha, dejando la izquierda para los controles de movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique la sensibilité tactile à tout l’écran ; désactivé, seulement à la moitié droite, la gauche restant pour les commandes de déplacement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチ感度を画面全体に適用します。オフの場合は右半分のみで、左側は移動操作用に残します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 감도를 화면 전체에 적용해요. 끄면 오른쪽 절반에만 적용되고 왼쪽은 이동 컨트롤용으로 남겨요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica a sensibilidade do toque à tela toda; desativado, só à metade direita, deixando a esquerda para os controles de movimento."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовує чутливість дотику до всього екрана; якщо вимкнено — лише до правої половини, лишаючи ліву для керування рухом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将触摸灵敏度应用于整个屏幕；关闭时仅应用于右半屏，左半屏留给移动控制。"
          }
        }
      }
    },
    "help_checkbox_enable_hdr": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá o HDR video. Vyžaduje podporu aplikace, grafické karty v PC, dekodéru i displeje (10bitové HEVC, AV1 nebo PyroWave)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert HDR-Video an. Erfordert Unterstützung durch App, Host-GPU, Decoder und Display (10-Bit-HEVC, AV1 oder PyroWave)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests HDR video. Needs app, host GPU, decoder and display support (10-bit HEVC, AV1 or PyroWave)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita vídeo HDR. Requiere compatibilidad de la app, la GPU del host, el decodificador y la pantalla (HEVC de 10 bits, AV1 o PyroWave)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande une vidéo HDR. Nécessite la prise en charge par l’appli, le GPU du PC, le décodeur et l’écran (HEVC 10 bits, AV1 ou PyroWave)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HDRビデオを要求します。アプリ、ホストのGPU、デコーダー、ディスプレイの対応が必要です（10ビットのHEVC、AV1、またはPyroWave）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR 비디오를 요청해요. 앱, 호스트 GPU, 디코더, 디스플레이가 모두 지원해야 해요 (10비트 HEVC, AV1 또는 PyroWave)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita vídeo HDR. Requer suporte do app, da GPU do PC, do decodificador e da tela (HEVC 10 bits, AV1 ou PyroWave)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує HDR-відео. Потрібна підтримка застосунку, GPU хоста, декодера й екрана (10-бітний HEVC, AV1 або PyroWave)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 HDR 视频。需要应用、电脑 GPU、解码器和屏幕均支持（10-bit HEVC、AV1 或 PyroWave）。"
          }
        }
      }
    },
    "help_checkbox_enable_perf_overlay": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí FPS, FPS dolního 1 %% snímků, bitrate, ztrátu paketů a latenci. Celková latence není od stisku tlačítka po obraz. Menu streamu přepíná plné, kompaktní, vypnuto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt FPS, 1%% Low FPS, Bitrate, Paketverlust und Latenz. Die Gesamtlatenz ist nicht Taste-bis-Bildschirm. Das Stream-Menü wechselt zwischen voll, kompakt, aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows FPS, 1%% low FPS, bitrate, packet loss and latency. Total latency is not button-to-screen. The stream menu cycles full, compact, off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra FPS, FPS del 1%% más bajo, bitrate, pérdida de paquetes y latencia. La latencia total no es de botón a pantalla. El menú del stream alterna entre completa, compacta y desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche FPS, FPS 1 %% bas, débit, perte de paquets et latence. La latence totale n’est pas de la touche à l’écran. Le menu du stream alterne complet, compact, désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FPS、下位1%%のFPS、ビットレート、パケットロス、遅延を表示します。合計遅延は、ボタン操作から画面表示までの時間ではありません。ストリームメニューで、フル、コンパクト、オフを順に切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FPS, 하위 1%% FPS, 비트레이트, 패킷 손실, 지연을 표시해요. 전체 지연은 버튼에서 화면까지의 시간이 아니에요. 스트림 메뉴에서 전체, 간단, 끄기를 순환해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra FPS, FPS 1%% inferior, bitrate, perda de pacotes e latência. A latência total não é do botão até a tela. O menu do stream alterna entre completo, compacto e desativado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує FPS, FPS 1%% low, бітрейт, втрату пакетів і затримку. Загальна затримка — не від кнопки до екрана. Меню стріму перемикає: повний, компактний, вимкнено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示 FPS、1%% Low FPS、码率、丢包和延迟。总延迟不是从按键到屏幕的延迟。串流菜单可在完整、精简、关闭之间循环切换。"
          }
        }
      }
    },
    "help_checkbox_enable_perf_overlay_lite": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí jeden kompaktní řádek statistik nahoře uprostřed místo plného panelu. Menu streamu přepíná plné, kompaktní, vypnuto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt statt des vollen Panels eine kompakte Statistikzeile oben mittig. Das Stream-Menü wechselt zwischen voll, kompakt, aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows one compact statistics line at the top center instead of the full panel. The stream menu cycles full, compact, off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una línea compacta de estadísticas arriba en el centro en lugar del panel completo. El menú del stream alterna entre completa, compacta y desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une seule ligne compacte de statistiques en haut au centre au lieu du panneau complet. Le menu du stream alterne complet, compact, désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルパネルの代わりに、上部中央に1行のコンパクトな統計を表示します。ストリームメニューで、フル、コンパクト、オフを順に切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 패널 대신 상단 가운데에 간단한 통계 한 줄을 표시해요. 스트림 메뉴에서 전체, 간단, 끄기를 순환해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra uma linha compacta de estatísticas no centro superior em vez do painel completo. O menu do stream alterna entre completo, compacto e desativado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує один компактний рядок статистики вгорі по центру замість повної панелі. Меню стріму перемикає: повний, компактний, вимкнено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在顶部居中显示一行精简统计信息，而不是完整面板。串流菜单可在完整、精简、关闭之间循环切换。"
          }
        }
      }
    },
    "help_checkbox_enable_pip": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechá stream běžet v režimu Obraz v obraze při práci s více aplikacemi. Jen sledování: v malém okně se aplikace neovládá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält den Stream beim Multitasking im Bild-in-Bild-Modus. Nur ansehen: keine App-Steuerung im kleinen Fenster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the stream in Picture-in-Picture while multitasking. View only: no app control in the small window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el stream en imagen en imagen mientras haces otras cosas. Solo visualización: sin control de la app en la ventana pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde le stream en Picture-in-Picture pendant le multitâche. Visualisation seule : pas de contrôle de l’appli dans la petite fenêtre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルチタスク中も、ストリームをピクチャーインピクチャーで表示し続けます。表示専用で、小さなウィンドウではアプリを操作できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀티태스킹 중 스트림을 PiP로 유지해요. 보기 전용이라 작은 창에서는 앱을 조작할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o stream em Picture-in-Picture durante o multitarefa. Só visualização: sem controle do app na janela pequena."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тримає стрім у режимі «картинка в картинці» під час багатозадачності. Лише перегляд: у маленькому вікні немає керування застосунком."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多任务时让串流保持在画中画中。仅可观看：小窗口中无法操作应用。"
          }
        }
      }
    },
    "help_checkbox_enable_rumble": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posílá vibrace z PC na podporované gamepady. Které efekty fungují, určuje gamepad, připojení a ovladač."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Host-Rumble an unterstützte Gamepads. Controller, Verbindung und Treiber bestimmen, welche Effekte funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends host rumble to supported gamepads. Controller, connection and driver decide which effects work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía la vibración del host a los mandos compatibles. El mando, la conexión y el controlador deciden qué efectos funcionan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les vibrations du PC aux manettes compatibles. La manette, la connexion et le pilote déterminent quels effets fonctionnent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストの振動を、対応するコントローラーに送ります。どの効果が使えるかは、コントローラー、接続、ドライバーによって決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 럼블을 지원되는 게임패드로 보내요. 어떤 효과가 작동하는지는 컨트롤러, 연결, 드라이버에 따라 달라요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia a vibração do PC para controles compatíveis. Controle, conexão e driver definem quais efeitos funcionam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає вібрацію від хоста на контролери з підтримкою. Які ефекти працюють, залежить від контролера, з’єднання й драйвера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将电脑端的震动发送给支持的手柄。具体哪些效果可用，取决于手柄、连接方式和驱动。"
          }
        }
      }
    },
    "help_checkbox_enable_sticky_modifier_key_virtual_keyboard": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nechá virtuální Shift, Ctrl, Alt a podobné modifikátory aktivní i po klepnutí, takže kombinace lze psát po jedné klávese."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt virtuelle Modifikatoren wie Shift, Ctrl, Alt nach einem Tippen aktiv, damit Kombinationen Taste für Taste getippt werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps virtual Shift, Ctrl, Alt and similar modifiers active after a tap, so combinations can be typed one key at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene activos los modificadores virtuales Shift, Ctrl, Alt y similares tras un toque, para escribir combinaciones tecla a tecla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde actives les touches de modification virtuelles (Maj, Ctrl, Alt…) après un toucher, pour saisir les combinaisons une touche à la fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想のShift、Ctrl、Altなどの修飾キーをタップ後も有効にしたままにし、組み合わせを1キーずつ入力できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 Shift, Ctrl, Alt 같은 수정 키를 한 번 탭하면 계속 눌린 상태로 유지해서 조합을 키 하나씩 입력할 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém Shift, Ctrl, Alt e modificadores virtuais semelhantes ativos após um toque, para digitar combinações uma tecla por vez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримує віртуальні Shift, Ctrl, Alt та подібні модифікатори активними після дотику, щоб комбінації можна було набирати по одній клавіші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按后保持虚拟 Shift、Ctrl、Alt 等修饰键处于激活状态，这样可以逐个按键输入组合键。"
          }
        }
      }
    },
    "help_checkbox_enable_touch_sensitivity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další škálování citlivosti pro vstup do her dotykem, nastavené posuvníky os níže. Menu streamu ho přepíná za chodu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche Empfindlichkeitsskalierung für Touchscreen-Spieleingaben, eingestellt über die Achsenregler unten. Das Stream-Menü schaltet sie live um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extra sensitivity scaling for touchscreen game input, set by the axis sliders below. The stream menu toggles it live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalado extra de sensibilidad para la entrada de juego con pantalla táctil, fijado con los controles deslizantes de eje de abajo. El menú del stream lo alterna en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à l’échelle de sensibilité supplémentaire pour les entrées de jeu tactiles, réglée par les curseurs d’axe ci-dessous. Le menu du stream l’active en direct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチスクリーンのゲーム入力に、追加の感度スケーリングを適用します。下の軸スライダーで設定します。ストリームメニューでリアルタイムに切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 축 슬라이더로 정하는 터치스크린 게임 입력의 추가 감도 배율이에요. 스트림 메뉴에서 실시간으로 켜고 끌 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala extra de sensibilidade para a entrada de jogo na tela touch, definida pelos controles deslizantes dos eixos abaixo. O menu do stream a alterna na hora."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додаткове масштабування чутливості для ігрового введення сенсором, задається повзунками осей нижче. Меню стріму перемикає його наживо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为触摸屏游戏输入额外增加灵敏度缩放，由下方的轴滑块设定。串流菜单可实时切换。"
          }
        }
      }
    },
    "help_checkbox_enable_touch_sensitivity_rotation_auto": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu vycentruje přeškálované souřadnice dotyku, které přesáhnou okraj obrazovky, aby šlo táhnout i při vysoké citlivosti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zentriert skalierte Touch-Koordinaten neu, die über den Bildschirmrand laufen, damit Wischbewegungen mit hoher Empfindlichkeit weitergehen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recenters scaled touch coordinates that run past the screen edge so high-sensitivity drags can continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recentra las coordenadas táctiles escaladas que se salen del borde de la pantalla para que los arrastres de alta sensibilidad puedan continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recentre les coordonnées tactiles mises à l’échelle qui dépassent le bord de l’écran, pour que les glissements très sensibles puissent continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケーリングされたタッチ座標が画面の端を超えたときに中央へ戻し、高感度のドラッグを続けられるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 가장자리를 넘어간 배율 적용 터치 좌표를 중앙으로 되돌려서 감도가 높은 드래그를 계속할 수 있게 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recentraliza coordenadas de toque escaladas que passam da borda da tela para que arrastos de alta sensibilidade continuem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Центрує заново масштабовані координати дотику, що виходять за край екрана, щоб перетягування з високою чутливістю могло тривати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将超出屏幕边缘的缩放后触摸坐标重新居中，使高灵敏度的拖动可以继续。"
          }
        }
      }
    },
    "help_checkbox_enable_view_top_center": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream, který nevyplní obrazovku, zarovná nahoru na střed místo doprostřed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtet einen Stream, der den Bildschirm nicht füllt, oben mittig statt in der Mitte aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligns a stream that does not fill the screen to the top center instead of the middle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinea arriba en el centro, en lugar de en el medio, un stream que no llena la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligne en haut au centre un stream qui ne remplit pas l’écran, au lieu du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面を埋めないストリームを、中央ではなく上部中央に揃えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면을 다 채우지 않는 스트림을 가운데가 아닌 상단 가운데에 맞춰요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinha um stream que não preenche a tela ao centro superior, em vez do meio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вирівнює стрім, що не заповнює екран, по верхньому центру, а не по середині."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未铺满屏幕的串流画面将顶部居中对齐，而不是垂直居中。"
          }
        }
      }
    },
    "help_checkbox_flip_face_buttons": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohodí A/B a X/Y pro vstup z gamepadu i ovládání na obrazovce (rozložení Nintendo). Netýká se navigace v aplikaci Delos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertauscht A/B und X/Y bei Gamepad-Eingabe und Bildschirmsteuerung (Nintendo-Layout). Nicht für die Navigation in Delos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps A/B and X/Y for gamepad input and on-screen controls (Nintendo layout). Not Delos navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercambia A/B y X/Y en la entrada del mando y en los controles en pantalla (distribución de Nintendo). No afecta a la navegación de Delos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échange A/B et X/Y pour la manette et les commandes à l’écran (disposition Nintendo). Pas la navigation dans Delos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラー入力と画面上のコントロールで、A/BとX/Yを入れ替えます（Nintendo配置）。Delosのナビゲーションには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임패드 입력과 화면 컨트롤에서 A/B와 X/Y를 서로 바꿔요 (닌텐도 배열). Delos 탐색에는 적용되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca A/B e X/Y na entrada do controle e nos controles na tela (layout Nintendo). Não afeta a navegação do Delos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міняє місцями A/B і X/Y для введення з контролера й екранних елементів керування (розкладка Nintendo). Навігації Delos не стосується."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对调手柄输入和屏幕按键中的 A/B 与 X/Y（Nintendo 布局）。不影响 Delos 的界面导航。"
          }
        }
      }
    },
    "help_checkbox_force_device_motion": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije vestavěné senzory, i když externí gamepad má funkční vlastní. Vyžaduje volbu „Vestavěný gyroskop zařízení“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt die eingebauten Sensoren, auch wenn das externe Gamepad funktionierende hat. Erfordert Eingebautes Gyroskop des Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the built-in sensors even if the external gamepad has working ones. Needs Built-in device gyroscope."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los sensores integrados aunque el mando externo tenga sensores operativos. Requiere Giroscopio integrado del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les capteurs intégrés même si la manette externe en a qui fonctionnent. Nécessite Gyroscope intégré de l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部コントローラーに動作するセンサーがあっても、内蔵センサーを使います。「端末内蔵のジャイロ」が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외장 게임패드의 센서가 정상이어도 내장 센서를 사용해요. 기기 내장 자이로스코프가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa os sensores integrados mesmo que o controle externo tenha sensores funcionando. Requer Giroscópio integrado do dispositivo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує вбудовані датчики, навіть якщо зовнішній контролер має робочі. Потрібен параметр «Вбудований гіроскоп пристрою»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使外接手柄的传感器可用，也使用内置传感器。需要启用内置设备陀螺仪。"
          }
        }
      }
    },
    "help_checkbox_full_range": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá o video s plným rozsahem úrovní místo omezeného. Zapni jen když se PC i displej shodnou, jinak se zahltí černé a světlé oblasti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert Full-Range-Videopegel statt Limited Range an. Nur aktivieren, wenn Host und Display einverstanden sind, sonst saufen Schwarz und Lichter ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests full-range video levels instead of limited range. Enable only if host and display agree, or blacks and highlights crush."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita niveles de vídeo de rango completo en lugar de rango limitado. Actívalo solo si el host y la pantalla coinciden, o se pierden detalles en negros y luces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande des niveaux vidéo en plage complète au lieu de la plage limitée. À activer seulement si le PC et l’écran sont d’accord, sinon noirs et hautes lumières sont écrasés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リミテッドレンジではなく、フルレンジのビデオレベルを要求します。ホストとディスプレイが対応している場合のみ有効にしてください。そうでないと黒つぶれや白飛びが起きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 범위 대신 풀 레인지 비디오 레벨을 요청해요. 호스트와 디스플레이가 모두 지원할 때만 켜세요. 그렇지 않으면 검은색과 밝은 부분이 뭉개져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita níveis de vídeo de faixa completa em vez de faixa limitada. Ative só se PC e tela concordarem, senão pretos e brancos ficam estourados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує відео з повним діапазоном рівнів замість обмеженого. Вмикай, лише якщо хост і екран згодні, інакше чорне й світле зіб’ються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求全范围视频色阶，而不是有限范围。仅在电脑端和屏幕一致时启用，否则暗部和高光会丢失细节。"
          }
        }
      }
    },
    "help_checkbox_gamepad_enable_battery_report": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásí PC stav baterie gamepadu. Vypni, pokud dotazování na baterii vyvolává sekání dotyku nebo myši."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet den Akkustand des Gamepads an den Host. Ausschalten, wenn die Akkuabfrage mit Touch- oder Maus-Rucklern zusammenfällt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports gamepad battery status to the host. Turn off if battery polling coincides with touch or mouse stutter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa al host del estado de la batería del mando. Desactívalo si la consulta de batería coincide con tirones del táctil o del ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale l’état de la batterie de la manette au PC. Désactive si l’interrogation de la batterie coïncide avec des saccades tactiles ou de souris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーのバッテリー状態をホストに報告します。バッテリーの取得とタッチやマウスのカクつきが重なる場合は、オフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임패드 배터리 상태를 호스트에 보고해요. 배터리 확인 시점에 터치나 마우스가 끊기면 꺼 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa ao PC o estado da bateria do controle. Desative se a consulta da bateria coincidir com travadas no toque ou no mouse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомляє хосту про заряд контролера. Вимкни, якщо опитування батареї збігається з підвисанням сенсора чи миші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向电脑端上报手柄电量。如果电量轮询时触摸或鼠标出现卡顿，请关闭。"
          }
        }
      }
    },
    "help_checkbox_gamepad_touchpad_as_mouse": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchpad gamepadu vždy slouží jako myš v PC. Když je vypnuto, podporovaná PC mohou přijímat nativní vstup z touchpadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt das Touchpad eines Controllers immer als PC-Maus. Aus lässt unterstützte Hosts native Touchpad-Eingaben empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always uses a controller's touchpad as a PC mouse. Off lets supported hosts receive native touchpad input."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa siempre el panel táctil de un mando como ratón del PC. Desactivado permite a los hosts compatibles recibir la entrada nativa del panel táctil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise toujours le pavé tactile d’une manette comme souris du PC. Désactivé, les PC compatibles reçoivent le pavé tactile natif."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーのタッチパッドを、常にPCのマウスとして使います。オフにすると、対応するホストはネイティブのタッチパッド入力を受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤러 터치패드를 항상 PC 마우스로 사용해요. 끄면 지원하는 호스트가 터치패드 입력을 그대로 받을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre usa o touchpad do controle como mouse do PC. Desativado, PCs compatíveis recebem a entrada nativa do touchpad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завжди використовує тачпад контролера як мишу ПК. Якщо вимкнено, хости з підтримкою отримують нативне введення тачпада."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终将手柄的触控板用作 PC 鼠标。关闭后，支持的电脑端可接收原生触控板输入。"
          }
        }
      }
    },
    "help_checkbox_host_audio": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrává zvuk aplikace i na PC, nejen tady. Vypni, aby reproduktory PC mlčely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt den App-Ton auf dem PC und hier wieder. Ausschalten, damit die PC-Lautsprecher still bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays app audio on the PC as well as here. Turn off to keep the PC speakers quiet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el audio de la app también en el PC. Desactívalo para que los altavoces del PC no suenen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue le son de l’appli sur le PC en plus d’ici. Désactive pour garder les haut-parleurs du PC silencieux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音声を、こちらに加えてPCでも再生します。PCのスピーカーを静かにしたい場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오를 여기뿐 아니라 PC에서도 재생해요. PC 스피커를 조용히 두려면 꺼 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz o áudio do app no PC além daqui. Desative para manter as caixas de som do PC em silêncio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворює звук застосунку і на ПК, і тут. Вимкни, щоб динаміки ПК мовчали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用声音同时在 PC 上播放。关闭后 PC 扬声器保持安静。"
          }
        }
      }
    },
    "help_checkbox_mouse_emulation": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podržením Start během streamu přepneš gamepad mezi herním vstupem a emulací myši."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte im Stream Start gedrückt, um das Gamepad zwischen Spieleingabe und Mausemulation umzuschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold Start during a stream to switch the gamepad between game input and mouse emulation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado Start durante un stream para cambiar el mando entre entrada de juego y emulación de ratón."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens Start pendant un stream pour basculer la manette entre commande de jeu et émulation de souris."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーム中にStartを長押しすると、コントローラーをゲーム入力とマウスエミュレートで切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림 중 Start를 길게 눌러 게임패드를 게임 입력과 마우스 에뮬레이션 사이에서 전환해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure Start durante o stream para alternar o controle entre entrada do jogo e emulação de mouse."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуй Start під час стріму, щоб перемикати контролер між ігровим введенням і емуляцією миші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流时按住 Start，可在手柄游戏输入和鼠标模拟之间切换。"
          }
        }
      }
    },
    "help_checkbox_mouse_nav_buttons": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přeposílá tlačítka Zpět a Vpřed fyzické myši do PC. Vypni, pokud se chybně chová pravé tlačítko nebo navigace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leitet die Zurück- und Vor-Tasten einer physischen Maus an den PC weiter. Ausschalten, wenn Rechtsklick oder Navigation Probleme machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forwards a physical mouse's Back and Forward buttons to the PC. Turn off if right-click or navigation misbehaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reenvía al PC los botones Atrás y Adelante de un ratón físico. Desactívalo si el clic derecho o la navegación fallan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmet au PC les boutons Précédent et Suivant d’une souris physique. Désactive si le clic droit ou la navigation se comportent mal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理マウスの「戻る」と「進む」ボタンをPCに転送します。右クリックやナビゲーションの動作がおかしい場合は、オフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리 마우스의 뒤로/앞으로 버튼을 PC로 전달해요. 오른쪽 클릭이나 탐색이 이상하면 꺼 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaminha os botões Voltar e Avançar de um mouse físico ao PC. Desative se o clique direito ou a navegação se comportar mal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передає кнопки «Назад» і «Вперед» фізичної миші на ПК. Вимкни, якщо правий клік або навігація працюють неправильно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将实体鼠标的后退和前进键转发给 PC。如果右键或导航异常，请关闭。"
          }
        }
      }
    },
    "help_checkbox_multi_controller": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hlásí gamepady podle toho, jak se připojují a odpojují. Když je vypnuto, jeden gamepad je přítomný vždy, pro hry, které ho potřebují při spuštění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet Gamepads beim Verbinden oder Trennen. Ist es aus, bleibt immer ein Gamepad vorhanden, für Spiele, die beim Start eines brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports gamepads as they connect or disconnect. When off, one gamepad always stays present, for games that need one at launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa de los mandos según se conectan o desconectan. Si está desactivado, siempre hay un mando presente, para juegos que necesitan uno al iniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale les manettes à leur connexion ou déconnexion. Désactivé, une manette reste toujours présente, pour les jeux qui en exigent une au lancement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーの接続と切断を、そのたびに報告します。オフの場合、起動時にコントローラーを必要とするゲームのために、1台が常に接続されているものとして扱います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임패드가 연결되거나 해제될 때 알려 줘요. 끄면 게임패드 하나가 항상 연결된 상태로 유지돼요. 시작할 때 게임패드가 필요한 게임용이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informa os controles conforme conectam ou desconectam. Desativado, um controle sempre permanece presente, para jogos que precisam de um ao iniciar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомляє про контролери під час підключення й відключення. Якщо вимкнено, один контролер завжди присутній — для ігор, яким він потрібен під час запуску."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄连接或断开时实时上报。关闭后始终保留一个手柄，适用于启动时就需要手柄的游戏。"
          }
        }
      }
    },
    "help_checkbox_multi_touch_gestures": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V režimu multitouch: tři prsty otevřou systémovou klávesnici, čtyři plnou klávesnici, pět menu streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Multitouch-Modus: drei Finger öffnen die Systemtastatur, vier die Volltastatur, fünf das Stream-Menü."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In multi-touch mode: three fingers open the system keyboard, four the full keyboard, five the stream menu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo multitáctil: tres dedos abren el teclado del sistema, cuatro el teclado completo y cinco el menú del stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode multitouch : trois doigts ouvrent le clavier système, quatre le clavier complet, cinq le menu du stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルチタッチモードで、3本指でシステムキーボード、4本指でフルキーボード、5本指でストリームメニューを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀티터치 모드에서 손가락 세 개는 시스템 키보드, 네 개는 전체 키보드, 다섯 개는 스트림 메뉴를 열어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo multitoque: três dedos abrem o teclado do sistema, quatro o teclado completo, cinco o menu do stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У мультитач-режимі: три пальці відкривають системну клавіатуру, чотири — повну клавіатуру, п’ять — меню стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在多点触控模式下：三指打开系统键盘，四指打开完整键盘，五指打开串流菜单。"
          }
        }
      }
    },
    "help_checkbox_only_show_L3R3": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí jen virtuální tlačítka L3 a R3 (stisk sticku) místo celého gamepadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt statt des ganzen Gamepads nur die virtuellen Stick-Klick-Tasten L3 und R3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only the virtual L3 and R3 stick-click buttons instead of the full gamepad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra solo los botones virtuales L3 y R3 (clic de stick) en lugar del mando completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche seulement les boutons virtuels L3 et R3 (clic des sticks) au lieu de la manette complète."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラー全体ではなく、仮想のL3とR3（スティック押し込み）ボタンのみを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 게임패드 대신 가상 L3와 R3 스틱 클릭 버튼만 표시해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra só os botões virtuais L3 e R3 (clique do analógico) em vez do controle completo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує лише віртуальні кнопки натискання стіків L3 і R3 замість повного контролера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只显示虚拟 L3 和 R3 摇杆按下键，而不是完整手柄。"
          }
        }
      }
    },
    "help_checkbox_prevent_packet_loss": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posílá malý řídicí paket zhruba každých 20 ms, aby odradil Wi-Fi od úsporného režimu. Může pomoct při ztrátách specifických pro zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet etwa alle 20 ms ein kleines Steuerpaket, um Wi-Fi-Energiesparen zu verhindern. Kann bei gerätespezifischem Verlust helfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a small control packet about every 20 ms to discourage Wi-Fi power saving. May help device-specific loss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía un pequeño paquete de control cada 20 ms aproximadamente para evitar el ahorro de energía del Wi-Fi. Puede ayudar con pérdidas propias de ciertos dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie un petit paquet de contrôle toutes les 20 ms environ pour décourager l’économie d’énergie Wi-Fi. Peut aider contre des pertes propres à l’appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "約20msごとに小さな制御パケットを送り、Wi-Fiの省電力動作を抑えます。端末固有のパケットロスに効果がある場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 20 ms마다 작은 제어 패킷을 보내 Wi-Fi 절전을 막아요. 기기별 패킷 손실에 도움이 될 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia um pequeno pacote de controle a cada 20 ms para evitar a economia de energia do Wi-Fi. Pode ajudar em perdas específicas do dispositivo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає невеликий керувальний пакет приблизно кожні 20 ms, щоб відбити в Wi-Fi охоту економити енергію. Може допомогти з втратами на окремих пристроях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约每 20 ms 发送一个小控制包，以避免 Wi-Fi 进入省电模式。可能改善特定设备上的丢包。"
          }
        }
      }
    },
    "help_checkbox_remember_mouse_mode": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládá změny režimu myši provedené ve streamu. Když je vypnuto, platí jen pro daný stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert im Stream vorgenommene Mausmodus-Änderungen. Ist es aus, gelten sie nur für diesen Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves mouse-mode changes made in a stream. When off, they last only that stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda los cambios de modo de ratón hechos en un stream. Si está desactivado, solo duran ese stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les changements de mode souris faits pendant un stream. Désactivé, ils ne durent que pour ce stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーム中に変更したマウスモードを保存します。オフの場合、そのストリームの間だけ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림 중 바꾼 마우스 모드를 저장해요. 끄면 그 스트림에서만 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva as mudanças de modo do mouse feitas em um stream. Desativado, valem só naquele stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає зміни режиму миші, зроблені під час стріму. Якщо вимкнено, вони діють лише в тому стрімі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在串流中对鼠标模式的更改。关闭后，更改仅对当次串流有效。"
          }
        }
      }
    },
    "help_checkbox_remember_zoom_pan": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uloží přiblížení a posun streamu pro další relace. Když je vypnuto, úpravy platí jen pro daný stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert Zoom und Schwenk des Streams für spätere Sitzungen. Ist es aus, gelten Anpassungen nur für diesen Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saves the stream's zoom and pan for later sessions. When off, adjustments last only that stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el zoom y el desplazamiento del stream para sesiones posteriores. Si está desactivado, los ajustes solo duran ese stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre le zoom et le panoramique du stream pour les sessions suivantes. Désactivé, les ajustements ne durent que pour ce stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームのズームとパンを、次回以降のセッションのために保存します。オフの場合、調整はそのストリームの間だけ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림의 확대와 이동 상태를 다음 세션을 위해 저장해요. 끄면 그 스트림에서만 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva o zoom e o deslocamento do stream para sessões futuras. Desativado, os ajustes valem só naquele stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігає масштаб і панорамування стріму для наступних сесій. Якщо вимкнено, зміни діють лише в тому стрімі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存串流的缩放和平移，供之后的会话使用。关闭后，调整仅对当次串流有效。"
          }
        }
      }
    },
    "help_checkbox_right_alt_as_meta": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošle pravý Alt jako klávesu Command na Macu, včetně kombinací. Levý Alt se nemění. Pro streamování z Macu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet das rechte Alt als Mac-Command-Taste, auch in Kombinationen. Das linke Alt bleibt unverändert. Zum Streamen eines Macs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends Right Alt as the Mac Command key, including combinations. Left Alt is unchanged. For streaming a Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía Alt derecho como la tecla Command de Mac, también en combinaciones. Alt izquierdo no cambia. Para hacer streaming de un Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie Alt droit comme la touche Command du Mac, combinaisons comprises. Alt gauche est inchangé. Pour streamer un Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右AltをMacのCommandキーとして、組み合わせも含めて送信します。左Altは変わりません。Macのストリーミング用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조합을 포함해 오른쪽 Alt를 Mac의 Command 키로 보내요. 왼쪽 Alt는 그대로예요. Mac을 스트리밍할 때 사용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia Alt direito como a tecla Command do Mac, inclusive em combinações. Alt esquerdo não muda. Para transmitir de um Mac."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає правий Alt як клавішу Command на Mac, зокрема в комбінаціях. Лівий Alt не змінюється. Для стрімінгу з Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将右 Alt 作为 Mac 的 Command 键发送，包括组合键。左 Alt 不变。用于串流 Mac。"
          }
        }
      }
    },
    "help_checkbox_sgsr": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvětší stream s nižším rozlišením na velikost displeje, nebo ho jen zostří (Režim). Stojí výkon GPU. Změny z menu platí jednu relaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert einen Stream mit niedrigerer Auflösung auf die Display-Größe hoch oder schärft ihn nur (Modus). Kostet GPU-Zeit. Änderungen im Menü gelten eine Sitzung lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscales a lower-resolution stream to the display size, or only sharpens it (Mode). Costs GPU time. Menu changes last one session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala un stream de menor resolución al tamaño de la pantalla, o solo le aplica nitidez (Modo). Consume tiempo de GPU. Los cambios desde el menú duran una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscale un stream en basse résolution à la taille de l’écran, ou l’accentue seulement (Mode). Coûte du GPU. Les changements du menu durent une session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低解像度のストリームをディスプレイのサイズにアップスケールするか、シャープ化のみを行います（モード）。GPU時間を消費します。メニューでの変更は1セッションのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 해상도의 스트림을 디스플레이 크기로 업스케일하거나 선명화만 해요 (모드). GPU 시간을 써요. 메뉴에서 바꾼 내용은 한 세션 동안만 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz upscale de um stream de menor resolução para o tamanho da tela, ou só aumenta a nitidez (Modo). Consome GPU. Mudanças pelo menu valem por uma sessão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апскейлить стрім нижчої роздільної здатності до розміру екрана або лише підвищує різкість (Режим апскейлера). Навантажує GPU. Зміни з меню діють одну сесію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将较低分辨率的串流超分到屏幕尺寸，或仅进行锐化（模式）。会占用 GPU 时间。在菜单中的更改仅在本次会话内有效。"
          }
        }
      }
    },
    "help_checkbox_show_guide_button": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá na virtuální gamepad tlačítko Guide/Home; jeho akce závisí na PC a platformě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt dem virtuellen Gamepad die Guide-/Home-Taste hinzu; ihre Aktion hängt von Host und Plattform ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the Guide/Home button to the virtual gamepad; its action depends on host and platform."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el botón Guide/Home al mando virtual; su acción depende del host y la plataforma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute le bouton Guide/Home à la manette virtuelle ; son action dépend du PC et de la plateforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想コントローラーにガイド/ホームボタンを追加します。動作はホストとプラットフォームによって異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 게임패드에 가이드/홈 버튼을 추가해요. 동작은 호스트와 플랫폼에 따라 달라요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona o botão Guide/Home ao controle virtual; a ação depende do PC e da plataforma."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає кнопку Guide/Home на віртуальний контролер; її дія залежить від хоста й платформи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在虚拟手柄上添加 Guide/Home 键；其功能取决于电脑端和平台。"
          }
        }
      }
    },
    "help_checkbox_show_onscreen_controls": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí virtuální gamepad přes stream pro hraní dotykem. Menu streamu ho pro relaci přepíná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt das virtuelle Gamepad über dem Stream für Touch-Spiel. Das Stream-Menü schaltet es für die Sitzung um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows the virtual gamepad over the stream for touch play. The stream menu toggles it for the session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el mando virtual sobre el stream para jugar con el táctil. El menú del stream lo alterna durante la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la manette virtuelle sur le stream pour jouer au toucher. Le menu du stream l’active ou la désactive pour la session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチ操作用に、ストリームの上に仮想コントローラーを表示します。ストリームメニューで、そのセッションの間だけ切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 플레이를 위해 스트림 위에 가상 게임패드를 표시해요. 스트림 메뉴에서 세션 동안 켜고 끌 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o controle virtual sobre o stream para jogar por toque. O menu do stream o alterna na sessão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує віртуальний контролер над стрімом для гри дотиками. Меню стріму перемикає його на сесію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在串流画面上显示虚拟手柄，用于触屏游玩。串流菜单可在本次会话中切换。"
          }
        }
      }
    },
    "help_checkbox_smart_clipboard_sync": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahraje schránku tohoto zařízení při spuštění nebo obnovení streamu; schránku z PC stáhne, když stream ztratí fokus. Vyžaduje Vibepollo nebo Apollo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die Zwischenablage dieses Geräts hoch, wenn der Stream startet oder den Fokus zurückerhält; holt die des PCs, wenn er den Fokus verliert. Erfordert Vibepollo oder Apollo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads this device's clipboard when the stream starts or regains focus; fetches the PC's when it loses focus. Needs Vibepollo or Apollo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube el portapapeles de este dispositivo cuando el stream empieza o recupera el foco; descarga el del PC cuando lo pierde. Requiere Vibepollo o Apollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie le presse-papiers de cet appareil au début du stream ou au retour du focus ; récupère celui du PC à la perte du focus. Nécessite Vibepollo ou Apollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームの開始時やフォーカス復帰時に、この端末のクリップボードをアップロードし、フォーカスを失ったときにPCのクリップボードを取得します。VibepolloまたはApolloが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림이 시작되거나 포커스를 다시 얻으면 이 기기의 클립보드를 업로드하고, 포커스를 잃으면 PC의 클립보드를 가져와요. Vibepollo 또는 Apollo가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia a área de transferência deste dispositivo quando o stream começa ou recupera o foco; busca a do PC quando perde o foco. Requer Vibepollo ou Apollo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує буфер обміну цього пристрою, коли стрім починається або отримує фокус; забирає буфер ПК, коли втрачає фокус. Потрібен Vibepollo або Apollo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流开始或重新获得焦点时上传本设备的剪贴板；失去焦点时获取 PC 的剪贴板。需要 Vibepollo 或 Apollo。"
          }
        }
      }
    },
    "help_checkbox_smart_clipboard_sync_toast": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí krátkou zprávu, když se automatický přenos schránky podaří nebo selže. Synchronizaci nezapíná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine kurze Meldung, wenn die automatische Übertragung der Zwischenablage gelingt oder fehlschlägt. Aktiviert den Abgleich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a brief message when automatic clipboard transfer succeeds or fails. Does not enable synchronization."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un mensaje breve cuando la transferencia automática del portapapeles tiene éxito o falla. No activa la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un bref message quand le transfert automatique du presse-papiers réussit ou échoue. N’active pas la synchronisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの自動転送が成功または失敗したときに、短いメッセージを表示します。同期自体は有効になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 클립보드 전송이 성공하거나 실패하면 짧은 메시지를 표시해요. 동기화를 켜는 옵션은 아니에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra um aviso breve quando a transferência automática da área de transferência dá certo ou falha. Não ativa a sincronização."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує коротке повідомлення, коли автоматична передача буфера обміну вдалася чи не вдалася. Синхронізацію не вмикає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板自动传输成功或失败时显示简短提示。不会启用同步。"
          }
        }
      }
    },
    "help_checkbox_trackpad_swap_axis": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prohodí vodorovný a svislý vstup z trackpadu u zařízení, která hlásí otočený trackpad. Pokud se pohyb chová správně, nech vypnuto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tauscht horizontale und vertikale Trackpad-Eingabe bei Geräten, die ein gedrehtes Trackpad melden. Aus lassen, wenn die Bewegung stimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swaps horizontal and vertical trackpad input for devices that report a rotated trackpad. Leave off if movement is right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercambia la entrada horizontal y vertical del trackpad en dispositivos que lo informan girado. Déjalo desactivado si el movimiento es correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échange les entrées horizontale et verticale du trackpad pour les appareils qui signalent un trackpad pivoté. Laisse désactivé si le mouvement est correct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドが回転して報告される端末向けに、トラックパッド入力の縦横を入れ替えます。動きが正しい場合はオフのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드가 회전된 상태로 보고되는 기기에서 트랙패드 입력의 가로와 세로를 바꿔요. 움직임이 맞으면 꺼 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Troca a entrada horizontal e vertical do trackpad em dispositivos que informam um trackpad girado. Deixe desativado se o movimento está certo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Міняє місцями горизонтальне й вертикальне введення трекпада для пристроїв, що повідомляють про повернутий трекпад. Лишай вимкненим, якщо рух правильний."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对调触控板的水平和垂直输入，适用于上报方向被旋转的触控板的设备。如果移动方向正常，请保持关闭。"
          }
        }
      }
    },
    "help_checkbox_unlock_fps": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí volby snímkové frekvence nad zjištěnou schopností displeje. Zvyšuje zátěž PC; obnovovací frekvence se nemění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Bildraten oberhalb der erkannten Fähigkeit des Displays. Erhöht die Host-Last; die Bildwiederholrate bleibt gleich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows frame-rate choices above the display's detected capability. Raises host load; refresh rate is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tasas de fotogramas superiores a la capacidad detectada de la pantalla. Aumenta la carga del host; la frecuencia de actualización no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche des fréquences d’images au-delà des capacités détectées de l’écran. Augmente la charge du PC ; la fréquence d’écran ne change pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイの検出された性能を超えるフレームレートも選べるようにします。ホストの負荷が上がります。リフレッシュレートは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이가 감지한 성능보다 높은 프레임 레이트 선택지를 표시해요. 호스트 부하가 커지고 주사율은 바뀌지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra opções de taxa de quadros acima da capacidade detectada da tela. Aumenta a carga do PC; a taxa de atualização não muda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує варіанти частоти кадрів вище за виявлені можливості екрана. Підвищує навантаження на хост; частота оновлення не змінюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示高于屏幕检测能力的帧率选项。会增加电脑端负载；刷新率不变。"
          }
        }
      }
    },
    "help_checkbox_use_virtual_display": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá Vibepollo nebo Apollo o virtuální displej PC s požadovaným rozlišením a FPS. Vyžaduje podporu v PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert bei Vibepollo oder Apollo ein virtuelles PC-Display mit der gewünschten Auflösung und FPS an. Erfordert Host-Unterstützung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks Vibepollo or Apollo for a virtual PC display at the requested resolution and FPS. Needs host support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a Vibepollo o Apollo una pantalla virtual del PC con la resolución y los FPS solicitados. Requiere compatibilidad del host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande à Vibepollo ou Apollo un écran virtuel du PC à la résolution et aux FPS demandés. Nécessite la prise en charge par le PC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した解像度とFPSの仮想PCディスプレイを、VibepolloまたはApolloに要求します。ホスト側の対応が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibepollo 또는 Apollo에 요청한 해상도와 FPS의 가상 PC 디스플레이를 요청해요. 호스트가 지원해야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede ao Vibepollo ou Apollo uma tela virtual no PC com a resolução e os FPS solicitados. Requer suporte do PC."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просить Vibepollo або Apollo створити віртуальний екран ПК із потрібними роздільною здатністю й FPS. Потрібна підтримка хоста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Vibepollo 或 Apollo 请求一个符合所需分辨率和 FPS 的 PC 虚拟显示器。需要电脑端支持。"
          }
        }
      }
    },
    "help_checkbox_vibrate_fallback": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použije vibrační motor handheldu pro vibrace ze hry, když to gamepad neumí. Vyžaduje vibrační motor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt den Vibrationsmotor des Handhelds für Spiel-Rumble, wenn das Gamepad es nicht kann. Erfordert einen Vibrationsmotor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the handheld's vibration motor for game rumble when the gamepad cannot. Needs a vibration motor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el motor de vibración de la consola portátil para la vibración del juego cuando el mando no puede. Requiere un motor de vibración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le moteur de vibration de la console portable pour les vibrations du jeu quand la manette ne peut pas. Nécessite un moteur de vibration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーが振動できない場合に、携帯機の振動モーターをゲームの振動に使います。振動モーターが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임패드가 지원하지 못할 때 휴대용 기기의 진동 모터로 게임 럼블을 대신해요. 진동 모터가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa o motor de vibração do portátil para a vibração do jogo quando o controle não consegue. Requer motor de vibração."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує вібромотор портативного пристрою для ігрової вібрації, коли контролер не може. Потрібен вібромотор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手柄无法震动时，使用掌机的震动马达模拟游戏震动。需要设备带有震动马达。"
          }
        }
      }
    },
    "help_checkbox_vibrate_keyboard": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní vibrace při klepnutí na vlastní tlačítka klávesnice na obrazovce; ne vibrace ze hry. Vyžaduje vibrační motor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Vibration beim Tippen auf eigene Bildschirmtastatur-Tasten; kein Spiel-Rumble. Erfordert einen Vibrationsmotor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local vibration when tapping custom on-screen keyboard buttons; not game rumble. Needs a vibration motor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibración local al tocar los botones del teclado personalizado en pantalla; no es vibración del juego. Requiere un motor de vibración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibration locale à l’appui sur les boutons du clavier personnalisé à l’écran ; pas la vibration de jeu. Nécessite un moteur de vibration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムの画面キーボードのボタンをタップすると、端末が振動します。ゲームの振動ではありません。振動モーターが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 화면 키보드 버튼을 탭할 때 로컬로 진동해요. 게임 럼블이 아니에요. 진동 모터가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibração local ao tocar nos botões do teclado personalizado na tela; não é vibração do jogo. Requer motor de vibração."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна вібрація під час дотику до власних кнопок екранної клавіатури; не ігрова вібрація. Потрібен вібромотор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按自定义屏幕键盘按键时在本地震动；不是游戏震动。需要设备带有震动马达。"
          }
        }
      }
    },
    "help_checkbox_vibrate_osc": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místní vibrace při stisku tlačítek virtuálního gamepadu. Odezva dotyku, ne vibrace ze hry. Vyžaduje vibrační motor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Vibration beim Drücken virtueller Gamepad-Tasten. Touch-Feedback, kein Spiel-Rumble. Erfordert einen Vibrationsmotor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local vibration when pressing virtual gamepad buttons. Touch feedback, not game rumble. Needs a vibration motor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibración local al pulsar los botones del mando virtual. Respuesta táctil, no vibración del juego. Requiere un motor de vibración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibration locale à l’appui sur les boutons de la manette virtuelle. Retour tactile, pas vibration de jeu. Nécessite un moteur de vibration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想コントローラーのボタンを押すと、端末が振動します。タッチのフィードバックであり、ゲームの振動ではありません。振動モーターが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 게임패드 버튼을 누를 때 로컬로 진동해요. 터치 피드백이며 게임 럼블이 아니에요. 진동 모터가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibração local ao pressionar botões do controle virtual. Feedback de toque, não vibração do jogo. Requer motor de vibração."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальна вібрація під час натискання кнопок віртуального контролера. Тактильний відгук, а не ігрова вібрація. Потрібен вібромотор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下虚拟手柄按键时在本地震动。这是触摸反馈，不是游戏震动。需要设备带有震动马达。"
          }
        }
      }
    },
    "help_custom_refresh_rate": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá vlastní FPS (povolena jsou desetinná čísla) do volby „Snímková frekvence videa“; vyber ji tam. Výsledek omezuje PC, aplikace i displej."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der Video-Bildrate eine eigene FPS hinzu (Dezimalstellen erlaubt); wähle sie dort aus. Host, App und Display begrenzen das Ergebnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a custom FPS (decimals allowed) to Video frame rate; select it there. Host, app and display limit the result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade unos FPS personalizados (se admiten decimales) a Tasa de fotogramas del vídeo; selecciónalos allí. El host, la app y la pantalla limitan el resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des FPS personnalisés (décimales autorisées) à Fréquence d’images vidéo ; sélectionne-les là-bas. Le PC, l’appli et l’écran limitent le résultat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ビデオフレームレート」にカスタムFPS（小数可）を追加します。そこで選択してください。結果はホスト、アプリ、ディスプレイによって制限されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 프레임 레이트에 사용자 지정 FPS(소수 가능)를 추가해요. 거기서 선택하세요. 결과는 호스트, 앱, 디스플레이의 한계를 따라요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um FPS personalizado (aceita decimais) à Taxa de quadros do vídeo; selecione-o lá. PC, app e tela limitam o resultado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає власний FPS (можна з десятковими) до «Частота кадрів відео»; вибери його там. Результат обмежують хост, застосунок і екран."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向视频帧率添加自定义 FPS（允许小数），并在视频帧率中选择它。最终结果受电脑、应用和屏幕限制。"
          }
        }
      }
    },
    "help_dynamic_fps": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá o %1$@ FPS. Režimy Warp ho násobí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert %1$@ FPS an. Warp-Modi vervielfachen sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests %1$@ FPS. Warp modes multiply it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita %1$@ FPS. Los modos Warp lo multiplican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande %1$@ FPS. Les modes Warp les multiplient."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ FPSを要求します。Warpモードでは倍率が掛かります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ FPS를 요청해요. Warp 모드는 이 값을 곱해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita %1$@ FPS. Os modos Warp multiplicam esse valor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує %1$@ FPS. Режими Warp множать це значення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 %1$@ FPS。Warp 模式会将其成倍增加。"
          }
        }
      }
    },
    "help_dynamic_resolution": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá o stream %1$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert einen Stream mit %1$@ an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests a %1$@ stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita un stream de %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande un stream en %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のストリームを要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 스트림을 요청해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita um stream de %1$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує стрім %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 %1$@ 的串流。"
          }
        }
      }
    },
    "help_edit_diy_bitrate": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastaví bitrate v Mbps; povolena jsou desetinná čísla i hodnoty nad rozsahem posuvníku. Aktualizuje také Bitrate videa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Bitrate in Mbps; Dezimalstellen und Werte über dem Reglerbereich sind erlaubt. Aktualisiert auch die Video-Bitrate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the bitrate in Mbps; decimals and values above the slider's range allowed. Also updates Video bitrate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija el bitrate en Mbps; se admiten decimales y valores por encima del rango del control deslizante. También actualiza Bitrate del vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le débit en Mbps ; décimales et valeurs au-delà du curseur autorisées. Met aussi à jour Débit vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビットレートをMbpsで設定します。小数や、スライダーの範囲を超える値も指定できます。「ビデオビットレート」も更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbps 단위로 비트레이트를 설정해요. 소수와 슬라이더 범위를 넘는 값도 가능해요. 비디오 비트레이트도 함께 바뀌어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o bitrate em Mbps; aceita decimais e valores acima do alcance do controle deslizante. Também atualiza o Bitrate do vídeo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задає бітрейт у Mbps; можна десяткові дроби й значення за межами повзунка. Також оновлює «Бітрейт відео»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置码率，单位 Mbps；允许小数，也允许超出滑块范围的值。同时会更新视频码率。"
          }
        }
      }
    },
    "help_edit_diy_w_h": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidá rozlišení do volby „Rozlišení videa“: zadej šířku x výšku (1920x1080) a pak ho tam vyber."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt der Videoauflösung eine Auflösung hinzu: Gib Breite x Höhe ein (1920x1080) und wähle sie dann dort aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a resolution to Video resolution: enter width x height (1920x1080), then select it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una resolución a Resolución de vídeo: escribe ancho x alto (1920x1080) y selecciónala allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une résolution à Résolution vidéo : saisis largeur x hauteur (1920x1080), puis sélectionne-la là-bas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ビデオ解像度」に解像度を追加します。幅x高さ（1920x1080）を入力し、そこで選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 해상도에 해상도를 추가해요. 가로 x 세로(1920x1080)를 입력한 뒤 비디오 해상도에서 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona uma resolução em Resolução do vídeo: digite largura x altura (1920x1080) e selecione-a lá."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додає роздільну здатність до списку «Роздільна здатність відео»: введи ширина x висота (1920x1080), потім вибери її там."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向视频分辨率添加一个分辨率：输入宽 x 高（1920x1080），然后在视频分辨率中选择它。"
          }
        }
      }
    },
    "help_frame_pacing": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režimy Warp nemusí fungovat na každém zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warp-Modi funktionieren nicht auf jedem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warp modes may not work on every device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modos Warp pueden no funcionar en todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modes Warp peuvent ne pas fonctionner sur tous les appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Warpモードは、すべての端末で動作するとは限りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Warp 모드는 일부 기기에서 작동하지 않을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modos Warp podem não funcionar em todos os dispositivos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режими Warp можуть працювати не на кожному пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Warp 模式可能无法在所有设备上使用。"
          }
        }
      }
    },
    "help_frame_pacing_balanced": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přizpůsobí snímky obnovování displeje s malou frontou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt Frames mit einer kleinen Warteschlange an die Display-Wiederholrate an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches frames to the display refresh with a small queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta los fotogramas a la frecuencia de la pantalla con una cola pequeña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligne les images sur la fréquence de l’écran avec une petite file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さなキューで、フレームをディスプレイのリフレッシュに合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 큐로 프레임을 디스플레이 주사율에 맞춰요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta os quadros à atualização da tela com uma fila pequena."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Узгоджує кадри з оновленням екрана з малою чергою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用小型队列让帧与屏幕刷新保持一致。"
          }
        }
      }
    },
    "help_frame_pacing_cap_fps": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyvážený; blízko obnovovací frekvence žádá PC o méně snímků."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewogen; fordert vom Host nahe der Wiederholrate weniger Frames an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balanced; asks the host for fewer frames near refresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrado; pide al host menos fotogramas cerca de la frecuencia de actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibré ; demande au PC moins d’images près de la fréquence d’écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バランス型です。リフレッシュレート付近では、ホストに少ないフレーム数を要求します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균형 모드예요. 주사율에 가까울 때 호스트에 더 적은 프레임을 요청해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibrado; pede ao PC menos quadros perto da taxa de atualização."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збалансовано; просить хост надсилати менше кадрів біля частоти оновлення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "均衡；接近刷新率时请求电脑端发送更少的帧。"
          }
        }
      }
    },
    "help_frame_pacing_phase_lock": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí každý snímek při nejbližším obnovení, které spolehlivě stihne; čeká jen milisekundy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt jedes Bild bei der frühesten Bildwiederholung, die es sicher erreicht; wartet nur Millisekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows each frame at the earliest refresh it reliably makes; waits only milliseconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra cada fotograma en el primer refresco que alcanza con seguridad; solo espera milisegundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche chaque image au premier rafraîchissement qu’elle atteint à coup sûr ; n’attend que des millisecondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各フレームを、確実に間に合う最も早いリフレッシュで表示します。待つのは数ミリ秒だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 프레임을 확실히 맞출 수 있는 가장 빠른 화면 갱신에 표시해요. 몇 밀리초만 기다려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra cada quadro na primeira atualização que ele alcança com segurança; espera só milissegundos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує кожен кадр на найближчому оновленні, яке він надійно встигає; чекає лише мілісекунди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每帧能稳定赶上的最早一次刷新时显示；只等待几毫秒。"
          }
        }
      }
    },
    "help_frame_pacing_smoothness": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rovnoměrné doručování; přidává buffering a latenci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleichmäßige Lieferung; erhöht Pufferung und Latenz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady delivery; adds buffering and latency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega constante; añade búfer y latencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Livraison régulière ; ajoute de la mise en tampon et de la latence."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定して配信しますが、バッファリングと遅延が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일정하게 전달해요. 버퍼링과 지연이 늘어나요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega estável; adiciona buffer e latência."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рівна подача; додає буферизацію й затримку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定输出；会增加缓冲和延迟。"
          }
        }
      }
    },
    "help_frame_pacing_warp": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá o dvojnásobek FPS (60 → 120); zobrazí nejnovější snímek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert doppelte FPS an (60 → 120); zeigt das neueste Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests twice the FPS (60 → 120); shows the newest frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide el doble de FPS (60 → 120); muestra el fotograma más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande deux fois les FPS (60 → 120) ; affiche l’image la plus récente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FPSを2倍（60 → 120）要求し、最新のフレームを表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "FPS를 두 배로 요청하고(60 → 120) 최신 프레임을 표시해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede o dobro de FPS (60 → 120); mostra o quadro mais recente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просить удвічі більше FPS (з 60 до 120); показує найновіший кадр."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求两倍 FPS（60 至 120）；显示最新一帧。"
          }
        }
      }
    },
    "help_frame_pacing_warp2": {
