    "help_seekbar_trackpad_sensitivity_x": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodorovná citlivost fyzického trackpadu. Větší hodnota znamená delší pohyb; záporná ho obrátí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontale Empfindlichkeit eines physischen Trackpads. Größer bewegt weiter; negativ kehrt um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal sensitivity of a physical trackpad. Larger moves farther; negative reverses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidad horizontal de un trackpad físico. Más valor, más recorrido; negativo lo invierte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilité horizontale d’un trackpad physique. Plus grand = plus loin ; négatif inverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理トラックパッドの横方向の感度です。大きいほど遠くまで動き、負の値で反転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리 트랙패드의 가로 감도예요. 클수록 더 멀리 움직이고, 음수면 방향이 반전돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidade horizontal de um trackpad físico. Maior move mais longe; negativo inverte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальна чутливість фізичного трекпада. Більше — рух далі; від’ємне значення інвертує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实体触控板的水平灵敏度。值越大移动越远；负值会反向。"
          }
        }
      }
    },
    "help_seekbar_trackpad_sensitivity_y": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svislá citlivost fyzického trackpadu. Větší hodnota znamená delší pohyb; záporná ho obrátí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertikale Empfindlichkeit eines physischen Trackpads. Größer bewegt weiter; negativ kehrt um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertical sensitivity of a physical trackpad. Larger moves farther; negative reverses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidad vertical de un trackpad físico. Más valor, más recorrido; negativo lo invierte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilité verticale d’un trackpad physique. Plus grand = plus loin ; négatif inverse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理トラックパッドの縦方向の感度です。大きいほど遠くまで動き、負の値で反転します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리 트랙패드의 세로 감도예요. 클수록 더 멀리 움직이고, 음수면 방향이 반전돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidade vertical de um trackpad físico. Maior move mais longe; negativo inverte."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вертикальна чутливість фізичного трекпада. Більше — рух далі; від’ємне значення інвертує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实体触控板的垂直灵敏度。值越大移动越远；负值会反向。"
          }
        }
      }
    },
    "help_seekbar_vibrate_fallback_strength": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Síla vibrací tohoto zařízení pro vibrace ze hry. Vyžaduje řízení amplitudy. Netýká se haptiky rozhraní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stärke der Vibration dieses Geräts für Spiel-Rumble. Erfordert Amplitudensteuerung. Nicht die Haptik der Oberfläche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strength of this device's vibration for game rumble. Needs amplitude control. Not interface haptics."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidad de la vibración de este dispositivo para la vibración del juego. Requiere control de amplitud. No afecta a la vibración háptica de la interfaz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensité de la vibration de cet appareil pour les vibrations du jeu. Nécessite le contrôle d’amplitude. Pas le retour haptique de l’interface."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームの振動に使う、この端末の振動の強さです。振幅の制御が必要です。インターフェースのハプティクスには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 럼블에 쓰는 이 기기 진동의 세기예요. 진폭 제어가 필요해요. 인터페이스 햅틱과는 별개예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidade da vibração deste dispositivo para a vibração do jogo. Requer controle de amplitude. Não afeta o feedback tátil da interface."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сила вібрації цього пристрою для ігрової вібрації. Потрібне керування амплітудою. Не стосується тактильного відгуку інтерфейсу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备模拟游戏震动的强度。需要支持振幅控制。不影响界面触感反馈。"
          }
        }
      }
    },
    "help_supersampling_renders": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykresluje %1$@ v rozlišení %2$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert %1$@ mit %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders %1$@ at %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza %1$@ a %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend %1$@ en %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@を%2$@でレンダリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 화면을 %2$@ 크기로 렌더링해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza %1$@ em %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рендерить %1$@ у %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以 %2$@ 渲染 %1$@。"
          }
        }
      }
    },
    "help_supersampling_too_large": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ přesahuje limit upscaleru %2$@ pixelů: bez supersamplingu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ überschreitet das Limit des Upscalers von %2$@ Pixeln: kein Supersampling."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is over the upscaler's limit of %2$@ pixels: no supersampling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ supera el límite del escalador de %2$@ píxeles: sin supermuestreo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dépasse la limite de l’upscaler de %2$@ pixels : pas de supersampling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はアップスケーラーの上限%2$@ピクセルを超えるため、スーパーサンプリングしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 크기는 업스케일러 한도인 %2$@ 픽셀을 넘어서 슈퍼샘플링하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ultrapassa o limite do upscaler de %2$@ pixels: sem supersampling."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ перевищує ліміт апскейлера %2$@ пікселів: без суперсемплінгу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 超过超分上限 %2$@ 像素：不进行超采样。"
          }
        }
      }
    },
    "help_upscaler_mode_metalfx_spatial": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostorové zvětšení aktuálního snímku. Málo zatěžuje GPU. Doporučeno."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räumliche Hochskalierung des aktuellen Frames. Wenig GPU-Last. Empfohlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spatial upscaling of the current frame. Light on the GPU. Recommended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalado espacial del fotograma actual. Consume poca GPU. Recomendado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à l’échelle spatiale de l’image courante. Coûte peu de GPU. Recommandé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のフレームを空間的にアップスケールします。GPU負荷は小さいです。推奨のモードです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 프레임을 공간적으로 업스케일해요. GPU를 적게 써요. 권장하는 모드예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaling espacial do quadro atual. Custa pouca GPU. Recomendado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просторове масштабування поточного кадру. Мало навантажує GPU. Рекомендовано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对当前帧进行空间超分。GPU 开销小。推荐使用。"
          }
        }
      }
    },
    "help_upscaler_mode_metalfx_temporal": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentální, pro zašuměné streamy s nízkým bitratem: časové zvětšení s pohybem z optického toku videa. Stojí několikrát víc GPU než MetalFX Spatial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell, für verrauschte Streams mit niedriger Bitrate: zeitliche Hochskalierung mit Bewegung per Optical Flow des Videos. Kostet ein Mehrfaches der GPU-Last von MetalFX Spatial."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental, for noisy, low-bitrate streams: temporal upscaling with motion from the video's optical flow. Costs several times more GPU than MetalFX Spatial."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental, para streams con ruido y bitrate bajo: escalado temporal con movimiento por flujo óptico del vídeo. Consume varias veces más GPU que MetalFX Spatial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expérimental, pour les streams bruités à faible débit : mise à l’échelle temporelle avec le mouvement du flux optique de la vidéo. Coûte plusieurs fois plus de GPU que MetalFX Spatial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "試験的な機能で、ノイズの多い低ビットレートのストリーム向けです。ビデオのオプティカルフローから得た動きで時間的にアップスケールします。GPU負荷はMetalFX Spatialの数倍です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적 기능이며, 노이즈가 많은 낮은 비트레이트 스트림에 맞아요. 비디오의 옵티컬 플로로 찾은 움직임으로 시간적 업스케일을 해요. MetalFX Spatial보다 GPU를 몇 배 더 써요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental, para streams com ruído e bitrate baixo: upscaling temporal com movimento por fluxo óptico do vídeo. Custa várias vezes mais GPU que o MetalFX Spatial."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експериментальний, для зашумлених стрімів із низьким бітрейтом: часове масштабування з рухом з оптичного потоку відео. Навантажує GPU в кілька разів більше, ніж MetalFX Spatial."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性功能，适合噪点多的低码率串流：利用视频光流获取的运动信息进行时间超分。GPU 开销是 MetalFX Spatial 的数倍。"
          }
        }
      }
    },
    "help_upscaler_sharpness": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastně adaptivní zostření po zvětšení. 0 ho vypne. V režimu Jen zostření je to celý efekt. Změny z menu platí jednu relaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrastadaptive Schärfung nach dem Hochskalieren. 0 deaktiviert sie. Bei „Nur schärfen“ ist sie der gesamte Effekt. Änderungen im Menü gelten eine Sitzung lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrast-adaptive sharpening after upscaling. 0 disables it. In Sharpen only it is the whole effect. Menu changes last one session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitidez adaptativa al contraste tras el escalado. 0 la desactiva. En Solo nitidez es todo el efecto. Los cambios desde el menú duran una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accentuation adaptative au contraste après la mise à l’échelle. 0 la désactive. Avec Netteté seule, c’est tout l’effet. Les changements du menu durent une session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップスケール後のコントラスト適応シャープ化です。0で無効になります。「シャープのみ」では、これが効果のすべてです。メニューでの変更は1セッションのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업스케일 후 대비 적응형 선명화예요. 0이면 꺼져요. 선명화만 모드에서는 이것이 효과 전부예요. 메뉴에서 바꾼 내용은 한 세션 동안만 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitidez adaptativa ao contraste após o upscaling. 0 a desativa. Em Apenas nitidez, é o efeito inteiro. Mudanças pelo menu valem por uma sessão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контрастно-адаптивне підвищення різкості після масштабування. 0 вимикає його. У режимі «Лише різкість» це весь ефект. Зміни з меню діють одну сесію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超分之后的对比度自适应锐化。0 表示关闭。在仅锐化模式下，它就是全部效果。在菜单中的更改仅在本次会话内有效。"
          }
        }
      }
    },
    "help_video_format": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodek, kterým PC kóduje; PC i dekodér ho musí podporovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec, mit dem der PC kodiert; Host und Decoder müssen ihn unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec the PC encodes with; host and decoder must support it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Códec con el que codifica el PC; el host y el decodificador deben admitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec avec lequel le PC encode ; le PC et le décodeur doivent le gérer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCがエンコードに使うコーデックです。ホストとデコーダーが対応している必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC가 인코딩에 사용할 코덱이에요. 호스트와 디코더가 지원해야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec usado pelo PC para codificar; PC e decodificador precisam suportá-lo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кодек, яким кодує ПК; його мають підтримувати хост і декодер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 使用的编码格式；电脑端和解码器都必须支持。"
          }
        }
      }
    },
    "help_video_format_auto": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybere H.264 nebo HEVC. AV1 a PyroWave je potřeba vybrat ručně."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt H.264 oder HEVC. AV1 und PyroWave müssen gewählt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks H.264 or HEVC. AV1 and PyroWave need selecting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige H.264 o HEVC. AV1 y PyroWave hay que seleccionarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit H.264 ou HEVC. AV1 et PyroWave doivent être sélectionnés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264またはHEVCを自動で選びます。AV1とPyroWaveは、選択が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264 또는 HEVC를 골라요. AV1과 PyroWave는 직접 선택해야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe H.264 ou HEVC. AV1 e PyroWave precisam ser selecionados."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирає H.264 або HEVC. AV1 і PyroWave треба вибирати вручну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动选择 H.264 或 HEVC。AV1 和 PyroWave 需要手动选择。"
          }
        }
      }
    },
    "help_video_format_forceav1": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Efektivní při nízkém bitrate. Vyžaduje kódování AV1 v PC a dekódování tady."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Effizient bei niedrigen Bitraten. Erfordert AV1-Encoding am Host und Decoding hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Efficient at low bitrates. Needs AV1 encode on the host and decode here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eficiente con bitrates bajos. Requiere codificación AV1 en el host y decodificación aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efficace à bas débit. Nécessite l’encodage AV1 sur le PC et le décodage ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低ビットレートで効率的です。ホストでのAV1エンコードと、この端末でのデコードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 비트레이트에서 효율적이에요. 호스트의 AV1 인코딩과 이 기기의 디코딩이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eficiente em bitrates baixos. Requer codificação AV1 no PC e decodificação aqui."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ефективний на низьких бітрейтах. Потрібне кодування AV1 на хості й декодування тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低码率下效率高。需要电脑端支持 AV1 编码，且本机支持 AV1 解码。"
          }
        }
      }
    },
    "help_video_format_forceh265": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Méně šířky pásma než H.264; podporuje 10bitové HDR. Může se vrátit na jiný kodek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Bandbreite als H.264; unterstützt 10-Bit-HDR. Kann zurückfallen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less bandwidth than H.264; supports 10-bit HDR. May fall back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos ancho de banda que H.264; admite HDR de 10 bits. Puede volver a otro códec."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de bande passante que H.264 ; gère le HDR 10 bits. Peut se rabattre sur autre chose."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264より帯域が少なく、10ビットHDRに対応します。切り替わる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "H.264보다 대역폭이 적게 들고 10비트 HDR을 지원해요. 다른 코덱으로 바뀔 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa menos largura de banda que H.264; suporta HDR de 10 bits. Pode voltar ao padrão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менше трафіку, ніж H.264; підтримує 10-бітний HDR. Можливий відкат на інший кодек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比 H.264 占用更少带宽；支持 10-bit HDR。可能回退。"
          }
        }
      }
    },
    "help_video_format_neverh265": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejširší kompatibilita; potřebuje víc šířky pásma. Bez HDR."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breiteste Kompatibilität; braucht mehr Bandbreite. Kein HDR."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadest compatibility; needs more bandwidth. No HDR."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayor compatibilidad; necesita más ancho de banda. Sin HDR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibilité maximale ; demande plus de bande passante. Pas de HDR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も互換性が高いですが、帯域が多く必要です。HDRは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호환성이 가장 넓지만 대역폭이 더 필요해요. HDR은 사용할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatibilidade mais ampla; requer mais largura de banda. Sem HDR."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найширша сумісність; потрібно більше трафіку. Без HDR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容性最广；需要更多带宽。不支持 HDR。"
          }
        }
      }
    },
    "help_video_format_pyrowave_gpu": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Waveletový kodek na GPU s vlastním dekodérem na GPU. Vyžaduje rychlé spojení a mnohem vyšší bitrate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-Wavelet-Codec mit eigenem GPU-Decoder. Erfordert eine schnelle Verbindung und deutlich höhere Bitrate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU wavelet codec with its own GPU decoder. Needs a fast link and far higher bitrate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Códec wavelet en GPU con su propio decodificador en GPU. Requiere un enlace rápido y un bitrate mucho más alto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec à ondelettes sur GPU avec son propre décodeur GPU. Nécessite une liaison rapide et un débit bien plus élevé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独自のGPUデコーダーを持つ、GPUウェーブレットコーデックです。高速な回線と、はるかに高いビットレートが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 GPU 디코더를 쓰는 GPU 웨이블릿 코덱이에요. 빠른 연결과 훨씬 높은 비트레이트가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec wavelet de GPU com decodificador de GPU próprio. Requer uma conexão rápida e bitrate bem maior."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вейвлет-кодек на GPU з власним декодером на GPU. Потрібне швидке з’єднання й набагато вищий бітрейт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 GPU 的小波编解码器，使用专用的 GPU 解码器。需要高速链路和高得多的码率。"
          }
        }
      }
    },
    "home_badge_last_played": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Naposledy hráno"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuletzt gespielt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last played"
          }
