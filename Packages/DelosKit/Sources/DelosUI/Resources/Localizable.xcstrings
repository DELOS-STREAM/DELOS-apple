    "debug_pattern_flutter_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dvacet pulzů 20 ms na plný vstup, za každým následuje 40 ms ticha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwanzig 20-ms-Impulse mit voller Eingabe, jeweils gefolgt von 40 ms Stille."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twenty full-input 20 ms pulses, each followed by 40 ms of silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Veinte pulsos de 20 ms a entrada máxima, cada uno seguido de 40 ms de silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vingt impulsions de 20 ms à pleine entrée, chacune suivie de 40 ms de silence."
