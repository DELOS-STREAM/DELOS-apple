    "shell_button_capture_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrž je společně a pak pusť. Funguje i jedno tlačítko, třeba zadní. Počkáním nebo klepnutím zrušíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte sie gleichzeitig gedrückt und lass dann los. Eine einzelne Taste geht auch, z. B. eine Rückseitentaste. Warte oder tippe zum Abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold them together, then let go. One button works too, e.g. a rear button. Wait or tap to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenlos pulsados a la vez y suéltalos. También vale un solo botón, p. ej. uno trasero. Espera o toca para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens-les ensemble, puis relâche. Un seul bouton marche aussi, par ex. une palette arrière. Attends ou touche l’écran pour annuler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時に押し、そのまま離してください。背面ボタンなど、1つのボタンでも設定できます。キャンセルするには、待つかタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼을 함께 누르고 있다가 놓으세요. 뒷면 버튼처럼 버튼 하나만 써도 돼요. 취소하려면 기다리거나 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure-os juntos e solte. Um único botão também funciona, por exemplo um botão traseiro. Aguarde ou toque para cancelar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Утримуй їх разом, потім відпусти. Підійде й одна кнопка, наприклад задня. Зачекай або торкнись, щоб скасувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时按住它们，然后松开。也可以只用一个按键，例如背键。等待或点按即可取消。"
          }
        }
      }
    },
