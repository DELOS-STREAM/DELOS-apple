    "help_list_rumble_feel_kick_only": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Silný krátký úder na začátku každé vibrace, pak běžná úroveň."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kräftiger kurzer Kick zu Beginn jedes Rumbles, dann die normale Stärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A strong short kick at the start of each rumble, then the normal level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un impulso corto y fuerte al inicio de cada vibración, y luego el nivel normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup fort et bref au début de chaque vibration, puis le niveau normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各振動の始めに短く強いキックを入れ、その後は通常のレベルにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "럼블이 시작될 때마다 짧고 강한 킥이 오고 이후에는 일반 세기예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um golpe forte e curto no início de cada vibração, depois o nível normal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сильний короткий поштовх на початку кожної вібрації, далі звичайний рівень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次震动开始时有一下强而短的冲击，之后恢复正常强度。"
          }
        }
      }
    },
    "help_list_rumble_feel_original": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrace ze hry přesně tak, jak je hra posílá."
