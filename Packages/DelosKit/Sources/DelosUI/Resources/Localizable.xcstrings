    "debug_preset_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber níže předvolbu, tím se uloží a hned se přehraje ukázka Test."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle unten ein Preset, um es zu speichern und sofort das Testmuster abzuspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a preset below to save it and immediately play the Test sample."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un ajuste preestablecido abajo para guardarlo y reproducir al instante la muestra de prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne un préréglage ci-dessous pour l’enregistrer et jouer aussitôt l’échantillon Test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のプリセットを選ぶと保存され、すぐにテストサンプルを再生します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래에서 프리셋을 선택하면 저장되고 테스트 샘플이 바로 재생돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma predefinição abaixo para salvá-la e reproduzir de imediato a amostra de Teste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери пресет нижче, щоб зберегти його й одразу відтворити зразок Test."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下方选择一个预设即可保存，并立即播放测试样本。"
          }
        }
      }
    },
    "debug_preset_details": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim: %1$@\nPokročilé úpravy se ukládají jako Vlastní, i když hodnoty odpovídají předvolbě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus: %1$@\nErweiterte Änderungen werden als Eigene gespeichert, auch wenn die Werte zu einem Preset passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode: %1$@\nAdvanced edits are saved as Custom, even if the values match a preset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo: %1$@\nLas ediciones avanzadas se guardan como Personalizado, aunque los valores coincidan con un ajuste preestablecido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode : %1$@\nLes modifications avancées sont enregistrées comme Personnalisé, même si les valeurs correspondent à un préréglage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モード：%1$@\n詳細設定の編集は、値がプリセットと同じでもカスタムとして保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드: %1$@\n고급 편집 내용은 값이 프리셋과 같아도 사용자 지정으로 저장돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo: %1$@\nAjustes avançados são salvos como Personalizado, mesmo que os valores coincidam com uma predefinição."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим: %1$@\nЗміни в розширених параметрах зберігаються як «Власний», навіть якщо значення збігаються з пресетом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模式：%1$@\n高级选项的修改会保存为自定义，即使数值与某个预设一致。"
          }
        }
      }
    },
