    "settings_native_choose_artwork_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Úvodní obrazovka: pravé tlačítko menu u aplikace → Obrázky. Vyber libovolný obal, široký obal, pozadí nebo logo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startseite: rechte Menütaste bei einer App → Artwork. Wähle ein beliebiges Cover, breites Cover, einen Hintergrund oder ein Logo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home screen: right menu button on an app → Artwork. Pick any cover, wide cover, background or logo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla de inicio: botón de menú derecho sobre una app → Ilustraciones. Elige cualquier portada, portada panorámica, fondo o logo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écran d’accueil : bouton de menu droit sur une appli → Visuels. Choisis n’importe quelle jaquette, jaquette large, arrière-plan ou logo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面：アプリ上で右メニューボタン → アートワーク。カバー、ワイドカバー、背景、ロゴを自由に選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면: 앱에서 오른쪽 메뉴 버튼 → 아트워크. 원하는 커버, 와이드 커버, 배경, 로고를 고를 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tela inicial: botão direito do menu em um app → Arte. Escolha qualquer capa, capa larga, fundo ou logo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Головний екран: права кнопка меню на застосунку → Ілюстрації. Вибери будь-яку обкладинку, широку обкладинку, тло або логотип."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主页：应用上的右侧菜单键 > 图片素材。可选择任意封面、横版封面、背景或标志。"
          }
        }
      }
    },
