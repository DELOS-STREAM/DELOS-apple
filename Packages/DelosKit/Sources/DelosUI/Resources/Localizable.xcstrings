        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」はアドレスではありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”은(는) 올바른 주소가 아니에요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” não é um endereço"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» не є адресою"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”不是有效地址"
