    "stream_result_host_error": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při spouštění streamu se v PC něco pokazilo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Starten des Streams ist auf dem PC etwas schiefgelaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on the PC while starting the stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha fallado en el PC al iniciar el stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu sur le PC au démarrage du stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームの開始中に、PCで問題が発生しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림을 시작하는 중 PC에서 문제가 생겼어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado no PC ao iniciar o stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так на ПК під час запуску стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动串流时电脑出了点问题。"
          }
        }
      }
    },
    "stream_result_host_error_details": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tvém PC se při spouštění streamu něco pokazilo.\n\nOvěř, že v PC nemáš otevřený žádný obsah chráněný DRM. Můžeš také zkusit PC restartovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Starten des Streams ist auf deinem Host-PC etwas schiefgelaufen.\n\nStelle sicher, dass auf dem Host-PC keine DRM-geschützten Inhalte geöffnet sind. Du kannst auch versuchen, den Host-PC neu zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on your host PC when starting the stream.\n\nMake sure you don't have any DRM-protected content open on your host PC. You can also try restarting your host PC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ha fallado en tu PC host al iniciar el stream.\n\nAsegúrate de no tener abierto contenido protegido con DRM en el PC host. También puedes probar a reiniciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un problème est survenu sur ton PC hôte au démarrage du stream.\n\nVérifie qu’aucun contenu protégé par DRM n’est ouvert sur ton PC. Tu peux aussi essayer de le redémarrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームの開始中に、ホストPCで問題が発生しました。\n\nホストPCでDRM保護されたコンテンツを開いていないか確認してください。ホストPCを再起動してみるのも有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림을 시작하는 중 호스트 PC에서 문제가 생겼어요.\n\n호스트 PC에 DRM으로 보호된 콘텐츠가 열려 있지 않은지 확인해 주세요. 호스트 PC를 다시 시작해 볼 수도 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado no seu PC ao iniciar o stream.\n\nVerifique se não há conteúdo protegido por DRM aberto no PC. Você também pode tentar reiniciá-lo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щось пішло не так на твоєму ПК-хості під час запуску стріму.\n\nПереконайся, що на ПК-хості не відкрито вміст із захистом DRM. Також можеш спробувати перезапустити ПК-хост."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动串流时，你的电脑出了点问题。\n\n请确认电脑上没有打开受 DRM 保护的内容。你也可以尝试重启电脑。"
          }
        }
      }
    },
