    "settings_native_stats_position_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Roh panelu s plnými statistikami při streamování. Kompaktní režim je vždy nahoře uprostřed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecke des vollständigen Statistik-Panels beim Streamen. Der Kompaktmodus ist immer oben mittig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Corner of the full statistics panel while streaming. Compact mode is always top center."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esquina del panel de estadísticas completo durante el stream. El modo compacto siempre va arriba en el centro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coin du panneau complet de statistiques pendant le stream. Le mode compact est toujours en haut au centre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミング中のフル統計パネルを表示する隅です。コンパクトモードは常に上部中央です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍 중 전체 통계 패널이 표시되는 모서리예요. 간단 모드는 항상 상단 가운데예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Canto do painel completo de estatísticas durante a transmissão. O modo compacto fica sempre no centro superior."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кут повної панелі статистики під час стріму. Компактний режим завжди вгорі посередині."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流时完整统计面板所在的角落。精简模式始终位于顶部居中。"
          }
        }
      }
    },
