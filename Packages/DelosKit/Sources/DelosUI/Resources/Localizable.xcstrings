    "settings_native_steam_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žánry a témata na kartách pocházejí z veřejných uživatelských štítků Steamu, pokud má hra stránku na Steamu; čtou se ze stránky obchodu přes metadatovou službu aplikace Delos. Neoficiální a může se změnit; jinak se použije IGDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genres und Themes der Karten stammen aus den öffentlichen Nutzer-Tags von Steam, wenn ein Spiel eine Steam-Seite hat, und werden über den Delos-Metadatendienst von der Store-Seite gelesen. Inoffiziell und kann sich ändern; sonst wird IGDB genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Card genres and themes come from Steam's public user tags where a game has a Steam page, read from the store page through the Delos metadata service. Unofficial and may change; IGDB is used otherwise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los géneros y temáticas de las fichas proceden de las etiquetas públicas de usuario de Steam cuando un juego tiene página en Steam, leídas de la página de la tienda a través del servicio de metadatos de Delos. No es oficial y puede cambiar; en caso contrario se usa IGDB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les genres et thèmes des cartes viennent des tags utilisateurs publics de Steam quand un jeu a une page Steam, lus sur la page de la boutique via le service de métadonnées de Delos. Non officiel et susceptible de changer ; sinon IGDB est utilisé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードのジャンルとテーマは、Steamのページがあるゲームについて、Delosのメタデータサービス経由でストアページから読み取ったSteamの公開ユーザータグを使っています。非公式のため変更される可能性があります。それ以外ではIGDBを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 페이지가 있는 게임은 Steam의 공개 사용자 태그에서 카드의 장르와 테마를 가져와요. Delos 메타데이터 서비스를 통해 스토어 페이지에서 읽어 와요. 비공식이라 바뀔 수 있고, 그 외에는 IGDB를 사용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os gêneros e temas dos cards vêm das tags públicas de usuários da Steam quando o jogo tem página na Steam, lidas da página da loja pelo serviço de metadados do app Delos. Não oficial e pode mudar; caso contrário, o IGDB é usado."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жанри й теми на картках беруться з публічних користувацьких тегів Steam, якщо в гри є сторінка в Steam; їх зчитують зі сторінки магазину через сервіс метаданих Delos. Неофіційно й може змінитися; в іншому разі використовується IGDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若游戏有 Steam 页面，卡片上的类型和主题来自 Steam 公开的用户标签，通过 Delos 元数据服务从商店页面读取。非官方，可能会变化；否则使用 IGDB。"
          }
        }
      }
    },
