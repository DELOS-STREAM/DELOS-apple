    "debug_min_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimální výstup pro nenulový požadavek z PC. Nulový vstup zůstává tichý."
          }
        },
