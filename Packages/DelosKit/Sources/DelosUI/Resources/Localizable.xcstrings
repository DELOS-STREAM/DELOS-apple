        }
      }
    },
    "stream_encryption_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Co poslední stream dohodl s PC. Zda se šifruje video a zvuk, záleží na nastavení PC a na tomto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was der letzte Stream mit dem PC ausgehandelt hat. Ob Video und Audio verschlüsselt werden, hängt von den Einstellungen des PCs und von diesem Gerät ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What the last stream negotiated with the PC. Whether video and audio are encrypted depends on the PC's settings and on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que el último stream negoció con el PC. Que el vídeo y el audio se cifren depende de los ajustes del PC y de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que le dernier stream a négocié avec le PC. Le chiffrement de la vidéo et de l’audio dépend des réglages du PC et de cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のストリームがPCとネゴシエートした内容です。映像と音声が暗号化されるかどうかは、PCの設定とこのデバイスによって決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 스트림이 PC와 협상한 내용이에요. 비디오와 오디오의 암호화 여부는 PC 설정과 이 기기에 따라 달라져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o último stream negociou com o PC. A criptografia do vídeo e do áudio depende das configurações do PC e deste dispositivo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що останній стрім узгодив із ПК. Чи шифруються відео та звук, залежить від налаштувань ПК і від цього пристрою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一次串流与 PC 协商的结果。视频和音频是否加密取决于 PC 的设置和此设备。"
          }
        }
      }
    },
