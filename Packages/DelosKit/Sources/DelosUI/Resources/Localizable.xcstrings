    "help_about_diag_logs": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovává na tomto zařízení průběžný záznam událostí a chyb (nejvýš 2 MB). Nic z něj neopustí zařízení, dokud ho nesdílíš z obrazovky „Informace pro ladění“, a to s odstraněnými jmény a adresami. Vypnutím se přestanou ukládat nové řádky."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt ein fortlaufendes Protokoll (höchstens 2 MB) von Ereignissen und Fehlern auf diesem Gerät. Nichts verlässt es, außer du teilst es über Debug-Info, mit entfernten Namen und Adressen. Aus stoppt neue Zeilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a rolling log (2 MB at most) of events and errors on this device. Nothing leaves it unless you share it from Debug info, with names and addresses removed. Off stops new lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un registro rotativo (2 MB como máximo) de eventos y errores en este dispositivo. Nada sale de él salvo que lo compartas desde Información de depuración, con nombres y direcciones eliminados. Desactivado detiene las líneas nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde un journal glissant (2 Mo max.) des événements et erreurs sur cet appareil. Rien n’en sort sauf si tu le partages depuis Infos de débogage, noms et adresses retirés. Désactivé, plus de nouvelles lignes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末に、イベントとエラーのログを最大2 MBまで循環して保存します。デバッグ情報から共有しない限り、端末の外には出ません。共有時は名前とアドレスが削除されます。オフにすると、新しい行は記録されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 이벤트와 오류의 롤링 로그(최대 2 MB)를 보관해요. 디버그 정보에서 직접 공유하지 않는 한 기기 밖으로 나가지 않으며, 이름과 주소는 제거돼요. 끄면 새 줄이 기록되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém um log contínuo (no máximo 2 MB) de eventos e erros neste dispositivo. Nada sai dele a menos que você compartilhe em Informações de depuração, com nomes e endereços removidos. Desativado, para de gravar novas linhas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Веде циклічний журнал (до 2 MB) подій і помилок на цьому пристрої. Нічого не залишає його, доки ти сам не поділишся з розділу «Налагодження», причому імена й адреси прибираються. Вимкнено — нові рядки не пишуться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本设备上保留滚动日志（最大 2 MB），记录事件和错误。除非你在调试信息中分享，否则不会离开设备，且会去除名称和地址。关闭后将停止记录新内容。"
          }
        }
      }
    },
    "help_analog_scrolling": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick, který posouvá v režimu myši přes gamepad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick, der im Gamepad-Mausmodus scrollt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick that scrolls in gamepad mouse mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick que desplaza en el modo de ratón con el mando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stick qui défile en mode souris de la manette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーのマウスモードで、スクロールに使うスティックです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임패드 마우스 모드에서 스크롤에 사용하는 스틱이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analógico que rola a tela no modo mouse do controle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стік, що прокручує в режимі миші на контролері."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手柄鼠标模式下用于滚动的摇杆。"
          }
        }
      }
    },
    "help_analog_scrolling_left": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
