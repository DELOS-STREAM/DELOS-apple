          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new name is only used in Delos on this device. Leave it empty for the PC's own name (%1$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nombre nuevo solo se usa en Delos en este dispositivo. Déjalo vacío para usar el nombre del propio PC (%1$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nouveau nom n’est utilisé que dans Delos sur cet appareil. Laisse vide pour le nom du PC lui-même (%1$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい名前は、この端末の Delosでのみ使われます。空欄にすると、PC本来の名前（%1$@）になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 이름은 이 기기의 Delos에서만 사용돼요. 비워 두면 PC 원래 이름(%1$@)을 사용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo nome é usado apenas no app Delos neste dispositivo. Deixe vazio para usar o nome do próprio PC (%1$@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нове ім’я діє лише в Delos на цьому пристрої. Залиш поле порожнім, щоб використати власне ім’я ПК (%1$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新名称仅在本设备的 Delos 中使用。留空则使用 PC 自身的名称（%1$@）。"
          }
        }
      }
    },
