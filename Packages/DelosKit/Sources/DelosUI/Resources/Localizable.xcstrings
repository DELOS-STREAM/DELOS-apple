    "report_uploaded": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam je nahrán a jeho odkaz je v konceptu. Uchová se 30 dní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokoll hochgeladen, der Link steht im Entwurf. Es wird 30 Tage gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log uploaded; its link is in the draft. It is kept for 30 days."
          }
        },
        "es": {
