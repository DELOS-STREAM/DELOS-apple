{
  "sourceLanguage": "en",
  "strings": {
    "devices_add_no_answer": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na adrese %1$@ neodpovědělo žádné PC"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter %1$@ hat kein PC geantwortet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No PC answered at %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún PC ha respondido en %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun PC n’a répondu à %1$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のPCから応答がありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 응답하는 PC가 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum PC respondeu em %1$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За адресою %1$@ жоден ПК не відповів"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 处没有 PC 响应"
          }
        }
      }
    },
    "devices_add_not_an_address": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ není adresa"
