    "conn_quit_foreign": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto relaci spustilo jiné zařízení, takže ji nelze ukončit. Ukonči stream na tom zařízení nebo na PC. (Chyba %1$d)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung wurde von einem anderen Gerät gestartet und kann deshalb nicht beendet werden. Beende den Stream auf jenem Gerät oder am PC. (Fehler %1$d)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session was started by another device, so it cannot be quit. End the stream on that device or on the PC. (Error %1$d)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión la inició otro dispositivo, así que no se puede cerrar. Termina el stream en ese dispositivo o en el PC. (Error %1$d)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session a été lancée par un autre appareil et ne peut donc pas être quittée. Arrête le stream sur cet appareil ou sur le PC. (Erreur %1$d)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは別のデバイスで開始されたため、終了できません。そのデバイスまたはPCでストリームを終了してください。（エラー %1$d）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션은 다른 기기에서 시작되어 종료할 수 없어요. 해당 기기나 PC에서 스트림을 종료해 주세요. (오류 %1$d)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão foi iniciada por outro dispositivo e, por isso, não pode ser encerrada. Encerre o stream naquele dispositivo ou no PC. (Erro %1$d)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сеанс запустив інший пристрій, тому його не можна завершити. Заверши стрім на тому пристрої або на ПК. (Помилка %1$d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话由其他设备启动，因此无法退出。请在该设备或 PC 上结束串流。（错误 %1$d）"
          }
        }
      }
    },
