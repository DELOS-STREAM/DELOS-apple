    "debug_gain_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celkový násobitel vibrací, 50–300 %. Změna parametru zastaví aktuální vzor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamtmultiplikator der Vibration, 50–300%. Ein geänderter Parameter stoppt das aktuelle Muster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overall rumble multiplier, 50–300%. Changing a parameter stops the current pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Multiplicador global de la vibración, del 50 al 300%. Cambiar un parámetro detiene el patrón actual."
          }
        },
        "fr": {
