          "stringUnit": {
            "state": "translated",
            "value": "このストリームの間、この端末の明るさを調整します。終了後はシステム設定に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 스트림 동안 이 기기의 밝기를 조절해요. 끝나면 시스템 설정으로 돌아가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o brilho deste dispositivo neste stream; a configuração do sistema volta depois."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює яскравість цього пристрою для цього стріму; потім повертається системне значення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调节本设备在本次串流中的亮度；之后会恢复系统设置。"
          }
        }
      }
    },
    "stream_help_commands": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypíše příkazy serveru nastavené ve Vibepollo nebo Apollo. Co který udělá, určuje PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Serverbefehle, die in Vibepollo oder Apollo eingerichtet sind. Der Host entscheidet, was jeder tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists server commands configured in Vibepollo or Apollo. The host decides what each does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los comandos del servidor configurados en Vibepollo o Apollo. El host decide qué hace cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les commandes du serveur configurées dans Vibepollo ou Apollo. Le PC décide de ce que fait chacune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VibepolloまたはApolloで設定されたサーバーコマンドを一覧表示します。それぞれの動作はホストが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibepollo 또는 Apollo에 설정된 서버 명령을 보여 줘요. 각 명령이 하는 일은 호스트가 정해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista os comandos do servidor configurados no Vibepollo ou Apollo. O PC decide o que cada um faz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує серверні команди, налаштовані у Vibepollo або Apollo. Що робить кожна, вирішує хост."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出在 Vibepollo 或 Apollo 中配置的服务器命令。每条命令的作用由电脑端决定。"
          }
        }
      }
    },
    "stream_help_disconnect": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví streamování a vrátí se do knihovny aplikace Delos. Aplikace na PC dál běží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet das Streamen und kehrt zur Delos-Bibliothek zurück. Die App läuft auf dem PC weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops streaming and returns to the Delos library. The app keeps running on the PC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el streaming y vuelve a la biblioteca de Delos. La app sigue ejecutándose en el PC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le streaming et revient à la bibliothèque Delos. L’appli continue sur le PC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングを停止して、Delosのライブラリに戻ります。アプリはPCで実行されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍을 중단하고 Delos 라이브러리로 돌아가요. 앱은 PC에서 계속 실행돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a transmissão e volta à biblioteca do Delos. O app continua rodando no PC."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє стрім і повертає до бібліотеки Delos. Застосунок продовжує працювати на ПК."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止串流并返回 Delos 应用库。应用会继续在 PC 上运行。"
          }
        }
      }
    },
    "stream_help_format_command": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hned spustí v PC příkaz %1$@ definovaný v PC. Nastavuje se ve Vibepollo nebo Apollo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt den vom Host definierten Befehl %1$@ sofort auf dem PC aus. Eingerichtet in Vibepollo oder Apollo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs the host-defined command %1$@ on the PC at once. Set in Vibepollo or Apollo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta al instante en el PC el comando %1$@ definido por el host. Se configura en Vibepollo o Apollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute aussitôt sur le PC la commande %1$@ définie par le PC. À configurer dans Vibepollo ou Apollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストで定義されたコマンド%1$@を、PCですぐに実行します。VibepolloまたはApolloで設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에 정의된 명령 %1$@을(를) PC에서 바로 실행해요. Vibepollo 또는 Apollo에서 설정해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa na hora no PC o comando %1$@ definido pelo PC. Configurado no Vibepollo ou Apollo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу виконує на ПК команду хоста %1$@. Задається у Vibepollo або Apollo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即在 PC 上运行电脑端定义的命令 %1$@。在 Vibepollo 或 Apollo 中设置。"
          }
        }
      }
    },
    "stream_help_format_keys": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou pošle do PC %1$@ a vrátí se do streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet %1$@ einmalig an den PC und kehrt dann zum Stream zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends %1$@ to the PC once, then returns to the stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía %1$@ al PC una vez y vuelve al stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie %1$@ une fois au PC, puis revient au stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をPCに1回送信してから、ストリームに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) PC로 한 번 보낸 뒤 스트림으로 돌아가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia %1$@ ao PC uma vez e volta ao stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз надсилає %1$@ на ПК, потім повертає до стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 PC 发送一次 %1$@，然后返回串流。"
          }
        }
      }
    },
    "stream_help_quit_game": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá PC o ukončení běžící aplikace a pak se odpojí. Provede se hned, takže nejdřív ulož."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittet den Host, die laufende Anwendung zu beenden, und trennt dann die Verbindung. Läuft sofort, speichere also vorher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks the host to end the running application, then disconnects. Runs at once, so save first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide al host que termine la aplicación en ejecución y luego se desconecta. Se ejecuta al instante, así que guarda antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande au PC de fermer l’application en cours, puis se déconnecte. S’exécute aussitôt, alors sauvegarde d’abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストに実行中のアプリの終了を要求し、その後に切断します。すぐに実行されるため、先に保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에 실행 중인 애플리케이션을 종료하라고 요청한 뒤 연결을 끊어요. 바로 실행되니 먼저 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede ao PC que encerre o aplicativo em execução e depois desconecta. Roda na hora, então salve antes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просить хост завершити запущений застосунок, потім відключається. Виконується одразу, тож спершу збережись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求电脑端结束正在运行的应用，然后断开连接。会立即执行，请先保存。"
          }
        }
      }
    },
    "stream_help_resume": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavře toto menu a pokračuje ve streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt dieses Menü und setzt den Stream fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes this menu and continues the stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra este menú y continúa el stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme ce menu et reprend le stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメニューを閉じて、ストリームを続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메뉴를 닫고 스트림을 이어서 진행해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha este menu e continua o stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриває це меню й продовжує стрім."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此菜单并继续串流。"
          }
        }
      }
    },
    "stream_help_screen_brightness": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hned změní jas obrazovky tohoto zařízení; systémové nastavení se poté vrátí. Netýká se PC ani monitoru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Bildschirmhelligkeit dieses Geräts sofort; danach gilt wieder die Systemeinstellung. Nicht die von PC oder Monitor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes this device's screen brightness now; the system setting returns afterwards. Not the PC or a monitor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia ahora el brillo de pantalla de este dispositivo; después vuelve el ajuste del sistema. No el del PC ni el de un monitor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change tout de suite la luminosité de l’écran de cet appareil ; le réglage système revient ensuite. Pas celle du PC ni d’un moniteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の画面の明るさをすぐに変更します。終了後はシステム設定に戻ります。PCやモニターには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 화면 밝기를 바로 바꿔요. 끝나면 시스템 설정으로 돌아가요. PC나 모니터에는 적용되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda agora o brilho da tela deste dispositivo; a configuração do sistema volta depois. Não afeta o PC nem um monitor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює яскравість екрана цього пристрою зараз; потім повертається системне значення. Не ПК і не монітор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即更改本设备的屏幕亮度；之后会恢复系统设置。不影响 PC 或显示器。"
          }
        }
      }
    },
    "stream_help_send_keys": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou pošle do PC vestavěnou nebo importovanou kombinaci kláves; menu se zavře. Vlastní naimportuješ na záložce Ovládání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einmalig eine eingebaute oder importierte Tastenkombination an den PC; das Menü schließt sich. Eigene importierst du unter Steuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a built-in or imported key combination to the PC once; the menu closes. Import custom ones under Controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una vez al PC una combinación de teclas integrada o importada; el menú se cierra. Importa otras personalizadas en Controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une fois au PC une combinaison de touches intégrée ou importée ; le menu se ferme. Importe les tiennes dans Commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵またはインポートしたキーの組み合わせを、PCに1回送信します。メニューは閉じます。カスタムのものは「操作」でインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공 또는 가져온 키 조합을 PC로 한 번 보내고 메뉴를 닫아요. 사용자 지정 키는 컨트롤에서 가져오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia uma vez ao PC uma combinação de teclas integrada ou importada; o menu fecha. Importe as personalizadas em Controles."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз надсилає на ПК вбудовану або імпортовану комбінацію клавіш; меню закривається. Власні імпортуються в розділі «Керування»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 PC 发送一次内置或已导入的组合键；菜单随即关闭。可在控制中导入自定义组合键。"
          }
        }
      }
    },
    "stream_help_task_manager": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošle do PC Ctrl + Shift + Esc, což ve Windows otevře Správce úloh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Ctrl + Shift + Esc an den PC, was unter Windows den Task-Manager öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends Ctrl + Shift + Esc to the PC, which opens Task Manager on Windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía Ctrl + Shift + Esc al PC, que abre el Administrador de tareas en Windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie Ctrl + Shift + Esc au PC, ce qui ouvre le Gestionnaire des tâches sous Windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCにCtrl + Shift + Escを送信します。Windowsではタスクマネージャーが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC로 Ctrl + Shift + Esc를 보내요. Windows에서는 작업 관리자가 열려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia Ctrl + Shift + Esc ao PC, o que abre o Gerenciador de Tarefas no Windows."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає на ПК Ctrl + Shift + Esc, що відкриває Диспетчер завдань у Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 PC 发送 Ctrl + Shift + Esc，在 Windows 上会打开任务管理器。"
          }
        }
      }
    },
    "stream_loader_codec_auto": {
