    "artwork_choose_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hledej pod jiným názvem: např. Windows, Steam nebo jakoukoli hru, jejíž obrázky se ti líbí. %1$@ se automaticky nehledá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach anderem Namen suchen: z. B. Windows, Steam oder ein beliebiges Spiel, dessen Artwork dir gefällt. %1$@ wird nicht automatisch gesucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for another name: e.g. Windows, Steam or any game whose artwork you like. %1$@ is not looked up automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca otro nombre: p. ej. Windows, Steam o cualquier juego cuyas ilustraciones te gusten. %1$@ no se busca automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chercher un autre nom : par ex. Windows, Steam ou n’importe quel jeu dont tu aimes les visuels. %1$@ n’est pas recherché automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「別の名前で検索」で、WindowsやSteam、好きなアートワークのゲームなどを探せます。%1$@は自動では検索されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이름으로 검색해 보세요. 예: Windows, Steam 또는 아트워크가 마음에 드는 아무 게임. %1$@은(는) 자동으로 검색하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar por outro nome: por exemplo Windows, Steam ou qualquer jogo cuja arte você goste. %1$@ não é buscado automaticamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Шукати за іншою назвою»: наприклад, Windows, Steam або будь-яка гра, чиї ілюстрації тобі подобаються. %1$@ автоматично не шукається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索其他名称：例如 Windows、Steam，或任何你喜欢其图片素材的游戏。不会自动查找 %1$@。"
          }
        }
      }
    },
