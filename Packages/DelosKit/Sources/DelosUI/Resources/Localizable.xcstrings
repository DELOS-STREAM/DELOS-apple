{
  "sourceLanguage": "en",
  "strings": {
    "artwork_error_api_http": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB odpověděl %1$d"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB antwortete mit %1$d"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB answered %1$d"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB ha respondido %1$d"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB a répondu %1$d"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDBの応答：%1$d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB 응답 코드 %1$d"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SteamGridDB respondeu %1$d"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB відповів %1$d"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB 返回 %1$d"
          }
        }
      }
    },
    "artwork_error_bad_reply": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB poslal nečitelnou odpověď"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB hat eine unlesbare Antwort gesendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB sent an unreadable reply"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB ha enviado una respuesta ilegible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB a envoyé une réponse illisible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDBの応答を読み取れませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB 응답을 읽을 수 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SteamGridDB enviou uma resposta ilegível"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB надіслав нечитабельну відповідь"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB 返回了无法读取的响应"
          }
        }
      }
    },
    "artwork_error_key_rejected": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
