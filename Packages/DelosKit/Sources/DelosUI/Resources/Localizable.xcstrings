    "debug_smoothing_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Omezí rychlé změny amplitudy. Nula reaguje okamžitě; vyšší hodnoty se ustalují pomaleji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt schnelle Amplitudenwechsel. Null reagiert sofort, höhere Werte pendeln sich langsamer ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limit rapid amplitude changes. Zero responds immediately; higher values settle more slowly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita los cambios bruscos de amplitud. Cero responde al instante; los valores más altos se estabilizan más despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite les changements rapides d’amplitude. Zéro réagit immédiatement ; plus la valeur est haute, plus la stabilisation est lente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "急な振幅の変化を抑えます。0なら即座に反応し、値が大きいほどゆっくり落ち着きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "급격한 진폭 변화를 제한해요. 0이면 즉시 반응하고, 값이 높을수록 천천히 안정돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita mudanças rápidas de amplitude. Zero responde de imediato; valores maiores se estabilizam mais devagar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обмежує різкі зміни амплітуди. Нуль — миттєвий відгук; більші значення стабілізуються повільніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限制振幅的快速变化。为零时立即响应；数值越高，稳定得越慢。"
          }
        }
      }
    },
