    "summary_seekbar_bitrate": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvyš pro lepší kvalitu obrazu. Sniž pro lepší výkon na pomalejších připojeních."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhöhen für bessere Bildqualität. Senken für bessere Leistung bei langsameren Verbindungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase for better image quality. Decrease to improve performance on slower connections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auméntalo para mejorar la calidad de imagen. Redúcelo para mejorar el rendimiento en conexiones lentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmente pour une meilleure qualité d’image. Diminue pour de meilleures performances sur les connexions lentes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上げると画質が向上します。下げると、低速な接続で動作が改善します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "높이면 화질이 좋아져요. 낮추면 느린 연결에서 성능이 좋아져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente para melhorar a qualidade da imagem. Diminua para ter mais desempenho em conexões mais lentas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збільш для кращої якості зображення. Зменш для кращої продуктивності на повільних з’єднаннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调高可提升画质；调低可改善较慢连接下的性能。"
          }
        }
      }
    },
