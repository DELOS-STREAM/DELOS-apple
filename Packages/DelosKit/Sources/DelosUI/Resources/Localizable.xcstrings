    "debug_stop_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví vzor z laboratoře a všechny nepřetržité testy vibrací zařízení i gamepadů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt das Labormuster und alle Dauervibrationstests von Gerät und Controllern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the laboratory pattern and all continuous device/controller vibration tests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el patrón del laboratorio y todas las pruebas de vibración continua del dispositivo y los mandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le motif du laboratoire et tous les tests de vibration continue de l’appareil et des manettes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラボのパターンと、端末/コントローラーの連続振動テストをすべて停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험실 패턴과 모든 연속 기기/컨트롤러 진동 테스트를 중지해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o padrão do laboratório e todos os testes de vibração contínua do dispositivo e dos controles."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє шаблон лабораторії та всі тести безперервної вібрації пристрою й контролерів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止实验室波形以及所有持续的设备/手柄震动测试。"
          }
        }
      }
    },
