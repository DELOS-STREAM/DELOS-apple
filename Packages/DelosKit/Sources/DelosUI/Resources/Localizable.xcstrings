      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhled ovládání na obrazovce · nic se neodesílá do PC · %1$@ = zpět"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau der Bildschirmsteuerung · es wird nichts an einen PC gesendet · %1$@ zum Zurückgehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-screen controls preview · nothing is sent to a PC · %1$@ to go back"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de los controles en pantalla · no se envía nada a un PC · %1$@ para volver"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu des commandes à l’écran · rien n’est envoyé à un PC · %1$@ pour revenir"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のコントロールのプレビュー · PCには何も送信されません · %1$@で戻る"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 컨트롤 미리보기 · PC로 아무것도 전송되지 않아요 · %1$@로 뒤로 가기"
          }
        },
        "pt-BR": {
