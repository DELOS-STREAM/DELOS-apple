          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 컨트롤을 더 투명하게 또는 덜 투명하게 해요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
