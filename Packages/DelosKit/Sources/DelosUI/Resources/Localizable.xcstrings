    "debug_amplitude_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zda vibrační motor umí měnit svou sílu."
          }
        },
        "de": {
          "stringUnit": {
