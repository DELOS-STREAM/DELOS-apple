    "settings_native_sgdb_key_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Díky vlastnímu klíči může aplikace Delos stahovat ze SteamGridDB obaly, široké obaly, pozadí a loga. Klíč zůstává na tomto zařízení pro všechny profily."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit deinem eigenen Schlüssel kann Delos Cover, breite Cover, Hintergründe und Logos von SteamGridDB laden. Wird für alle Profile auf diesem Gerät gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own key lets Delos download covers, wide covers, backgrounds and logos from SteamGridDB. Kept on this device for every profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu propia clave permite a Delos descargar portadas, portadas panorámicas, fondos y logos de SteamGridDB. Se guarda en este dispositivo para todos los perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta propre clé permet à Delos de télécharger jaquettes, jaquettes larges, arrière-plans et logos depuis SteamGridDB. Conservée sur cet appareil pour tous les profils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご自身のキーがあれば、DelosがSteamGridDBからカバー、ワイドカバー、背景、ロゴをダウンロードできます。すべてのプロフィールで共通して、この端末に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 키를 사용하면 Delos가 SteamGridDB에서 커버, 와이드 커버, 배경, 로고를 내려받을 수 있어요. 모든 프로필에서 이 기기에 보관돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com a sua chave, o app Delos baixa capas, capas largas, fundos e logos do SteamGridDB. Fica guardada neste dispositivo para todos os perfis."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власний ключ дає Delos змогу завантажувати з SteamGridDB обкладинки, широкі обкладинки, тло та логотипи. Зберігається на цьому пристрої для всіх профілів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的密钥，Delos 即可从 SteamGridDB 下载封面、横版封面、背景和标志。密钥保存在此设备上，所有个人资料共用。"
          }
        }
      }
    },
