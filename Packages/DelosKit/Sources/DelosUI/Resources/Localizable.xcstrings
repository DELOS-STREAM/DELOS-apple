{
  "sourceLanguage": "en",
  "strings": {
    "conn_app_minimized": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace je minimalizovaná. Obnov ji na PC, nebo relaci ukonči a spusť stream znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App ist minimiert. Setze sie am PC fort oder beende die Sitzung und starte den Stream erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is minimized. Resume it on the PC or quit the session and start the stream again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app está minimizada. Reanúdala en el PC o cierra la sesión y vuelve a iniciar el stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appli est réduite. Reprends-la sur le PC ou quitte la session et relance le stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが最小化されています。PCで元に戻すか、セッションを終了してストリームを開始し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 최소화되어 있어요. PC에서 다시 열거나 세션을 종료하고 스트림을 다시 시작해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app está minimizado. Retome-o no PC ou encerre a sessão e inicie o stream de novo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок згорнуто. Віднови його на ПК або заверши сеанс і запусти стрім знову."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用已最小化。请在 PC 上恢复它，或退出会话后重新开始串流。"
          }
        }
      }
    },
    "conn_app_not_found": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikace %1$@ není v seznamu aplikací PC"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nicht in der App-Liste des PCs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is not in the PC's app list"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no está en la lista de apps del PC"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n’est pas dans la liste d’applis du PC"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はPCのアプリ一覧にありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) PC의 앱 목록에 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ não está na lista de apps do PC"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ немає у списку застосунків ПК"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不在 PC 的应用列表中"
          }
        }
      }
    },
    "conn_launch_failed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PC nedokázalo aplikaci spustit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der PC konnte die App nicht starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC could not start the app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PC no ha podido iniciar la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PC n’a pas pu lancer l’appli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCでアプリを開始できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC가 앱을 시작하지 못했어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PC não conseguiu iniciar o app"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК не зміг запустити застосунок"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 无法启动该应用"
          }
        }
      }
    },
    "conn_quit_failed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí relaci se nepodařilo ukončit · ukonči ji na PC"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige Sitzung konnte nicht beendet werden · beende sie am PC"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous session could not be quit · quit it on the PC"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cerrar la sesión anterior · ciérrala en el PC"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de quitter la session précédente · quitte-la sur le PC"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のセッションを終了できませんでした · PCで終了してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 세션을 종료하지 못했어요 · PC에서 종료해 주세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encerrar a sessão anterior · encerre-a no PC"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити попередній сеанс · заверши його на ПК"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法退出上一个会话 · 请在 PC 上退出"
          }
        }
      }
    },
    "conn_quit_foreign": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto relaci spustilo jiné zařízení, takže ji nelze ukončit. Ukonči stream na tom zařízení nebo na PC. (Chyba %1$d)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung wurde von einem anderen Gerät gestartet und kann deshalb nicht beendet werden. Beende den Stream auf jenem Gerät oder am PC. (Fehler %1$d)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session was started by another device, so it cannot be quit. End the stream on that device or on the PC. (Error %1$d)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión la inició otro dispositivo, así que no se puede cerrar. Termina el stream en ese dispositivo o en el PC. (Error %1$d)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session a été lancée par un autre appareil et ne peut donc pas être quittée. Arrête le stream sur cet appareil ou sur le PC. (Erreur %1$d)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは別のデバイスで開始されたため、終了できません。そのデバイスまたはPCでストリームを終了してください。（エラー %1$d）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션은 다른 기기에서 시작되어 종료할 수 없어요. 해당 기기나 PC에서 스트림을 종료해 주세요. (오류 %1$d)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão foi iniciada por outro dispositivo e, por isso, não pode ser encerrada. Encerre o stream naquele dispositivo ou no PC. (Erro %1$d)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сеанс запустив інший пристрій, тому його не можна завершити. Заверши стрім на тому пристрої або на ПК. (Помилка %1$d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话由其他设备启动，因此无法退出。请在该设备或 PC 上结束串流。（错误 %1$d）"
          }
        }
      }
    },
    "conn_resume_failed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžící relaci se nepodařilo obnovit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Sitzung konnte nicht fortgesetzt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The running session could not be resumed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido reanudar la sesión en curso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de reprendre la session en cours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のセッションを再開できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 세션을 다시 시작하지 못했어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível retomar a sessão em andamento"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити поточний сеанс"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复正在运行的会话"
          }
        }
      }
    },
    "conn_resume_foreign": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto relaci spustilo jiné zařízení, takže ji nelze obnovit. Ukonči stream na tom zařízení nebo na PC a zkus to znovu. (Chyba %1$d)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung wurde von einem anderen Gerät gestartet und kann deshalb nicht fortgesetzt werden. Beende den Stream auf jenem Gerät oder am PC und versuch es erneut. (Fehler %1$d)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session was started by another device, so it cannot be resumed. End the stream on that device or on the PC and try again. (Error %1$d)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión la inició otro dispositivo, así que no se puede reanudar. Termina el stream en ese dispositivo o en el PC e inténtalo de nuevo. (Error %1$d)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session a été lancée par un autre appareil et ne peut donc pas être reprise. Arrête le stream sur cet appareil ou sur le PC, puis réessaie. (Erreur %1$d)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは別のデバイスで開始されたため、再開できません。そのデバイスまたはPCでストリームを終了してから、もう一度お試しください。（エラー %1$d）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션은 다른 기기에서 시작되어 다시 시작할 수 없어요. 해당 기기나 PC에서 스트림을 종료한 뒤 다시 시도해 주세요. (오류 %1$d)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão foi iniciada por outro dispositivo e, por isso, não pode ser retomada. Encerre o stream naquele dispositivo ou no PC e tente de novo. (Erro %1$d)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сеанс запустив інший пристрій, тому його не можна відновити. Заверши стрім на тому пристрої або на ПК і спробуй ще раз. (Помилка %1$d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话由其他设备启动，因此无法恢复。请在该设备或 PC 上结束串流后重试。（错误 %1$d）"
          }
        }
      }
    },
    "devices_pair_new": {
