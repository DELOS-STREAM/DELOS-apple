    "settings_native_menu_buttons_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutí na Guide nebo Zpět otevře menu streamu; podržení pošle do PC Guide. Tady můžeš přidat vlastní tlačítka stisknutá společně, třeba zadní tlačítko. Výchozí je žádná."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurz Guide oder Zurück drücken öffnet das Stream-Menü; halten sendet Guide an den PC. Hier kannst du eigene, gemeinsam gedrückte Tasten hinzufügen, z. B. eine Rückseitentaste. Standardmäßig keine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tap of Guide or Back opens the stream menu; holding it sends Guide to the PC. Here you can add your own buttons pressed together, e.g. a rear button. None by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pulsación de Guide o Atrás abre el menú del stream; mantenerlo envía Guide al PC. Aquí puedes añadir tus propios botones pulsados a la vez, p. ej. un botón trasero. Ninguno por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appui sur Guide ou Retour ouvre le menu du stream ; un appui long envoie Guide au PC. Ici, tu peux ajouter tes propres boutons pressés ensemble, par ex. une palette arrière. Aucun par défaut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Guideまたは戻るを短く押すとストリームメニューが開き、長押しするとPCにGuideを送ります。ここでは、背面ボタンなど同時に押す独自のボタンを追加できます。初期設定ではなしです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide나 뒤로를 짧게 누르면 스트림 메뉴가 열리고, 길게 누르면 PC에 Guide를 보내요. 여기서 뒷면 버튼 등 함께 누를 버튼을 직접 추가할 수 있어요. 기본값은 없음이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque em Guide ou Voltar abre o menu do stream; segurar envia Guide ao PC. Aqui você pode adicionar seus próprios botões pressionados juntos, por exemplo um botão traseiro. Nenhum por padrão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коротке натискання Guide або Назад відкриває меню стріму; утримання надсилає на ПК Guide. Тут можна додати власні кнопки, натиснуті разом, наприклад задню кнопку. Типово немає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短按 Guide 或返回键打开串流菜单；长按则向电脑发送 Guide。可在此添加自定义的同时按下的按键，例如背键。默认无。"
          }
        }
      }
    },
