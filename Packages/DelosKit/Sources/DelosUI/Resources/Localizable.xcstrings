          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier le résumé de diagnostic"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "診断サマリーをコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진단 요약 복사"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar resumo do diagnóstico"
          }
        },
        "uk": {
          "stringUnit": {
