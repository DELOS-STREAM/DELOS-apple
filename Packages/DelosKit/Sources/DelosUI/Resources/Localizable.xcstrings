    "debug_vibrators_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik vibračních motorů systém hlásí. Jeden znamená, že všechny předvolby řídí stejný motor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie viele Vibratoren das System meldet. Einer heißt: Alle Presets steuern denselben Motor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many vibrators the system reports. One means every preset drives the same motor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos vibradores indica el sistema. Uno significa que todos los ajustes preestablecidos usan el mismo motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de vibreurs signalés par le système. Un seul signifie que tous les préréglages utilisent le même moteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが報告するバイブレーターの数です。1の場合、すべてのプリセットが同じモーターを動かします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 보고하는 진동기 개수예요. 1개면 모든 프리셋이 같은 모터를 구동해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quantos vibradores o sistema informa. Um significa que todas as predefinições usam o mesmo motor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скільки вібромоторів повідомляє система. Один означає, що всі пресети керують одним мотором."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统报告的震动马达数量。为 1 表示所有预设都驱动同一个马达。"
          }
        }
      }
    },
