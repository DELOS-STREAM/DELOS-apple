    "debug_panel_default": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Informace o tomto zařízení a jeho gamepadech, diagnostický záznam a test vibrací."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Infos zu diesem Gerät und seinen Controllern, das Diagnoseprotokoll und ein Vibrationstest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Information about this device and its controllers, the diagnostic log and a vibration test."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Información sobre este dispositivo y sus mandos, el registro de diagnóstico y una prueba de vibración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations sur cet appareil et ses manettes, le journal de diagnostic et un test de vibration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末とコントローラーの情報、診断ログ、振動テストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기와 컨트롤러에 대한 정보, 진단 로그, 진동 테스트를 볼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informações sobre este dispositivo e seus controles, o log de diagnóstico e um teste de vibração."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відомості про цей пристрій і його контролери, журнал діагностики та тест вібрації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本设备及其手柄的信息、诊断日志和震动测试。"
          }
        }
      }
    },
    "debug_pattern_details": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živá amplituda: %1$d / 255\nRežim: %2$@\nPřehrává se: %3$@\nVstupy jsou procenta motorů v PC, ne konečný výstup zařízení. Vyber jiný vzor, který nahradí tento, nebo použij Zastavit vibrace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Amplitude: %1$d / 255\nModus: %2$@\nLäuft: %3$@\nEingaben sind Host-Motor-Prozentwerte, keine endgültige Geräteausgabe. Wähle ein anderes Muster, um dieses zu ersetzen, oder nutze „Vibration stoppen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live amplitude: %1$d / 255\nMode: %2$@\nPlaying: %3$@\nInputs are host motor percentages, not final device output. Select another pattern to replace this one, or use Stop vibration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitud en vivo: %1$d / 255\nModo: %2$@\nReproduciendo: %3$@\nLas entradas son porcentajes de los motores del host, no la salida final del dispositivo. Elige otro patrón para sustituir este o usa Detener vibración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitude en direct : %1$d / 255\nMode : %2$@\nEn cours : %3$@\nLes entrées sont des pourcentages des moteurs du PC, pas la sortie finale de l’appareil. Sélectionne un autre motif pour remplacer celui-ci, ou utilise Arrêter la vibration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイム振幅：%1$d / 255\nモード：%2$@\n再生中：%3$@\n入力値はホストモーターの割合で、端末の最終出力ではありません。別のパターンを選ぶと置き換わります。または「振動を停止」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 진폭: %1$d / 255\n모드: %2$@\n재생 중: %3$@\n입력값은 호스트 모터 비율이며 최종 기기 출력이 아니에요. 다른 패턴을 선택하면 이 패턴을 대체하고, 진동 중지로 멈출 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitude ao vivo: %1$d / 255\nModo: %2$@\nReproduzindo: %3$@\nAs entradas são porcentagens dos motores do PC, não a saída final do dispositivo. Selecione outro padrão para substituir este ou use Parar vibração."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточна амплітуда: %1$d / 255\nРежим: %2$@\nВідтворюється: %3$@\nВхідні значення — відсотки моторів ПК, а не кінцевий вихід пристрою. Обери інший шаблон, щоб замінити цей, або натисни «Зупинити вібрацію»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时振幅：%1$d / 255\n模式：%2$@\n正在播放：%3$@\n输入值为电脑马达的百分比，而非设备最终输出。选择其他波形可替换当前波形，或点击停止震动。"
          }
        }
      }
    },
    "debug_pattern_explosion_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výbuch na plný vstup, který během dvou sekund doznívá do ticha."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Knall mit voller Eingabe, der innerhalb von zwei Sekunden zu Stille abklingt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full-input blast that decays to silence over two seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un estallido a entrada máxima que se apaga hasta el silencio en dos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un souffle à pleine entrée qui décroît jusqu’au silence en deux secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大入力の衝撃が、2秒かけて無振動まで減衰します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 입력의 폭발이 2초에 걸쳐 잦아들어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um estouro com entrada máxima que se dissipa até o silêncio em dois segundos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибух на повний сигнал, що згасає до тиші за дві секунди."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "满输入的冲击，在两秒内衰减至静默。"
          }
        }
      }
    },
