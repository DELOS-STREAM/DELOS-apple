    "stream_result_slow_details": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje síťové připojení nefunguje dobře. Sniž nastavení bitrate videa nebo zkus rychlejší připojení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Netzwerkverbindung ist zu schwach. Senke die Video-Bitrate oder nutze eine schnellere Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your network connection isn't performing well. Reduce your video bitrate setting or try a faster connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu conexión de red no rinde bien. Reduce el bitrate del vídeo en los ajustes o prueba una conexión más rápida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta connexion réseau n’est pas assez performante. Réduis le débit vidéo dans les réglages ou essaie une connexion plus rapide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク接続の状態が良くありません。ビデオビットレートの設定を下げるか、より高速な接続をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 연결 상태가 좋지 않아요. 비디오 비트레이트 설정을 낮추거나 더 빠른 연결을 사용해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conexão de rede não está com bom desempenho. Reduza a configuração de bitrate do vídeo ou tente uma conexão mais rápida."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережеве з’єднання працює погано. Зменш бітрейт відео в налаштуваннях або спробуй швидше з’єднання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的网络连接状况不佳。请降低视频码率设置，或换用更快的连接。"
          }
        }
      }
