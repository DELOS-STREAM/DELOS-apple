    "report_uploaded_tv": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam nahrán: %1$@. Přidej tento odkaz do issue na GitHubu; uchová se 30 dní."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
