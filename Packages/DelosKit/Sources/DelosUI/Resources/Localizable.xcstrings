        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「別の名前で検索」で、SteamGridDBに登録されている名前から探せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이름으로 검색하면 SteamGridDB에 등록된 이름으로 찾을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar por outro nome o encontra pelo nome que o SteamGridDB conhece."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Шукати за іншою назвою» знайде її під назвою, яку знає SteamGridDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
