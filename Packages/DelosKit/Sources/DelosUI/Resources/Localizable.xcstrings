    "conn_resume_failed": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Běžící relaci se nepodařilo obnovit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Sitzung konnte nicht fortgesetzt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The running session could not be resumed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido reanudar la sesión en curso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de reprendre la session en cours"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のセッションを再開できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 세션을 다시 시작하지 못했어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível retomar a sessão em andamento"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити поточний сеанс"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复正在运行的会话"
          }
        }
      }
    },
    "conn_resume_foreign": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto relaci spustilo jiné zařízení, takže ji nelze obnovit. Ukonči stream na tom zařízení nebo na PC a zkus to znovu. (Chyba %1$d)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung wurde von einem anderen Gerät gestartet und kann deshalb nicht fortgesetzt werden. Beende den Stream auf jenem Gerät oder am PC und versuch es erneut. (Fehler %1$d)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session was started by another device, so it cannot be resumed. End the stream on that device or on the PC and try again. (Error %1$d)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión la inició otro dispositivo, así que no se puede reanudar. Termina el stream en ese dispositivo o en el PC e inténtalo de nuevo. (Error %1$d)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session a été lancée par un autre appareil et ne peut donc pas être reprise. Arrête le stream sur cet appareil ou sur le PC, puis réessaie. (Erreur %1$d)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは別のデバイスで開始されたため、再開できません。そのデバイスまたはPCでストリームを終了してから、もう一度お試しください。（エラー %1$d）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션은 다른 기기에서 시작되어 다시 시작할 수 없어요. 해당 기기나 PC에서 스트림을 종료한 뒤 다시 시도해 주세요. (오류 %1$d)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão foi iniciada por outro dispositivo e, por isso, não pode ser retomada. Encerre o stream naquele dispositivo ou no PC e tente de novo. (Erro %1$d)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей сеанс запустив інший пристрій, тому його не можна відновити. Заверши стрім на тому пристрої або на ПК і спробуй ще раз. (Помилка %1$d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话由其他设备启动，因此无法恢复。请在该设备或 PC 上结束串流后重试。（错误 %1$d）"
          }
        }
      }
    },
    "debug_advanced_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí ruční ovládání. Úprava hodnoty označí předvolbu jako Vlastní a zastaví aktuální vzor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt manuelle Regler. Wer einen Wert ändert, markiert das Preset als Eigene und stoppt das aktuelle Muster."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show manual controls. Editing a value marks the preset as Custom and stops the current pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los controles manuales. Editar un valor marca el ajuste preestablecido como Personalizado y detiene el patrón actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les commandes manuelles. Modifier une valeur marque le préréglage comme Personnalisé et arrête le motif en cours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動の設定項目を表示します。値を編集するとプリセットがカスタムになり、現在のパターンが停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 조절을 표시해요. 값을 바꾸면 프리셋이 사용자 지정으로 바뀌고 현재 패턴이 멈춰요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra os controles manuais. Editar um valor marca a predefinição como Personalizado e interrompe o padrão atual."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показати ручні параметри. Зміна значення позначає пресет як «Власний» і зупиняє поточний шаблон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示手动控制项。修改数值会将预设标记为自定义，并停止当前波形。"
          }
        }
      }
    },
