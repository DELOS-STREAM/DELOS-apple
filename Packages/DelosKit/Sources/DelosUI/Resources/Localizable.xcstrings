    "report_upload_failed_not_saved": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam se nenahrál (%1$@) a nepodařilo se ho ani uložit. Sdílej ho v Nastavení → O aplikaci → Informace pro ladění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll wurde nicht hochgeladen (%1$@) und ließ sich auch nicht speichern. Teile es über Einstellungen → Über → Debug-Info."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log was not uploaded (%1$@) and could not be saved. Share it from Settings → About → Debug info."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se subió el registro (%1$@) y tampoco se pudo guardar. Compártelo desde Ajustes → Acerca de → Información de depuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal n’a pas été envoyé (%1$@) et n’a pas pu être enregistré. Partage-le depuis Réglages → À propos → Infos de débogage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログをアップロードできず（%1$@）、保存もできませんでした。設定 → バージョン情報 → デバッグ情報から共有してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그를 업로드하지 못했고(%1$@) 저장도 하지 못했어요. 설정 → 정보 → 디버그 정보에서 공유해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O log não foi enviado (%1$@) e também não pôde ser salvo. Compartilhe-o em Configurações → Sobre → Informações de depuração."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал не надіслано (%1$@), і його не вдалося зберегти. Поділися ним у Налаштування → Про застосунок → Налагодження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志未能上传（%1$@），也无法保存。请在 设置 > 关于 > 调试信息 中分享。"
          }
        }
      }
    },
    "report_upload_failed_saved": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Záznam se nenahrál (%1$@). Uložen do Stažených jako %2$@. Přilož ho k issue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll wurde nicht hochgeladen (%1$@). Als %2$@ in Downloads gespeichert. Hänge es an das Issue an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log was not uploaded (%1$@). Saved to Downloads as %2$@. Attach it to the issue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se subió el registro (%1$@). Guardado en Descargas como %2$@. Adjúntalo a la incidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal n’a pas été envoyé (%1$@). Enregistré dans Téléchargements sous %2$@. Joins-le au ticket."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログをアップロードできませんでした（%1$@）。ダウンロードフォルダに%2$@として保存しました。Issueに添付してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그를 업로드하지 못했어요(%1$@). 다운로드 폴더에 %2$@(으)로 저장했어요. 이슈에 첨부해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O log não foi enviado (%1$@). Salvo em Downloads como %2$@. Anexe-o ao relato."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал не надіслано (%1$@). Збережено в Завантаження як %2$@. Додай його до звернення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志未能上传（%1$@）。已以 %2$@ 为文件名保存到“下载”文件夹，请将其附在问题反馈中。"
          }
        }
      }
    },
