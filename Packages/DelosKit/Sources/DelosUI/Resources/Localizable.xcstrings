        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このPCのVibepolloは回線テストに対応していません。アップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 PC의 Vibepollo는 연결 테스트를 지원하지 않아요. 업데이트해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Vibepollo deste PC não consegue testar o link. Atualize-o."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibepollo на цьому ПК не вміє перевіряти канал. Онови його."
          }
        },
        "zh-Hans": {
