          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log uploaded: %1$@. Add this link to a GitHub issue; it is kept for 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro subido: %1$@. Añade este enlace a una incidencia de GitHub; se guarda 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Journal envoyé : %1$@. Ajoute ce lien à un ticket GitHub ; il est conservé 30 jours."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログをアップロードしました：%1$@。このリンクをGitHubのIssueに追加してください。30日間保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그를 업로드했어요: %1$@. 이 링크를 GitHub 이슈에 추가해 주세요. 30일간 보관돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Log enviado: %1$@. Adicione este link a um relato no GitHub; ele fica guardado por 30 dias."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Журнал надіслано: %1$@. Додай це посилання до звернення на GitHub; воно зберігається 30 днів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志已上传：%1$@。请把此链接添加到 GitHub 问题反馈中，保存 30 天。"
          }
        }
      }
