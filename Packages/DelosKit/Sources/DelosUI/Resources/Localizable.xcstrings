    "help_list_sgsr_quality_sharpen": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez zvětšení; zostřuje ve velikosti streamu. Stojí málo GPU."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Skalierung; schärft in Stream-Größe. Kostet wenig GPU."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No scaling; sharpens at stream size. Costs little GPU."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin escalado; nitidez al tamaño del stream. Consume poca GPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de mise à l’échelle ; accentue à la taille du stream. Coûte peu de GPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡大はせず、ストリームのサイズでシャープ化します。GPU負荷は小さいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크기를 바꾸지 않고 스트림 크기에서 선명하게만 해요. GPU를 거의 쓰지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem escala; aumenta a nitidez no tamanho do stream. Custa pouca GPU."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без масштабування; підвищує різкість у розмірі стріму. Мало навантажує GPU."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不缩放；在串流分辨率下锐化。GPU 开销很小。"
          }
        }
      }
    },
    "help_list_sgsr_supersampling_level": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vnitřní velikost, když stream už odpovídá displeji. Změny z menu platí jednu relaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Interne Größe, wenn der Stream bereits zum Display passt. Änderungen im Menü gelten eine Sitzung lang."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internal size when the stream already matches the display. Menu changes last one session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamaño interno cuando el stream ya coincide con la pantalla. Los cambios desde el menú duran una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taille interne quand le stream correspond déjà à l’écran. Les changements du menu durent une session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームがすでにディスプレイと同じ解像度のときの内部サイズです。メニューでの変更は1セッションのみ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림이 이미 디스플레이와 같은 크기일 때의 내부 크기예요. 메뉴에서 바꾼 내용은 한 세션 동안만 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamanho interno quando o stream já tem a resolução da tela. Mudanças pelo menu valem por uma sessão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Внутрішній розмір, коли стрім уже збігається з екраном. Зміни з меню діють одну сесію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "串流分辨率已与屏幕一致时使用的内部渲染尺寸。在菜单中的更改仅在本次会话内有效。"
          }
        }
      }
    },
