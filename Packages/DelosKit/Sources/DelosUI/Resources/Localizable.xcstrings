    "link_failure_denied": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PC test nepovolilo. Spáruj toto zařízení znovu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der PC hat den Test nicht erlaubt. Koppel dieses Gerät erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC did not allow the test. Pair this device again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PC no ha permitido la prueba. Vuelve a emparejar este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PC n’a pas autorisé le test. Associe à nouveau cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCがテストを許可しませんでした。この端末をもう一度ペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC가 테스트를 허용하지 않았어요. 이 기기를 다시 페어링해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PC não permitiu o teste. Pareie este dispositivo novamente."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК не дозволив перевірку. Створи пару з цим пристроєм ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 不允许进行测试。请重新配对此设备。"
          }
        }
      }
    },
