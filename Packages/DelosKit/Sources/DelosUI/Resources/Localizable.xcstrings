    "debug_pads_continuous_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý gamepad, který umí vibrovat, vibruje dál silou nastavenou výše."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Controller, der vibrieren kann, vibriert weiter mit der oben gewählten Stärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every controller that can vibrate keeps vibrating at the strength above."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los mandos que pueden vibrar siguen vibrando con la intensidad de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque manette qui peut vibrer continue de vibrer à l’intensité ci-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振動できるすべてのコントローラーが、上の強さで振動し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진동할 수 있는 모든 컨트롤러가 위의 세기로 계속 진동해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo controle que pode vibrar continua vibrando na intensidade acima."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен контролер, що вміє вібрувати, вібрує із силою вище."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有支持震动的手柄都会按上方强度持续震动。"
          }
        }
      }
    },
