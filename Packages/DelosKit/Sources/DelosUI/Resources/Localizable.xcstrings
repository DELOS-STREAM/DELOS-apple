        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム情報を更新できませんでした。メタデータを開いて更新するか、一致するゲームを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 정보를 업데이트하지 못했어요. 메타데이터에서 새로고침하거나 일치 항목을 선택해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar as informações do jogo. Abra Metadados para atualizar ou escolher uma correspondência."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося оновити інформацію про гру. Відкрий «Метадані», щоб оновити або обрати збіг."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新游戏信息。请打开元数据以刷新或选择匹配项。"
          }
        }
      }
    },
