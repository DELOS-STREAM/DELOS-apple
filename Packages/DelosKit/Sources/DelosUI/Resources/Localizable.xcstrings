    "debug_curve_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponent odezvy: pod %1$d%% zesiluje slabé vibrace; nad %1$d%% je zjemňuje."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwortexponent: unter %1$d%% verstärkt schwache Vibration, über %1$d%% dämpft sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Response exponent: below %1$d%% boosts weak rumble; above %1$d%% softens it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exponente de respuesta: por debajo del %1$d%% refuerza la vibración débil; por encima del %1$d%% la suaviza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposant de réponse : sous %1$d %%, il renforce les vibrations faibles ; au-dessus de %1$d %%, il les adoucit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答の指数です。%1$d%%未満だと弱い振動が強まり、%1$d%%を超えると和らぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답 지수: %1$d%% 미만이면 약한 럼블이 강해지고, %1$d%%를 넘으면 부드러워져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expoente de resposta: abaixo de %1$d%% reforça a vibração fraca; acima de %1$d%% a suaviza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показник відгуку: нижче %1$d%% підсилює слабку вібрацію; вище %1$d%% пом’якшує її."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应指数：低于 %1$d%% 会增强微弱震动；高于 %1$d%% 会减弱震动。"
          }
        }
      }
    },
