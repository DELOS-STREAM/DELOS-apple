    "shell_link_pair_message": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odkaz žádá aplikaci Delos o spárování s tímto PC. Pokračuj jen v případě, že tento odkaz pochází od tebe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Link fordert Delos auf, mit diesem PC zu koppeln. Fahr nur fort, wenn du ihn selbst geöffnet hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A link asks Delos to pair with this PC. Continue only if you opened it yourself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enlace pide a Delos que se empareje con este PC. Continúa solo si lo has abierto tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien demande à Delos de s’associer à ce PC. Continue seulement si tu l’as ouvert toi-même."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクにより、DelosがPCとペアリングするよう求められています。ご自身で開いた場合のみ続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 Delos에 이 PC와 페어링하도록 요청하고 있어요. 직접 연 링크일 때만 계속해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link pede ao app Delos para parear com este PC. Continue só se você mesmo o abriu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання просить Delos створити пару з цим ПК. Продовжуй, лише якщо відкрив його сам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有链接请求 Delos 与此 PC 配对。仅在你自己打开该链接时才继续。"
          }
        }
      }
    },
