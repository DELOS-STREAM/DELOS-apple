    "help_import_special_button_file": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuje vlastní kombinace kláves pro nabídku „Odeslat klávesy“ a ovládací prvky speciálních kláves a nahradí vlastní příkazy tohoto profilu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiert eigene Tastenkombinationen für „Tasten senden“ und die Sondertasten-Steuerung und ersetzt die eigenen Befehle dieses Profils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imports custom key combinations for Send keys and the special-key controls, replacing this profile's custom commands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa combinaciones de teclas personalizadas para Enviar teclas y los controles de teclas especiales, sustituyendo los comandos personalizados de este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe des combinaisons de touches personnalisées pour Envoyer des touches et les commandes de touches spéciales, en remplaçant les commandes perso de ce profil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「キーを送信」と特殊キーコントロール用のカスタムキーの組み合わせをインポートし、このプロフィールのカスタムコマンドを置き換えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키 보내기와 특수 키 컨트롤에서 사용할 사용자 지정 키 조합을 가져와 이 프로필의 사용자 지정 명령을 대체해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa combinações de teclas personalizadas para Enviar teclas e para os controles de teclas especiais, substituindo os comandos personalizados deste perfil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортує власні комбінації клавіш для «Надіслати клавіші» й елементів спеціальних клавіш, замінюючи власні команди цього профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入自定义组合键，用于发送按键和特殊按键控件，并替换此个人资料的自定义命令。"
          }
        }
      }
    },
    "help_list_audio_config": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanály, které PC posílá. Prostorový zvuk vyžaduje odpovídající přehrávání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle, die der PC sendet. Surround erfordert passende Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channels the PC sends. Surround needs matching playback."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canales que envía el PC. El sonido envolvente requiere una reproducción compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canaux envoyés par le PC. Le surround nécessite une lecture compatible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCが送信するチャンネル数です。サラウンドには、対応した再生環境が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC가 보내는 채널이에요. 서라운드는 그에 맞는 재생 환경이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Canais enviados pelo PC. Surround requer reprodução compatível."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Канали, які надсилає ПК. Для об’ємного звуку потрібне відповідне відтворення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 发送的声道。环绕声需要匹配的播放设备。"
          }
        }
      }
    },
    "help_list_audio_config_2": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dva kanály pro reproduktory handheldu a většinu sluchátek."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei Kanäle für Handheld-Lautsprecher und die meisten Kopfhörer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two channels for handheld speakers and most headphones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos canales para los altavoces de la consola portátil y la mayoría de auriculares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux canaux pour les haut-parleurs de console portable et la plupart des casques."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯機のスピーカーとほとんどのヘッドホン向けの、2チャンネルです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
