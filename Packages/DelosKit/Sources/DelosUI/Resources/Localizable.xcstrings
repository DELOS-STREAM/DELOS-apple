    "debug_pattern_test_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Krátké klepnutí, sekunda stálých vibrací, narůstající rampa a doznívající exploze."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein kurzer Tipp, eine Sekunde gleichmäßiges Rumpeln, eine ansteigende Rampe und eine abklingende Explosion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A short tap, one second of steady rumble, a rising ramp and a decaying explosion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque corto, un segundo de vibración constante, una rampa ascendente y una explosión que se apaga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une courte tape, une seconde de vibration constante, une montée progressive et une explosion décroissante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短いタップ、1秒間の一定の振動、徐々に強まる振動、減衰する爆発です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 탭, 1초 동안의 일정한 럼블, 점점 커지는 램프, 잦아드는 폭발이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque curto, um segundo de vibração constante, uma rampa crescente e uma explosão que se dissipa."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий поштовх, секунда рівної вібрації, наростання та згасальний вибух."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次短促轻敲、一秒稳定震动、一段渐强上升和一次逐渐衰减的爆炸。"
          }
        }
      }
    },
