    "devices_start_choose_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyber PC, na kterém chceš hrát."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle den PC, auf dem du spielen willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the PC to play on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el PC en el que jugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis le PC sur lequel jouer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレイするPCを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이할 PC를 선택해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o PC para jogar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обери ПК, на якому гратимеш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要游玩的 PC。"
          }
        }
      }
    },
