    "settings_native_hero_opacity_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak silně grafika aplikace prosvítá skrz animované pozadí. Vyžaduje volbu „Pozadí aplikace“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stark das App-Artwork durch den animierten Hintergrund scheint. Erfordert App-Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How strongly the app artwork shows through the animated background. Needs App background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto se ve la ilustración de la app a través del fondo animado. Requiere Fondo de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Force avec laquelle le visuel de l’appli transparaît à travers l’arrière-plan animé. Nécessite Arrière-plan de l’appli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーション背景越しに、アプリのアートワークをどれだけ見せるかを指定します。「アプリ背景」が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직이는 배경 위로 앱 아트워크가 얼마나 비칠지 정해요. 앱 배경이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto da arte do app aparece através do fundo animado. Requer Fundo do app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наскільки ілюстрація застосунку проступає крізь анімоване тло. Потрібне Тло застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用图片透过动态背景显示的程度。需要启用应用背景。"
          }
        }
      }
