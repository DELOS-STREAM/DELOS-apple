    "debug_continuous_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibruje silou nastavenou níže, dokud je nevypneš nebo neopustíš tuto obrazovku."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibriert mit der unten gewählten Stärke weiter, bis du sie ausschaltest oder diesen Bildschirm verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps vibrating at the strength below until it is turned off or you leave this screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue vibrando con la intensidad de abajo hasta que lo desactives o salgas de esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue de vibrer à l’intensité ci-dessous jusqu’à l’arrêt ou jusqu’à ce que tu quittes cet écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにするか、この画面を離れるまで、下の強さで振動し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄거나 이 화면을 나갈 때까지 아래 세기로 계속 진동해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua vibrando na intensidade abaixo até ser desativada ou você sair desta tela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вібрує з силою нижче, доки її не вимкнено або ти не залишиш цей екран."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按下方强度持续震动，直到关闭或离开此界面。"
          }
        }
      }
    },
