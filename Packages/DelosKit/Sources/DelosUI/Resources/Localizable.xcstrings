    "artwork_builtin_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vestavěné obrázky – obrázky této aplikace nejde změnit"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integriertes Artwork - das Artwork dieser App lässt sich nicht ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built-in artwork - this app's artwork cannot be changed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración integrada: no se puede cambiar la de esta app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visuels intégrés - les visuels de cette appli ne peuvent pas être changés"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵アートワーク - このアプリのアートワークは変更できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공 아트워크 - 이 앱의 아트워크는 바꿀 수 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arte integrada - a arte deste app não pode ser alterada"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудовані ілюстрації: ілюстрації цього застосунку змінити не можна"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置图片素材：此应用的图片素材无法更改"
          }
        }
      }
    },
