    "settings_native_hero_blur_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozostří pozadí aplikace za knihovnou. Vyžaduje volbu „Pozadí aplikace“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwischt den App-Hintergrund hinter der Bibliothek. Erfordert App-Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blurs the app background behind the library. Needs App background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenfoca el fondo de la app tras la biblioteca. Requiere Fondo de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Floute l’arrière-plan de l’appli derrière la bibliothèque. Nécessite Arrière-plan de l’appli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの後ろのアプリ背景をぼかします。「アプリ背景」が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리 뒤의 앱 배경을 흐리게 해요. 앱 배경이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfoca o fundo do app atrás da biblioteca. Requer Fundo do app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмиває тло застосунку за бібліотекою. Потрібне Тло застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊应用库后方的应用背景。需要启用应用背景。"
          }
        }
      }
    },
