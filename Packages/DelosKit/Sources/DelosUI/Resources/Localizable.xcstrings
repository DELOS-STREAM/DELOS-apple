    "stream_help_apply_bitrate": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošle požadovaný bitrate do Vibepollo. Přijatá hodnota může být nižší. Uložené výchozí hodnoty se nemění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet die gewünschte Bitrate an Vibepollo. Der akzeptierte Wert kann niedriger sein. Gespeicherte Standardwerte bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the requested bitrate to Vibepollo. The accepted value can be lower. Saved defaults are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía a Vibepollo el bitrate solicitado. El valor aceptado puede ser menor. Los valores predeterminados guardados no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie le débit demandé à Vibepollo. La valeur acceptée peut être plus basse. Les valeurs par défaut enregistrées ne changent pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要求したビットレートをVibepolloに送信します。受け入れられる値は、より低い場合があります。保存済みの既定値は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청한 비트레이트를 Vibepollo로 보내요. 적용되는 값은 더 낮을 수 있어요. 저장된 기본값은 바뀌지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia o bitrate solicitado ao Vibepollo. O valor aceito pode ser menor. Os padrões salvos não mudam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає запитаний бітрейт у Vibepollo. Прийняте значення може бути нижчим. Збережені типові значення не змінюються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将请求的码率发送给 Vibepollo。实际接受的值可能更低。已保存的默认值不变。"
          }
        }
      }
    },
    "stream_help_bitrate": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá o nový bitrate videa bez opětovného připojení. Vyžaduje Vibepollo; PC ho může omezit. Platí pro tento stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert eine neue Video-Bitrate ohne erneutes Verbinden an. Erfordert Vibepollo; der Host kann sie begrenzen. Gilt für diesen Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests a new video bitrate without reconnecting. Needs Vibepollo; the host may cap it. Lasts for this stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita un nuevo bitrate de vídeo sin reconectar. Requiere Vibepollo; el host puede limitarlo. Dura lo que dure este stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande un nouveau débit vidéo sans se reconnecter. Nécessite Vibepollo ; le PC peut le plafonner. Dure le temps de ce stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再接続せずに、新しいビデオビットレートを要求します。Vibepolloが必要で、ホスト側で上限が設けられる場合があります。このストリームの間だけ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 연결하지 않고 새 비디오 비트레이트를 요청해요. Vibepollo가 필요하며 호스트가 상한을 둘 수 있어요. 이번 스트림 동안 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita um novo bitrate de vídeo sem reconectar. Requer Vibepollo; o PC pode limitar. Vale neste stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує новий бітрейт відео без перепідключення. Потрібен Vibepollo; хост може обмежити. Діє для цього стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需重新连接即可请求新的视频码率。需要 Vibepollo；电脑端可能限制上限。仅对本次串流有效。"
          }
        }
      }
    },
    "stream_help_brightness": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upraví jas tohoto zařízení pro tento stream; systémové nastavení se poté vrátí."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt die Helligkeit dieses Geräts für diesen Stream an; danach gilt wieder die Systemeinstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts this device's brightness for this stream; the system setting returns afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el brillo de este dispositivo para este stream; después vuelve el ajuste del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste la luminosité de cet appareil pour ce stream ; le réglage système revient ensuite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このストリームの間、この端末の明るさを調整します。終了後はシステム設定に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 스트림 동안 이 기기의 밝기를 조절해요. 끝나면 시스템 설정으로 돌아가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o brilho deste dispositivo neste stream; a configuração do sistema volta depois."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює яскравість цього пристрою для цього стріму; потім повертається системне значення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调节本设备在本次串流中的亮度；之后会恢复系统设置。"
          }
        }
      }
    },
    "stream_help_commands": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypíše příkazy serveru nastavené ve Vibepollo nebo Apollo. Co který udělá, určuje PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Listet Serverbefehle, die in Vibepollo oder Apollo eingerichtet sind. Der Host entscheidet, was jeder tut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists server commands configured in Vibepollo or Apollo. The host decides what each does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los comandos del servidor configurados en Vibepollo o Apollo. El host decide qué hace cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste les commandes du serveur configurées dans Vibepollo ou Apollo. Le PC décide de ce que fait chacune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "VibepolloまたはApolloで設定されたサーバーコマンドを一覧表示します。それぞれの動作はホストが決めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibepollo 또는 Apollo에 설정된 서버 명령을 보여 줘요. 각 명령이 하는 일은 호스트가 정해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista os comandos do servidor configurados no Vibepollo ou Apollo. O PC decide o que cada um faz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує серверні команди, налаштовані у Vibepollo або Apollo. Що робить кожна, вирішує хост."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出在 Vibepollo 或 Apollo 中配置的服务器命令。每条命令的作用由电脑端决定。"
          }
        }
      }
    },
    "stream_help_delos_keyboard": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře nebo zavře klávesnici na obrazovce aplikace Delos: D-pad se pohybuje, %1$@ píše, %2$@ zavírá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet oder schließt die Delos-Bildschirmtastatur: Steuerkreuz bewegt, %1$@ tippt, %2$@ schließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens or closes the Delos on-screen keyboard: D-pad moves, %1$@ types, %2$@ closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o cierra el teclado en pantalla de Delos: la cruceta mueve, %1$@ escribe, %2$@ cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre ou ferme le clavier à l’écran de Delos : la croix directionnelle déplace, %1$@ saisit, %2$@ ferme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Delosの画面キーボードを開閉します：十字キーで移動、%1$@で入力、%2$@で閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos 화면 키보드를 열거나 닫아요. 방향 패드로 이동, %1$@로 입력, %2$@로 닫기예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ou fecha o teclado na tela do Delos: o direcional move, %1$@ digita, %2$@ fecha."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває або закриває екранну клавіатуру Delos: хрестовина рухає, %1$@ вводить, %2$@ закриває."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或关闭 Delos 屏幕键盘：方向键移动，%1$@ 输入，%2$@ 关闭。"
          }
        }
      }
    },
    "stream_help_delos_keyboard_system": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře nebo zavře klávesnici na obrazovce aplikace Delos: D-pad se pohybuje, %1$@ píše, %2$@ zavírá. Ne systémovou klávesnici (Více)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet oder schließt die Delos-Bildschirmtastatur: Steuerkreuz bewegt, %1$@ tippt, %2$@ schließt. Nicht die Systemtastatur (Mehr)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens or closes the Delos on-screen keyboard: D-pad moves, %1$@ types, %2$@ closes. Not the system keyboard (More)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o cierra el teclado en pantalla de Delos: la cruceta mueve, %1$@ escribe, %2$@ cierra. No es el teclado del sistema (Más)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre ou ferme le clavier à l’écran de Delos : la croix directionnelle déplace, %1$@ saisit, %2$@ ferme. Pas le clavier système (Plus)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Delosの画面キーボードを開閉します：十字キーで移動、%1$@で入力、%2$@で閉じます。システムキーボードではありません（その他）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos 화면 키보드를 열거나 닫아요. 방향 패드로 이동, %1$@로 입력, %2$@로 닫기예요. 시스템 키보드(더보기)와는 달라요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ou fecha o teclado na tela do Delos: o direcional move, %1$@ digita, %2$@ fecha. Não é o teclado do sistema (Mais)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває або закриває екранну клавіатуру Delos: хрестовина рухає, %1$@ вводить, %2$@ закриває. Не системна клавіатура (Ще)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或关闭 Delos 屏幕键盘：方向键移动，%1$@ 输入，%2$@ 关闭。不是系统键盘（更多）。"
          }
        }
      }
    },
    "stream_help_disconnect": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastaví streamování a vrátí se do knihovny aplikace Delos. Aplikace na PC dál běží."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet das Streamen und kehrt zur Delos-Bibliothek zurück. Die App läuft auf dem PC weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops streaming and returns to the Delos library. The app keeps running on the PC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene el streaming y vuelve a la biblioteca de Delos. La app sigue ejecutándose en el PC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête le streaming et revient à la bibliothèque Delos. L’appli continue sur le PC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングを停止して、Delosのライブラリに戻ります。アプリはPCで実行されたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍을 중단하고 Delos 라이브러리로 돌아가요. 앱은 PC에서 계속 실행돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para a transmissão e volta à biblioteca do Delos. O app continua rodando no PC."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиняє стрім і повертає до бібліотеки Delos. Застосунок продовжує працювати на ПК."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止串流并返回 Delos 应用库。应用会继续在 PC 上运行。"
          }
        }
      }
    },
    "stream_help_format_command": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hned spustí v PC příkaz %1$@ definovaný v PC. Nastavuje se ve Vibepollo nebo Apollo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt den vom Host definierten Befehl %1$@ sofort auf dem PC aus. Eingerichtet in Vibepollo oder Apollo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs the host-defined command %1$@ on the PC at once. Set in Vibepollo or Apollo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta al instante en el PC el comando %1$@ definido por el host. Se configura en Vibepollo o Apollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute aussitôt sur le PC la commande %1$@ définie par le PC. À configurer dans Vibepollo ou Apollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストで定義されたコマンド%1$@を、PCですぐに実行します。VibepolloまたはApolloで設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에 정의된 명령 %1$@을(를) PC에서 바로 실행해요. Vibepollo 또는 Apollo에서 설정해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa na hora no PC o comando %1$@ definido pelo PC. Configurado no Vibepollo ou Apollo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу виконує на ПК команду хоста %1$@. Задається у Vibepollo або Apollo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即在 PC 上运行电脑端定义的命令 %1$@。在 Vibepollo 或 Apollo 中设置。"
          }
        }
      }
    },
    "stream_help_format_keys": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou pošle do PC %1$@ a vrátí se do streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet %1$@ einmalig an den PC und kehrt dann zum Stream zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends %1$@ to the PC once, then returns to the stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía %1$@ al PC una vez y vuelve al stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie %1$@ une fois au PC, puis revient au stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@をPCに1回送信してから、ストリームに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@을(를) PC로 한 번 보낸 뒤 스트림으로 돌아가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia %1$@ ao PC uma vez e volta ao stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз надсилає %1$@ на ПК, потім повертає до стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 PC 发送一次 %1$@，然后返回串流。"
          }
        }
      }
    },
    "stream_help_get_clipboard": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou stáhne schránku z PC do tohoto zařízení. Vyžaduje podporu schránky ve Vibepollo nebo Apollo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt einmalig die Zwischenablage des PCs auf dieses Gerät. Erfordert Zwischenablage-Unterstützung von Vibepollo oder Apollo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches the PC clipboard to this device once. Needs Vibepollo or Apollo clipboard support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trae una vez el portapapeles del PC a este dispositivo. Requiere compatibilidad de portapapeles de Vibepollo o Apollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère une fois le presse-papiers du PC sur cet appareil. Nécessite la prise en charge du presse-papiers par Vibepollo ou Apollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCのクリップボードを、この端末に1回取得します。VibepolloまたはApolloのクリップボード対応が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC 클립보드를 이 기기로 한 번 가져와요. Vibepollo 또는 Apollo의 클립보드 지원이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca uma vez a área de transferência do PC para este dispositivo. Requer suporte do Vibepollo ou Apollo à área de transferência."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз забирає буфер обміну ПК на цей пристрій. Потрібна підтримка буфера обміну у Vibepollo або Apollo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 PC 剪贴板获取到本设备一次。需要 Vibepollo 或 Apollo 的剪贴板支持。"
          }
        }
      }
    },
    "stream_help_gyro_smoothing": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hned stabilizuje míření gyrem a uloží se pro tuto aplikaci. 0 je vypnuto. Víc vyhlazení lehce zpozdí pomalý pohyb."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhigt das Gyro-Zielen sofort, für diese App gemerkt. 0 ist aus. Mehr Glättung bringt eine kleine Verzögerung bei langsamer Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steadies gyro aiming at once, kept for this app. 0 is off. More smoothing adds a little delay to slow movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabiliza al instante la puntería con giroscopio y se conserva para esta app. 0 es desactivado. Más suavizado añade un poco de retardo al moverse despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilise aussitôt la visée au gyroscope, conservé pour cette appli. 0 = désactivé. Plus de lissage ajoute un léger retard aux mouvements lents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャイロ照準をすぐに安定させ、このアプリに保存します。0でオフ。スムージングを強めると、ゆっくりした動きにわずかな遅れが出ます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자이로 조준을 바로 안정시키고 이 앱에 저장해요. 0은 꺼짐이에요. 스무딩이 강할수록 느린 움직임에 약간의 지연이 생겨요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabiliza na hora a mira com giroscópio, mantido neste app. 0 é desativado. Mais suavização adiciona um pouco de atraso em movimentos lentos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу стабілізує прицілювання гіроскопом, зберігається для цього застосунку. 0 — вимкнено. Більше згладжування додає трохи затримки повільним рухам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即稳定陀螺仪瞄准，并为此应用保留。0 表示关闭。平滑越强，缓慢移动的延迟越多。"
          }
        }
      }
    },
    "stream_help_gyro_smoothing_disabled": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyžaduje zapnutou volbu „Gyroskop externího gamepadu“ nebo „Vestavěný gyroskop zařízení“ v Nastavení; platí od příštího streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert, dass „Gyroskop des externen Gamepads“ oder „Eingebautes Gyroskop des Geräts“ in den Einstellungen aktiviert ist; gilt ab dem nächsten Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs External gamepad gyroscope or Built-in device gyroscope turned on in Settings; applies from the next stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere activar Giroscopio del mando externo o Giroscopio integrado del dispositivo en Ajustes; se aplica desde el próximo stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite d’activer Gyroscope de manette externe ou Gyroscope intégré de l’appareil dans les Réglages ; s’applique dès le prochain stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で「外部コントローラーのジャイロ」または「端末内蔵のジャイロ」をオンにする必要があります。次回のストリームから適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 외장 게임패드 자이로스코프 또는 기기 내장 자이로스코프를 켜야 해요. 다음 스트림부터 적용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Requer Giroscópio do controle externo ou Giroscópio integrado do dispositivo ativado em Configurações; vale a partir do próximo stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно ввімкнути «Гіроскоп зовнішнього контролера» або «Вбудований гіроскоп пристрою» в налаштуваннях; діє з наступного стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在设置中开启外接手柄陀螺仪或内置设备陀螺仪；从下次串流起生效。"
          }
        }
      }
    },
    "stream_help_local_cursor_device": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Během tohoto streamu zobrazí nebo skryje ukazatel tohoto zařízení pro fyzickou myš. Ne kurzor PC ve videu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt oder verbirgt den Zeiger dieses Geräts für eine echte Maus während dieses Streams. Nicht der PC-Cursor im Video."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows or hides this device's pointer for a physical mouse during this stream. Not the PC cursor in the video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta el puntero de este dispositivo para un ratón físico durante esta transmisión. No es el cursor del PC en el vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque le pointeur de cet appareil pour une souris physique pendant ce stream. Pas le curseur du PC dans la vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このストリーム中、物理マウス用にこの端末のポインターを表示または非表示にします。映像内のPCカーソルではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스트림 동안 실제 마우스용 이 기기의 포인터를 보이거나 숨겨요. 영상 속 PC 커서가 아니에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ou oculta o ponteiro deste dispositivo para um mouse físico durante este stream. Não é o cursor do PC no vídeo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує або ховає вказівник цього пристрою для фізичної миші під час цієї трансляції. Не курсор ПК у відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此次串流期间显示或隐藏本设备用于实体鼠标的指针。不是视频中的 PC 光标。"
          }
        }
      }
    },
    "stream_help_mode": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeví se hned. Přepnutí na Jen zostření nebo z něj může způsobit blikání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt live. Das Umschalten von oder zu „Nur schärfen“ kann flackern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies live. Switching to or from Sharpen only may flicker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica en directo. Cambiar a Solo nitidez o desde ella puede parpadear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique en direct. Passer à Netteté seule ou la quitter peut faire clignoter l’image."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアルタイムに適用されます。「シャープのみ」との切り替え時に、ちらつくことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간으로 적용돼요. 선명화만으로 또는 선명화만에서 전환할 때 깜빡일 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale na hora. Mudar de ou para Só nitidez pode piscar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосовується наживо. Перемикання на режим «Лише різкість» або з нього може мигнути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时生效。切换到或离开仅锐化模式时可能闪烁。"
          }
        }
      }
    },
    "stream_help_more": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Další ovládání streamu: schránka, příkazy PC, kombinace kláves, přiblížení, dotyk a ovládání na obrazovce. Akce se provedou hned."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Stream-Steuerung: Zwischenablage, Host-Befehle, Tastenkombinationen, Zoom, Touch und Bildschirmsteuerung. Aktionen laufen sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More stream controls: clipboard, host commands, key combinations, zoom, touch and on-screen controls. Actions run at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más controles del stream: portapapeles, comandos del host, combinaciones de teclas, zoom, táctil y controles en pantalla. Las acciones se ejecutan al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autres commandes du stream : presse-papiers, commandes du PC, combinaisons de touches, zoom, tactile et commandes à l’écran. Les actions s’exécutent aussitôt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームのその他の操作：クリップボード、ホストコマンド、キーの組み合わせ、ズーム、タッチ、画面上のコントロール。操作はすぐに実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 많은 스트림 컨트롤: 클립보드, 호스트 명령, 키 조합, 확대, 터치, 화면 컨트롤. 동작은 바로 실행돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais controles do stream: área de transferência, comandos do PC, combinações de teclas, zoom, toque e controles na tela. As ações rodam na hora."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Більше елементів керування стрімом: буфер обміну, команди хоста, комбінації клавіш, масштаб, сенсор і екранні елементи керування. Дії виконуються одразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多串流控制：剪贴板、电脑端命令、组合键、缩放、触摸和屏幕按键。操作会立即执行。"
          }
        }
      }
    },
    "stream_help_mouse_mode": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybere, jak dotyk ovládá PC: přímý dotyk, trackpad, nebo vypnuto. Jestli se uloží, rozhoduje volba „Pamatovat si režim myši“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt, wie Touch den PC steuert: direktes Touch, Trackpad oder aus. „Mausmodus merken“ entscheidet, ob es bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chooses how touch controls the PC: direct touch, trackpad or off. Remember mouse mode decides whether it persists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo controla el táctil el PC: toque directo, trackpad o desactivado. Recordar el modo de ratón decide si se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit comment le toucher contrôle le PC : toucher direct, trackpad ou désactivé. Mémoriser le mode souris décide si ce choix persiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチでPCを操作する方法を選びます：直接タッチ、トラックパッド、またはオフ。保存されるかどうかは「マウスモードを記憶」で決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치로 PC를 조작하는 방식을 고르세요: 직접 터치, 트랙패드, 끄기. 유지 여부는 마우스 모드 기억이 정해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe como o toque controla o PC: toque direto, trackpad ou desativado. Lembrar modo do mouse define se persiste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирає, як дотики керують ПК: прямий дотик, трекпад або вимкнено. Чи зберігається, вирішує «Пам’ятати режим миші»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择触摸如何控制 PC：直接触摸、触控板或关闭。是否保留由记住鼠标模式决定。"
          }
        }
      }
    },
    "stream_help_on_screen_controls": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazí nebo skryje virtuální gamepad během tohoto streamu. Neprůhlednost a rozložení se nastavují na záložce Ovládání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt oder verbirgt das virtuelle Gamepad in diesem Stream. Deckkraft und Layout stellst du unter Steuerung ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows or hides the virtual gamepad during this stream. Opacity and layout are set under Controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta el mando virtual durante este stream. La opacidad y la distribución se ajustan en Controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque la manette virtuelle pendant ce stream. L’opacité et la disposition se règlent dans Commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このストリームの間、仮想コントローラーを表示または非表示にします。不透明度とレイアウトは「操作」で設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 스트림 동안 가상 게임패드를 표시하거나 숨겨요. 투명도와 레이아웃은 컨트롤에서 설정해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra ou oculta o controle virtual durante este stream. Opacidade e layout são definidos em Controles."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує або ховає віртуальний контролер під час цього стріму. Прозорість і розкладка задаються в розділі «Керування»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在本次串流中显示或隐藏虚拟手柄。不透明度和布局在控制中设置。"
          }
        }
      }
    },
    "stream_help_on_screen_controls_opacity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprůhlednost ovládání na obrazovce. Platí hned a uloží se do profilu, stejná hodnota jako v Nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckkraft der Bildschirmsteuerung. Gilt sofort und wird im Profil gespeichert, derselbe Wert wie in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacity of the on-screen controls. Applies at once and is saved in the profile, the same value as in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacidad de los controles en pantalla. Se aplica al instante y se guarda en el perfil, el mismo valor que en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacité des commandes à l’écran. S’applique aussitôt et est enregistrée dans le profil, la même valeur que dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のコントロールの不透明度です。すぐに反映され、プロフィールに保存されます。設定と同じ値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 컨트롤의 투명도예요. 바로 적용되고 프로필에 저장돼요. 설정과 같은 값이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacidade dos controles na tela. Vale na hora e fica salva no perfil, o mesmo valor que em Configurações."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрозорість екранних елементів керування. Діє одразу й зберігається в профілі, те саме значення, що в налаштуваннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕按键的不透明度。立即生效并保存到个人资料中，与设置中的数值相同。"
          }
        }
      }
    },
    "stream_help_open_system_keyboard": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zavření tohoto menu otevře nebo zavře systémovou klávesnici. Ne klávesnici aplikace Delos (dlaždice Klávesnice)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet oder schließt die Systemtastatur, nachdem dieses Menü geschlossen wurde. Nicht die Delos-Tastatur (die Kachel Tastatur)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens or closes the system keyboard, after closing this menu. Not the Delos keyboard (the Keyboard tile)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o cierra el teclado del sistema, tras cerrar este menú. No es el teclado de Delos (el mosaico Teclado)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre ou ferme le clavier système, après fermeture de ce menu. Pas le clavier Delos (la tuile Clavier)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメニューを閉じた後に、システムキーボードを開閉します。Delosのキーボード（キーボードタイル）ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메뉴를 닫은 뒤 시스템 키보드를 열거나 닫아요. Delos 키보드(키보드 타일)와는 달라요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre ou fecha o teclado do sistema, depois de fechar este menu. Não é o teclado do Delos (o bloco Teclado)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває або закриває системну клавіатуру після закриття цього меню. Не клавіатура Delos (плитка «Клавіатура»)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此菜单后，打开或关闭系统键盘。不是 Delos 键盘（键盘图块）。"
          }
        }
      }
    },
    "stream_help_overlay": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíná plné statistiky, kompaktní statistiky, vypnuto. FPS dolního 1 %% pokrývá nejpomalejší snímky za zhruba deset sekund."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zwischen voller Statistik, kompakter Statistik und aus. 1%% Low FPS umfasst die langsamsten Frames der letzten etwa zehn Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycles full statistics, compact statistics, off. 1%% low FPS covers the slowest frames of about ten seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre estadísticas completas, estadísticas compactas y desactivadas. El 1%% más bajo de FPS abarca los fotogramas más lentos de unos diez segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne statistiques complètes, statistiques compactes, désactivé. Le 1 %% bas des FPS couvre les images les plus lentes sur environ dix secondes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フル統計、コンパクト統計、オフを順に切り替えます。下位1%%のFPSは、約10秒間で最も遅いフレームが対象です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 통계, 간단 통계, 끄기를 순환해요. 하위 1%% FPS는 약 10초 동안 가장 느린 프레임을 기준으로 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre estatísticas completas, estatísticas compactas e desativado. FPS 1%% inferior cobre os quadros mais lentos de cerca de dez segundos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикає: повна статистика, компактна статистика, вимкнено. FPS 1%% low охоплює найповільніші кадри приблизно за десять секунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在完整统计、精简统计、关闭之间循环切换。1%% Low FPS 涵盖约十秒内最慢的那些帧。"
          }
        }
      }
    },
    "stream_help_quit_game": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá PC o ukončení běžící aplikace a pak se odpojí. Provede se hned, takže nejdřív ulož."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bittet den Host, die laufende Anwendung zu beenden, und trennt dann die Verbindung. Läuft sofort, speichere also vorher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks the host to end the running application, then disconnects. Runs at once, so save first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide al host que termine la aplicación en ejecución y luego se desconecta. Se ejecuta al instante, así que guarda antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande au PC de fermer l’application en cours, puis se déconnecte. S’exécute aussitôt, alors sauvegarde d’abord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストに実行中のアプリの終了を要求し、その後に切断します。すぐに実行されるため、先に保存してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트에 실행 중인 애플리케이션을 종료하라고 요청한 뒤 연결을 끊어요. 바로 실행되니 먼저 저장하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede ao PC que encerre o aplicativo em execução e depois desconecta. Roda na hora, então salve antes."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Просить хост завершити запущений застосунок, потім відключається. Виконується одразу, тож спершу збережись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求电脑端结束正在运行的应用，然后断开连接。会立即执行，请先保存。"
          }
        }
      }
    },
    "stream_help_resume": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavře toto menu a pokračuje ve streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt dieses Menü und setzt den Stream fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes this menu and continues the stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra este menú y continúa el stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme ce menu et reprend le stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメニューを閉じて、ストリームを続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메뉴를 닫고 스트림을 이어서 진행해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha este menu e continua o stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриває це меню й продовжує стрім."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此菜单并继续串流。"
          }
        }
      }
    },
    "stream_help_rumble_feel": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vybere, jak se cítí vibrace z PC, hned a s uložením. Zůstane otevřené: vyber znovu a porovnej. %1$@ vrací zpět."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählt, wie sich Host-Rumble anfühlt, sofort und gespeichert. Bleibt offen: Wähle erneut, um zu vergleichen. %1$@ geht zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Picks how host rumble feels, at once and saved. Stays open: pick again to compare. %1$@ goes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo se siente la vibración del host, al instante y guardado. Se queda abierto: elige de nuevo para comparar. %1$@ vuelve atrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisit le ressenti des vibrations du PC, aussitôt et enregistré. Reste ouvert : choisis à nouveau pour comparer. %1$@ revient en arrière."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストの振動の感触を選びます。すぐに反映され、保存されます。開いたままなので、選び直して比較できます。%1$@で戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 럼블의 느낌을 바로 고르고 저장해요. 열린 상태로 유지되니 다시 골라 비교해 보세요. %1$@로 뒤로 가요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe como a vibração do PC é sentida, na hora e salvo. Continua aberto: escolha de novo para comparar. %1$@ volta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибирає, яка вібрація від хоста відчувається, одразу й зі збереженням. Лишається відкритим: вибери ще раз, щоб порівняти. %1$@ — назад."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择电脑端震动的手感，立即生效并保存。菜单保持打开：可再次选择以对比。%1$@ 返回。"
          }
        }
      }
    },
    "stream_help_screen_brightness": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hned změní jas obrazovky tohoto zařízení; systémové nastavení se poté vrátí. Netýká se PC ani monitoru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert die Bildschirmhelligkeit dieses Geräts sofort; danach gilt wieder die Systemeinstellung. Nicht die von PC oder Monitor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes this device's screen brightness now; the system setting returns afterwards. Not the PC or a monitor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia ahora el brillo de pantalla de este dispositivo; después vuelve el ajuste del sistema. No el del PC ni el de un monitor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change tout de suite la luminosité de l’écran de cet appareil ; le réglage système revient ensuite. Pas celle du PC ni d’un moniteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末の画面の明るさをすぐに変更します。終了後はシステム設定に戻ります。PCやモニターには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 화면 밝기를 바로 바꿔요. 끝나면 시스템 설정으로 돌아가요. PC나 모니터에는 적용되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda agora o brilho da tela deste dispositivo; a configuração do sistema volta depois. Não afeta o PC nem um monitor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Змінює яскравість екрана цього пристрою зараз; потім повертається системне значення. Не ПК і не монітор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即更改本设备的屏幕亮度；之后会恢复系统设置。不影响 PC 或显示器。"
          }
        }
      }
    },
    "stream_help_send_clipboard": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou zkopíruje schránku tohoto zařízení do PC. Vyžaduje podporu schránky ve Vibepollo nebo Apollo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert einmalig die Zwischenablage dieses Geräts auf den PC. Erfordert Zwischenablage-Unterstützung von Vibepollo oder Apollo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies this device's clipboard to the PC once. Needs Vibepollo or Apollo clipboard support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia una vez el portapapeles de este dispositivo al PC. Requiere compatibilidad de portapapeles de Vibepollo o Apollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie une fois le presse-papiers de cet appareil vers le PC. Nécessite la prise en charge du presse-papiers par Vibepollo ou Apollo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のクリップボードを、PCに1回コピーします。VibepolloまたはApolloのクリップボード対応が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 클립보드를 PC로 한 번 복사해요. Vibepollo 또는 Apollo의 클립보드 지원이 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia uma vez a área de transferência deste dispositivo para o PC. Requer suporte do Vibepollo ou Apollo à área de transferência."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз копіює буфер обміну цього пристрою на ПК. Потрібна підтримка буфера обміну у Vibepollo або Apollo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将本设备的剪贴板复制到 PC 一次。需要 Vibepollo 或 Apollo 的剪贴板支持。"
          }
        }
      }
    },
    "stream_help_send_keys": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednou pošle do PC vestavěnou nebo importovanou kombinaci kláves; menu se zavře. Vlastní naimportuješ na záložce Ovládání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet einmalig eine eingebaute oder importierte Tastenkombination an den PC; das Menü schließt sich. Eigene importierst du unter Steuerung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends a built-in or imported key combination to the PC once; the menu closes. Import custom ones under Controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una vez al PC una combinación de teclas integrada o importada; el menú se cierra. Importa otras personalizadas en Controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une fois au PC une combinaison de touches intégrée ou importée ; le menu se ferme. Importe les tiennes dans Commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵またはインポートしたキーの組み合わせを、PCに1回送信します。メニューは閉じます。カスタムのものは「操作」でインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공 또는 가져온 키 조합을 PC로 한 번 보내고 메뉴를 닫아요. 사용자 지정 키는 컨트롤에서 가져오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia uma vez ao PC uma combinação de teclas integrada ou importada; o menu fecha. Importe as personalizadas em Controles."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один раз надсилає на ПК вбудовану або імпортовану комбінацію клавіш; меню закривається. Власні імпортуються в розділі «Керування»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 PC 发送一次内置或已导入的组合键；菜单随即关闭。可在控制中导入自定义组合键。"
          }
        }
      }
    },
    "stream_help_supersampling": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykreslí stream v nativním rozlišení ve větší velikosti a pak ho zmenší. Stojí výkon GPU; platí pro tento stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert einen Stream in nativer Auflösung größer und verkleinert ihn dann. Kostet GPU-Zeit; gilt für diesen Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders a native-resolution stream at a larger size, then reduces it. Costs GPU time; lasts for this stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza un stream de resolución nativa a un tamaño mayor y luego lo reduce. Consume tiempo de GPU; dura lo que dure este stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend un stream en résolution native à une taille plus grande, puis le réduit. Coûte du GPU ; dure le temps de ce stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ解像度のストリームを大きなサイズでレンダリングしてから縮小します。GPU時間を消費します。このストリームの間だけ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 해상도 스트림을 더 큰 크기로 렌더링한 뒤 줄여요. GPU 시간을 쓰며 이번 스트림 동안 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza um stream em resolução nativa em tamanho maior e depois o reduz. Consome GPU; vale neste stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рендерить стрім рідної роздільної здатності у більшому розмірі, а потім зменшує. Навантажує GPU; діє для цього стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以更大的尺寸渲染原生分辨率的串流，然后缩小。会占用 GPU 时间；仅对本次串流有效。"
          }
        }
      }
    },
    "stream_help_supersampling_on": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vykresluje ve větší vnitřní velikosti. Stojí výkon GPU."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendert mit größerer interner Größe. Kostet GPU-Zeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renders at a larger internal size. Costs GPU time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza a un tamaño interno mayor. Consume tiempo de GPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend à une taille interne plus grande. Coûte du GPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "より大きな内部サイズでレンダリングします。GPU時間を消費します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 큰 내부 크기로 렌더링해요. GPU 시간을 써요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renderiza em um tamanho interno maior. Consome GPU."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рендерить у більшому внутрішньому розмірі. Навантажує GPU."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以更大的内部尺寸渲染。会占用 GPU 时间。"
          }
        }
      }
    },
    "stream_help_task_manager": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošle do PC Ctrl + Shift + Esc, což ve Windows otevře Správce úloh."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet Ctrl + Shift + Esc an den PC, was unter Windows den Task-Manager öffnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends Ctrl + Shift + Esc to the PC, which opens Task Manager on Windows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía Ctrl + Shift + Esc al PC, que abre el Administrador de tareas en Windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie Ctrl + Shift + Esc au PC, ce qui ouvre le Gestionnaire des tâches sous Windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCにCtrl + Shift + Escを送信します。Windowsではタスクマネージャーが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC로 Ctrl + Shift + Esc를 보내요. Windows에서는 작업 관리자가 열려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia Ctrl + Shift + Esc ao PC, o que abre o Gerenciador de Tarefas no Windows."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилає на ПК Ctrl + Shift + Esc, що відкриває Диспетчер завдань у Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 PC 发送 Ctrl + Shift + Esc，在 Windows 上会打开任务管理器。"
          }
        }
      }
    },
    "stream_help_touch_sensitivity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíná další škálování citlivosti dotykové obrazovky, nastavené v nastavení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die zusätzliche Empfindlichkeitsskalierung des Touchscreens um, in den Einstellungen konfiguriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggles extra touchscreen sensitivity scaling, configured in settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el escalado extra de sensibilidad táctil, configurado en los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive la mise à l’échelle de sensibilité tactile supplémentaire, configurée dans les réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で指定した、タッチスクリーンの追加の感度スケーリングを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 구성한 터치스크린 추가 감도 배율을 켜고 꺼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna a escala extra de sensibilidade da tela touch, configurada em Configurações."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикає додаткове масштабування чутливості сенсора, налаштоване в налаштуваннях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换额外的触摸屏灵敏度缩放，在设置中配置。"
          }
        }
      }
    },
    "stream_help_upscaler": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvětší stream s nízkým rozlišením, nebo udělá supersampling nativního. Stojí výkon GPU; projeví se hned a uloží se pro tuto aplikaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert einen Stream mit niedriger Auflösung hoch oder supersampelt einen nativen. Kostet GPU-Zeit; gilt live und wird für diese App gemerkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscales a low-resolution stream, or supersamples a native one. Costs GPU time; applies live and is kept for this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala un stream de baja resolución o aplica supermuestreo a uno nativo. Consume tiempo de GPU; se aplica en directo y se conserva para esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscale un stream en basse résolution, ou fait du supersampling sur un stream natif. Coûte du GPU ; s’applique en direct et est gardé pour cette appli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低解像度のストリームをアップスケールするか、ネイティブ解像度のストリームをスーパーサンプリングします。GPU時間を消費します。リアルタイムに適用され、このアプリに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 해상도의 스트림을 업스케일하거나 기본 해상도 스트림을 슈퍼샘플링해요. GPU 시간을 쓰며 실시간으로 적용되고 이 앱에 저장돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz upscale de um stream de baixa resolução, ou supersampling de um nativo. Consome GPU; vale na hora e é mantido neste app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апскейлить стрім низької роздільної здатності або робить суперсемплінг рідного. Навантажує GPU; застосовується наживо й зберігається для цього застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将低分辨率串流超分，或对原生分辨率串流进行超采样。会占用 GPU 时间；实时生效，并为此应用保留。"
          }
        }
      }
    },
    "stream_help_upscaler_sharpness": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Závěrečné zostření. 0 ho vypne. V režimu Jen zostření je to celý efekt. Platí pro tento stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abschließende Schärfung. 0 deaktiviert sie. Bei „Nur schärfen“ ist sie der gesamte Effekt. Gilt für diesen Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final sharpening. 0 disables it. In Sharpen only it is the whole effect. Lasts for this stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitidez final. 0 la desactiva. En Solo nitidez es todo el efecto. Dura lo que dure este stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accentuation finale. 0 la désactive. Avec Netteté seule, c’est tout l’effet. Dure le temps de ce stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終のシャープ化です。0で無効になります。「シャープのみ」では、これが効果のすべてです。このストリームの間だけ有効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 선명화 단계예요. 0이면 꺼져요. 선명화만 모드에서는 이것이 효과 전부예요. 이번 스트림 동안 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitidez final. 0 a desativa. Em Só nitidez, é o efeito inteiro. Vale neste stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фінальне підвищення різкості. 0 вимикає його. У режимі «Лише різкість» це весь ефект. Діє для цього стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终锐化。0 表示关闭锐化。在仅锐化模式下，它就是全部效果。仅对本次串流有效。"
          }
        }
      }
    },
    "stream_help_upscaling": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapne nebo vypne upscaler (nebo Jen zostření) pro tento stream; obraz může blikat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet den Upscaler oder „Nur schärfen“ für diesen Stream ein oder aus; das Bild kann flackern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns the upscaler, or Sharpen only, on or off for this stream; the picture may flicker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el escalador, o Solo nitidez, para este stream; la imagen puede parpadear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive l’upscaler, ou Netteté seule, pour ce stream ; l’image peut clignoter."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このストリームで、アップスケーラー（または「シャープのみ」）のオン/オフを切り替えます。映像がちらつくことがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 스트림에서 업스케일러 또는 선명화만을 켜거나 꺼요. 화면이 깜빡일 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa o upscaler, ou Só nitidez, neste stream; a imagem pode piscar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикає або вимикає апскейлер чи режим «Лише різкість» для цього стріму; картинка може мигнути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为本次串流开启或关闭超分（或仅锐化）；画面可能闪烁。"
          }
        }
      }
    },
    "stream_help_zoom": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přepíná ovládání přiblížení a posunu streamu. Jen místní zobrazení; jestli se uloží, rozhoduje volba „Pamatovat si přiblížení a posun“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet die Zoom- und Schwenksteuerung des Streams um. Nur lokale Ansicht; „Zoom&Schwenk merken“ entscheidet, ob sie bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggles the stream's zoom-and-pan controls. Local view only; Remember Zoom & Pan decides whether it persists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna los controles de zoom y desplazamiento del stream. Solo vista local; Recordar zoom y desplazamiento decide si se conserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive les commandes de zoom et panoramique du stream. Vue locale uniquement ; Mémoriser zoom et panoramique décide si elle persiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームのズームとパンの操作を切り替えます。ローカルの表示のみが対象です。保存されるかどうかは「ズーム&パンを記憶」で決まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림의 확대 및 이동 컨트롤을 켜고 꺼요. 로컬 화면에만 적용돼요. 유지 여부는 확대/이동 기억이 정해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna os controles de zoom e deslocamento do stream. Só visualização local; Lembrar zoom e deslocamento define se persiste."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемикає елементи масштабування й панорамування стріму. Лише локальний вигляд; чи зберігається, вирішує «Пам’ятати масштаб і панораму»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换串流的缩放和平移控制。仅影响本地视图；是否保留由记住缩放和平移决定。"
          }
        }
      }
    },
    "stream_loader_codec_auto": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        },
        "ja": {
          "stringUnit": {
