        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0이 아닌 호스트 요청에 대한 최소 출력이에요. 입력이 0이면 계속 조용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Saída mínima para uma solicitação do PC diferente de zero. Entrada zero continua em silêncio."
