    "settings_native_menu_swipe_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přejetí nahoru od spodního okraje také otevře menu streamu. Dotyky začínající tam se do aplikace nedostanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wischen vom unteren Rand nach oben öffnet ebenfalls das Stream-Menü. Berührungen, die dort beginnen, erreichen die App nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A swipe up from the bottom edge also opens the stream menu. Touches starting there do not reach the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un deslizamiento hacia arriba desde el borde inferior también abre el menú del stream. Los toques que empiezan ahí no llegan a la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un glissement vers le haut depuis le bord inférieur ouvre aussi le menu du stream. Les touchers qui y commencent n’atteignent pas l’appli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下端から上にスワイプしても、ストリームメニューが開きます。そこから始まるタッチはアプリには届きません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래쪽 가장자리에서 위로 스와이프해도 스트림 메뉴가 열려요. 그곳에서 시작한 터치는 앱에 전달되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizar para cima a partir da borda inferior também abre o menu do stream. Toques que começam ali não chegam ao app."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп угору від нижнього краю теж відкриває меню стріму. Дотики, що починаються там, не потрапляють у застосунок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从底部边缘向上滑动也可打开串流菜单。从该处开始的触摸不会传到应用中。"
          }
        }
      }
    },
