    "stream_result_encoding": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PC ohlásilo chybu kódování videa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der PC hat einen Fehler bei der Videokodierung gemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The PC reported a video encoding error."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PC ha informado de un error de codificación de vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PC a signalé une erreur d’encodage vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PCがビデオエンコードエラーを報告しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PC에서 비디오 인코딩 오류가 보고되었어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PC relatou um erro de codificação de vídeo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК повідомив про помилку кодування відео."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑报告了视频编码错误。"
          }
        }
      }
    },
    "stream_result_encoding_details": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PC ohlásilo fatální chybu kódování videa.\n\nZkus vypnout režim HDR, změnit rozlišení streamu nebo změnit rozlišení displeje v PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Host-PC hat einen schwerwiegenden Fehler bei der Videokodierung gemeldet.\n\nVersuche, den HDR-Modus zu deaktivieren, die Stream-Auflösung zu ändern oder die Bildschirmauflösung des Host-PCs zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The host PC reported a fatal video encoding error.\n\nTry disabling HDR mode, changing the streaming resolution, or changing your host PC's display resolution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El PC host ha informado de un error grave de codificación de vídeo.\n\nPrueba a desactivar el modo HDR, a cambiar la resolución del stream o a cambiar la resolución de pantalla del PC host."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le PC hôte a signalé une erreur fatale d’encodage vidéo.\n\nEssaie de désactiver le HDR, de changer la résolution du stream, ou de changer la résolution d’affichage de ton PC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストPCが致命的なビデオエンコードエラーを報告しました。\n\nHDRモードをオフにする、ストリーミング解像度を変更する、またはホストPCのディスプレイ解像度を変更してみてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 PC에서 치명적인 비디오 인코딩 오류가 보고되었어요.\n\nHDR 모드를 끄거나, 스트리밍 해상도를 바꾸거나, 호스트 PC의 디스플레이 해상도를 바꿔 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O PC relatou um erro fatal de codificação de vídeo.\n\nTente desativar o modo HDR, mudar a resolução da transmissão ou mudar a resolução da tela do PC."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК-хост повідомив про критичну помилку кодування відео.\n\nСпробуй вимкнути режим HDR, змінити роздільну здатність стріму або роздільну здатність екрана ПК-хоста."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电脑报告了致命的视频编码错误。\n\n请尝试关闭 HDR 模式、更改串流分辨率，或更改电脑的显示分辨率。"
          }
        }
      }
    },
