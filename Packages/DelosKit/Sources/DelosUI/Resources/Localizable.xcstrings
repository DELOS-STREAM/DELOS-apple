        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续震动"
          }
        }
      }
    },
    "debug_copy_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopíruje blok o zařízení a posledních 100 řádků záznamu, připravené k vložení do issue. Stejná jména a adresy jsou odstraněna."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert den Geräteblock und die letzten 100 Protokollzeilen, bereit zum Einfügen in ein Issue. Dieselben Namen und Adressen werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies the device block and the last 100 log lines, ready to paste into an issue. The same names and addresses are removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia el bloque del dispositivo y las últimas 100 líneas del registro, listo para pegar en una incidencia. Se quitan los mismos nombres y direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie le bloc appareil et les 100 dernières lignes du journal, prêts à coller dans un ticket. Les mêmes noms et adresses sont retirés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末情報と直近100行のログをコピーします。Issueにそのまま貼り付けられます。同じように名前とアドレスは削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 정보와 마지막 로그 100줄을 복사해서 이슈에 바로 붙여넣을 수 있게 해요. 같은 이름과 주소가 제거돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia o bloco do dispositivo e as últimas 100 linhas do log, pronto para colar em uma issue. Os mesmos nomes e endereços são removidos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Копіює блок про пристрій і останні 100 рядків журналу, щоб вставити в issue. Ті самі імена й адреси прибрано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制设备信息块和最近 100 行日志，可直接粘贴到问题反馈中。同样会去除名称和地址。"
          }
        }
      }
    },
    "debug_copy_label": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zkopírovat diagnostické shrnutí"
          }
        },
        "de": {
