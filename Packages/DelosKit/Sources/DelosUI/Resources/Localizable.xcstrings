    "devices_address_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "IP adresa nebo název PC s Vibepollo, případně i s portem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-Adresse oder Hostname des PCs, auf dem Vibepollo läuft, optional mit Port."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The IP address or host name of the PC running Vibepollo, optionally with a port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección IP o el nombre de host del PC que ejecuta Vibepollo, opcionalmente con un puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse IP ou le nom d’hôte du PC qui exécute Vibepollo, avec un port si besoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibepolloを実行するPCのIPアドレスまたはホスト名です。ポートも指定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibepollo를 실행 중인 PC의 IP 주소 또는 호스트 이름이에요. 포트는 선택 사항이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O endereço IP ou nome do host do PC que executa o Vibepollo, opcionalmente com uma porta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "IP-адреса або ім’я хоста ПК із Vibepollo, за потреби з портом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 Vibepollo 的 PC 的 IP 地址或主机名，可附带端口。"
          }
        }
      }
    },
