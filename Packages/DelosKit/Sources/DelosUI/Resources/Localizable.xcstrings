          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：現在のネットワーク接続は従量制です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경고: 현재 네트워크가 종량제 연결이에요!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
