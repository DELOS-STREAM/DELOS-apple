            "state": "translated",
            "value": "Der linke Stick scrollt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The left stick scrolls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desplaza el stick izquierdo."
          }
        },
        "fr": {
