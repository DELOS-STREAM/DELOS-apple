    "debug_display_built_in_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Druhý panel, který je součástí tohoto zařízení. Delos na něj nikdy nestreamuje jako na externí displej. Špatně? Změň „Druhý displej“ v nastavení obrazu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein zweites Panel, das Teil dieses Geräts ist. Delos streamt nie darauf wie auf ein externes Display. Falsch? Ändere „Zweites Display“ in den Anzeige-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A second panel that is part of this device. Delos never streams to it as to an external display. Wrong? Change Second display in the display settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segundo panel que forma parte de este dispositivo. Delos nunca hace stream a él como a una pantalla externa. ¿Mal? Cambia «Segunda pantalla» en los ajustes de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un second panneau qui fait partie de cet appareil. Delos n’y diffuse jamais le stream comme sur un écran externe. Faux ? Change « Second écran » dans les réglages d’affichage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本体の一部である2つ目のパネルです。Delosが外部ディスプレイのようにストリームを送ることはありません。違っている場合は、「表示」設定の「セカンドディスプレイ」を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 일부인 두 번째 패널이에요. Delos는 외부 디스플레이처럼 스트림을 보내지 않아요. 잘못됐다면 디스플레이 설정에서 보조 디스플레이를 바꿔 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um segundo painel que faz parte deste dispositivo. Delos nunca usa esse painel como tela externa para o stream. Errado? Altere “Segunda tela” nas configurações de tela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Друга панель, що є частиною цього пристрою. Delos ніколи не стрімить на неї як на зовнішній екран. Неправильно? Зміни «Другий екран» у налаштуваннях екрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于本设备的第二块面板。Delos 绝不会像对待外接显示器那样向它串流。有误请在显示设置中更改“副屏”。"
          }
        }
      }
    },
    "debug_display_external_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor nebo TV připojené k tomuto zařízení. Režim externího displeje na něj může streamovat. Špatně? Změň „Druhý displej“ v nastavení obrazu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein an dieses Gerät angeschlossener Monitor oder TV. Der Modus für externe Displays darf darauf streamen. Falsch? Ändere „Zweites Display“ in den Anzeige-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A monitor or TV attached to this device. The external display mode may stream to it. Wrong? Change Second display in the display settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un monitor o TV conectado a este dispositivo. El modo de pantalla externa puede hacer stream a él. ¿Mal? Cambia «Segunda pantalla» en los ajustes de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un moniteur ou une TV branchés à cet appareil. Le mode écran externe peut y diffuser le stream. Faux ? Change « Second écran » dans les réglages d’affichage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この本体に接続されたモニターまたはテレビです。外部ディスプレイモードでストリームを表示できます。違っている場合は、「表示」設定の「セカンドディスプレイ」を変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 연결된 모니터나 TV예요. 외부 디스플레이 모드가 스트림을 표시할 수 있어요. 잘못됐다면 디스플레이 설정에서 보조 디스플레이를 바꿔 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um monitor ou TV conectado a este dispositivo. O modo de tela externa pode fazer stream nele. Errado? Altere “Segunda tela” nas configurações de tela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Монітор чи телевізор, підключений до цього пристрою. Режим зовнішнього екрана може стрімити на нього. Неправильно? Зміни «Другий екран» у налаштуваннях екрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到本设备的显示器或电视。外接显示器模式可以向它串流。有误请在显示设置中更改“副屏”。"
          }
        }
      }
    },
    "debug_display_main_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výchozí displej. Používá ho rozhraní Delos a stream, pokud ho režim externího displeje nepřesune jinam."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Standard-Display. Die Delos-Oberfläche und, sofern der Modus für externe Displays ihn nicht verlegt, der Stream nutzen es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default display. The Delos interface and, unless the external display mode moves it, the stream use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla predeterminada. La interfaz de Delos y, salvo que el modo de pantalla externa lo mueva, el stream la usan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran par défaut. L’interface de Delos et, sauf si le mode écran externe le déplace, le stream l’utilisent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準のディスプレイです。Delosの画面と、外部ディスプレイモードで移されていなければストリームもここを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 디스플레이예요. Delos 화면과, 외부 디스플레이 모드가 옮기지 않는 한 스트림도 여기에 표시돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela padrão. A interface do Delos e, a menos que o modo de tela externa a mova, o stream a usam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Екран за замовчуванням. Інтерфейс Delos і, якщо режим зовнішнього екрана його не переносить, стрім використовують його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认显示屏。Delos 界面以及（除非外接显示器模式将其移走）串流都使用它。"
          }
        }
      }
    },
