            "state": "translated",
            "value": "이 기기에는 진동 모터가 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem motor de vibração"
          }
        },
        "uk": {
