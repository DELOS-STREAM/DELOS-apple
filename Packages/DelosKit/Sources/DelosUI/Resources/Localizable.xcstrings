    "link_help_limited_picture": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "zvládne %1$@; %2$@ chce %3$@, po FEC a režii zbývá asi %4$@ na obraz."
