    "settings_native_pcgw_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doklady o nativním HDR z PCGamingWiki (CC BY-NC-SA 3.0); odvozený stav je interpretace aplikace Delos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belege für natives HDR von PCGamingWiki (CC BY-NC-SA 3.0); der abgeleitete Status ist eine Interpretation von Delos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native HDR evidence from PCGamingWiki (CC BY-NC-SA 3.0); the derived status is Delos's interpretation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebas de HDR nativo de PCGamingWiki (CC BY-NC-SA 3.0); el estado derivado es una interpretación de Delos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preuves de HDR natif issues de PCGamingWiki (CC BY-NC-SA 3.0) ; le statut déduit est l’interprétation de Delos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブHDRの根拠はPCGamingWiki（CC BY-NC-SA 3.0）によるものです。そこから導いたステータスは、Delosによる解釈です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PCGamingWiki(CC BY-NC-SA 3.0)의 네이티브 HDR 근거예요. 여기서 도출한 상태는 Delos의 해석이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Evidências de HDR nativo do PCGamingWiki (CC BY-NC-SA 3.0); o status derivado é uma interpretação do app Delos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані про рідну підтримку HDR з PCGamingWiki (CC BY-NC-SA 3.0); похідний статус — це інтерпретація Delos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 HDR 依据来自 PCGamingWiki（CC BY-NC-SA 3.0）；推导出的状态是 Delos 的判断。"
          }
        }
      }
    },
