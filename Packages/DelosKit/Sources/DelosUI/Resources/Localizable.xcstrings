    "stream_result_blocked": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato síť pravděpodobně blokuje aplikaci Delos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Netzwerk blockiert Delos anscheinend."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This network seems to block Delos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parece que esta red bloquea Delos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réseau semble bloquer Delos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワークは Delosをブロックしているようです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크가 Delos를 차단하는 것 같아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rede parece bloquear o app Delos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схоже, ця мережа блокує Delos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此网络似乎屏蔽了 Delos。"
          }
        }
      }
    },
    "stream_result_blocked_hint": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuální síťové připojení tvého zařízení blokuje aplikaci Delos. Streamování přes internet nemusí na této síti fungovat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Netzwerkverbindung deines Geräts blockiert Delos. Streaming übers Internet funktioniert in diesem Netzwerk womöglich nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device's current network connection is blocking Delos. Streaming over the Internet may not work while connected to this network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión de red actual de tu dispositivo está bloqueando Delos. Puede que el streaming por Internet no funcione mientras estés conectado a esta red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion réseau actuelle de ton appareil bloque Delos. Le streaming via Internet peut ne pas fonctionner sur ce réseau."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いの端末の現在のネットワーク接続は、Delosをブロックしています。このネットワークに接続している間は、インターネット経由のストリーミングが動作しない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 기기의 네트워크 연결이 Delos를 차단하고 있어요. 이 네트워크에 연결된 동안에는 인터넷 스트리밍이 작동하지 않을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão de rede atual do seu dispositivo está bloqueando o app Delos. A transmissão pela Internet pode não funcionar enquanto você estiver nesta rede."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточне мережеве з’єднання твого пристрою блокує Delos. Стрімінг через інтернет може не працювати, поки ти в цій мережі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备当前的网络连接正在屏蔽 Delos。连接此网络时，可能无法通过互联网串流。"
          }
        }
      }
    },
