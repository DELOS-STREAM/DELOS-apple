    "shell_problem_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se neodesílá automaticky. Nahlásit otevře v prohlížeči GitHub s konceptem ke kontrole a uloží do Stažených souborů vyčištěný soubor záznamu, který přiložíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts automatisch gesendet. „Melden“ öffnet GitHub im Browser mit einem Entwurf zur Prüfung und speichert eine bereinigte Protokolldatei in Downloads zum Anhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is sent automatically. Report opens GitHub in your browser with a draft for you to check, and saves a cleaned log file to Downloads for you to attach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía nada automáticamente. Informar abre GitHub en tu navegador con un borrador para que lo revises y guarda en Descargas un archivo de registro limpio para que lo adjuntes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est envoyé automatiquement. « Signaler » ouvre GitHub dans ton navigateur avec un brouillon à vérifier, et enregistre dans Téléchargements un journal nettoyé à joindre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動で送信されるものはありません。「報告」を押すと、ブラウザでGitHubが開いて確認用の下書きが表示され、添付用に整理済みのログファイルがダウンロードフォルダに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 전송되는 정보는 없어요. 신고를 누르면 브라우저에서 GitHub가 열리고 확인할 수 있는 초안이 표시돼요. 첨부할 수 있도록 정리된 로그 파일도 다운로드 폴더에 저장돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado automaticamente. Relatar abre o GitHub no navegador com um rascunho para você conferir e salva um arquivo de log limpo em Downloads para você anexar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не надсилається автоматично. «Повідомити» відкриє GitHub у браузері з чернеткою для перевірки та збереже очищений файл журналу в Завантаження, щоб ти його додав."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动发送任何内容。点击“报告”会在浏览器中打开 GitHub 并附上供你检查的草稿，同时把清理后的日志文件保存到“下载”文件夹，供你附加。"
          }
        }
      }
    },
    "shell_problem_note_files": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic se neodesílá automaticky. Nahlásit otevře v prohlížeči GitHub s konceptem ke kontrole a uloží do Souborů (složka DELOS) vyčištěný soubor záznamu, který přiložíš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts automatisch gesendet. „Melden“ öffnet GitHub im Browser mit einem Entwurf zur Prüfung und speichert eine bereinigte Protokolldatei in Dateien (Ordner DELOS) zum Anhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is sent automatically. Report opens GitHub in your browser with a draft for you to check, and saves a cleaned log file to Files (DELOS folder) for you to attach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía nada automáticamente. Informar abre GitHub en tu navegador con un borrador para que lo revises y guarda en Archivos (carpeta DELOS) un archivo de registro limpio para que lo adjuntes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est envoyé automatiquement. « Signaler » ouvre GitHub dans ton navigateur avec un brouillon à vérifier, et enregistre dans Fichiers (dossier DELOS) un journal nettoyé à joindre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動で送信されるものはありません。「報告」を押すと、ブラウザでGitHubが開いて確認用の下書きが表示され、添付用に整理済みのログファイルが「ファイル」（DELOSフォルダ）に保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동으로 전송되는 정보는 없어요. 신고를 누르면 브라우저에서 GitHub가 열리고 확인할 수 있는 초안이 표시돼요. 첨부할 수 있도록 정리된 로그 파일도 파일 앱(DELOS 폴더)에 저장돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado automaticamente. Relatar abre o GitHub no navegador com um rascunho para você conferir e salva um arquivo de log limpo em Arquivos (pasta DELOS) para você anexar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не надсилається автоматично. «Повідомити» відкриє GitHub у браузері з чернеткою для перевірки та збереже очищений файл журналу у Файли (папка DELOS), щоб ти його додав."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动发送任何内容。点击“报告”会在浏览器中打开 GitHub 并附上供你检查的草稿，同时把清理后的日志文件保存到“文件”（DELOS 文件夹），供你附加。"
          }
        }
      }
    },
    "shell_problem_note_tv": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV neumí otevřít GitHub ani ukládat soubory, takže se nic neodešle. Nahlas problém na GitHubu z jiného zařízení; vyčištěný záznam najdeš v Informacích pro ladění."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kann GitHub nicht öffnen und keine Dateien speichern, daher wird nichts gesendet. Melde das Problem auf GitHub von einem anderen Gerät; die Debug-Infos zeigen das bereinigte Protokoll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV cannot open GitHub or save files, so nothing is sent. Report the problem on GitHub from another device; Debug info shows the cleaned log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV no puede abrir GitHub ni guardar archivos, así que no se envía nada. Informa del problema en GitHub desde otro dispositivo; la información de depuración muestra el registro limpio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’Apple TV ne peut ni ouvrir GitHub ni enregistrer de fichiers, donc rien n’est envoyé. Signale le problème sur GitHub depuis un autre appareil ; les infos de débogage affichent le journal nettoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVではGitHubを開くこともファイルを保存することもできないため、何も送信されません。別の端末からGitHubで問題を報告してください。整理済みのログはデバッグ情報で確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV는 GitHub를 열거나 파일을 저장할 수 없어서 아무것도 전송되지 않아요. 다른 기기에서 GitHub에 문제를 신고해 주세요. 정리된 로그는 디버그 정보에서 볼 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple TV não consegue abrir o GitHub nem salvar arquivos, então nada é enviado. Relate o problema no GitHub de outro dispositivo; as informações de depuração mostram o log limpo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV не може відкрити GitHub чи зберегти файли, тож нічого не надсилається. Повідом про проблему на GitHub з іншого пристрою; очищений журнал є в Інформації для налагодження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV 无法打开 GitHub，也无法保存文件，因此不会发送任何内容。请在其他设备上到 GitHub 报告问题；调试信息中可查看清理后的日志。"
          }
        }
      }
    },
    "shell_problem_note_upload": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlásit odešle vyčištěný záznam do služby pro hlášení problémů Delos (uchová se 30 dní a přečte ho každý, kdo má odkaz) a otevře koncept na GitHubu ke kontrole. Nic se neodešle, dokud nevybereš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Melden“ sendet ein bereinigtes Protokoll an den Delos-Meldedienst (30 Tage gespeichert, für jeden lesbar, der den Link hat) und öffnet einen GitHub-Entwurf zur Prüfung. Vor deiner Wahl wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report sends a cleaned log to the Delos report service (kept 30 days, readable by anyone who has the link) and opens a GitHub draft for you to check. Nothing is sent before you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informar envía un registro limpio al servicio de informes de Delos (se guarda 30 días y lo puede leer cualquiera que tenga el enlace) y abre en GitHub un borrador para que lo revises. No se envía nada hasta que lo elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Signaler » envoie un journal nettoyé au service de rapports Delos (conservé 30 jours, lisible par toute personne qui a le lien) et ouvre un brouillon GitHub à vérifier. Rien n’est envoyé avant ton choix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「報告」を押すと、整理済みのログが、Delosの報告サービスに送信され（30日間保存され、リンクを知っている人なら誰でも読めます）、確認用のGitHubの下書きがブラウザで開きます。あなたが選ぶまで何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고를 누르면 정리된 로그를 Delos 신고 서비스로 보내고(30일간 보관되며 링크가 있는 사람은 누구나 읽을 수 있어요) 확인할 수 있는 GitHub 초안을 열어요. 선택하기 전에는 아무것도 전송되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatar envia um log limpo ao serviço de relatórios Delos (guardado por 30 dias e legível por quem tiver o link) e abre um rascunho no GitHub para você conferir. Nada é enviado antes de você escolher."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Повідомити» надсилає очищений журнал до служби звітів Delos (зберігається 30 днів, його може прочитати кожен, хто має посилання) і відкриває чернетку GitHub для перевірки. Нічого не надсилається, доки ти не обереш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“报告”会把清理后的日志发送到 Delos 报告服务（保存 30 天，任何拿到链接的人都能查看），并打开 GitHub 草稿供你检查。在你选择之前不会发送任何内容。"
          }
        }
      }
    },
    "shell_problem_note_upload_tv": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nahlásit odešle vyčištěný záznam do služby pro hlášení problémů Delos (uchová se 30 dní a přečte ho každý, kdo má odkaz) a ukáže jeho odkaz pro issue na GitHubu. Nic se neodešle, dokud nevybereš."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Melden“ sendet ein bereinigtes Protokoll an den Delos-Meldedienst (30 Tage gespeichert, für jeden lesbar, der den Link hat) und zeigt seinen Link für ein GitHub-Issue. Vor deiner Wahl wird nichts gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report sends a cleaned log to the Delos report service (kept 30 days, readable by anyone who has the link) and shows its link for a GitHub issue. Nothing is sent before you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informar envía un registro limpio al servicio de informes de Delos (se guarda 30 días y lo puede leer cualquiera que tenga el enlace) y muestra su enlace para una incidencia de GitHub. No se envía nada hasta que lo elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Signaler » envoie un journal nettoyé au service de rapports Delos (conservé 30 jours, lisible par toute personne qui a le lien) et affiche son lien pour un ticket GitHub. Rien n’est envoyé avant ton choix."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「報告」を押すと、整理済みのログがDelosの報告サービスに送信され（30日間保存され、リンクを知っている人なら誰でも読めます）、GitHubのIssue用のリンクが表示されます。あなたが選ぶまで何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고를 누르면 정리된 로그를 Delos 신고 서비스로 보내고(30일간 보관되며 링크가 있는 사람은 누구나 읽을 수 있어요) GitHub 이슈에 넣을 링크를 보여 줘요. 선택하기 전에는 아무것도 전송되지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relatar envia um log limpo ao serviço de relatórios Delos (guardado por 30 dias e legível por quem tiver o link) e mostra o link para um relato no GitHub. Nada é enviado antes de você escolher."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Повідомити» надсилає очищений журнал до служби звітів Delos (зберігається 30 днів, його може прочитати кожен, хто має посилання) і показує посилання для звернення на GitHub. Нічого не надсилається, доки ти не обереш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“报告”会把清理后的日志发送到 Delos 报告服务（保存 30 天，任何拿到链接的人都能查看），并显示可用于 GitHub 问题反馈的链接。在你选择之前不会发送任何内容。"
          }
        }
      }
    },
