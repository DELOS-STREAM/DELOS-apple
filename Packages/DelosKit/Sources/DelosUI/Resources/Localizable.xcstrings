    "debug_osc_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje ovládání na obrazovce bez streamu: vyzkoušej každé tlačítko, D-pad i sticky, nic se neodesílá. Ozubené kolo v rohu upravuje rozložení stejně jako ve streamu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bildschirmsteuerung ohne Stream: Probiere jede Taste, das Steuerkreuz und die Sticks aus, es wird nichts gesendet. Das Zahnrad in der Ecke bearbeitet das Layout, wie im Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your on-screen controls without a stream: try every button, the D-pad and the sticks, nothing is sent. The gear in the corner edits the layout, as in a stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus controles en pantalla sin un stream: prueba cada botón, la cruceta y los sticks; no se envía nada. El engranaje de la esquina edita la distribución, como en un stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes commandes à l’écran sans stream : essaie chaque bouton, la croix directionnelle et les sticks, rien n’est envoyé. L’engrenage dans le coin modifie la disposition, comme pendant un stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームなしで画面上のコントロールを試せます。すべてのボタン、十字キー、スティックを試せますが、何も送信されません。隅の歯車で、ストリーム中と同様にレイアウトを編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림 없이 화면 컨트롤을 써 볼 수 있어요. 모든 버튼, 방향 패드, 스틱을 시험해 보세요. 아무것도 전송되지 않아요. 모서리의 톱니바퀴로 스트림에서처럼 레이아웃을 편집해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus controles na tela sem um stream: teste cada botão, o direcional e os analógicos, nada é enviado. A engrenagem no canto edita o layout, como em um stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твої екранні елементи керування без стріму: пробуй кожну кнопку, D-pad і стіки, нічого не надсилається. Шестерня в кутку змінює розкладку, як у стрімі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不串流也能使用你的屏幕按键：试试每个按键、方向键和摇杆，不会发送任何内容。角落的齿轮可编辑布局，与串流中一致。"
          }
        }
      }
    },
