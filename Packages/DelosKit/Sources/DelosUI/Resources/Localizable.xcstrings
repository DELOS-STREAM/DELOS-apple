          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SteamGridDB não aceitou a chave de API"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SteamGridDB не прийняв ключ API"
          }
