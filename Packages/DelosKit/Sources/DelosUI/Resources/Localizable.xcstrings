    "help_mouse_mode_list": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak se dotyk mění na vstup do PC. Menu streamu: jen pro tuto relaci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Touch zur PC-Eingabe wird. Stream-Menü: nur für diese Sitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How touch becomes PC input. Stream menu: this session only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se convierte el toque en entrada del PC. Menú del stream: solo esta sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment le toucher devient une entrée du PC. Menu du stream : cette session seulement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチをPCの入力に変換する方法です。ストリームメニューでの変更：このセッションのみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치가 PC 입력으로 바뀌는 방식이에요. 스트림 메뉴에서는 이번 세션에만 적용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como o toque vira entrada no PC. Menu do stream: só nesta sessão."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як дотики стають введенням на ПК. Меню стріму: лише ця сесія."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸操作如何转换为 PC 输入。串流菜单：仅对本次会话生效。"
          }
        }
      }
    },
    "help_mouse_mode_list_0": {
