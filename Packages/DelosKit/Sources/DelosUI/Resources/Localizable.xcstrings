    "settings_native_hero_blur_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozostří pozadí aplikace za knihovnou. Vyžaduje volbu „Pozadí aplikace“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwischt den App-Hintergrund hinter der Bibliothek. Erfordert App-Hintergrund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blurs the app background behind the library. Needs App background."
          }
