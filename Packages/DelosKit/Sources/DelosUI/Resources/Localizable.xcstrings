    "link_test_detail": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změří, co z PC %1$@ přenese tato síť: testovací provoz asi 2 sekundy na každý krok, až několik set Mbps. Zůstaň na %2$@ a nic dalšího nespouštěj."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Misst, was dieses Netzwerk von %1$@ schafft: Testverkehr, etwa 2 Sekunden pro Schritt, mit bis zu mehreren hundert Mbps. Bleib auf %2$@ und lass nichts anderes laufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures what this network carries from %1$@: test traffic for about 2 seconds per step, at up to several hundred Mbps. Stay on %2$@, with nothing else running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mide lo que soporta esta red desde %1$@: tráfico de prueba durante unos 2 segundos por paso, a hasta varios cientos de Mbps. Quédate en %2$@, sin nada más en marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesure ce que ce réseau supporte depuis %1$@ : trafic de test pendant environ 2 secondes par étape, jusqu’à plusieurs centaines de Mbps. Reste sur %2$@, sans rien lancer d’autre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワークで%1$@から転送できる速度を測定します。1ステップにつき約2秒、最大数百Mbpsのテストトラフィックを流します。%2$@のまま、ほかの通信は止めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 이 네트워크가 전송할 수 있는 속도를 측정해요. 단계마다 약 2초 동안 최대 수백 Mbps의 테스트 트래픽을 보내요. %2$@에 연결한 상태로 다른 작업은 하지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mede o que esta rede suporta a partir de %1$@: tráfego de teste por cerca de 2 segundos por etapa, a até várias centenas de Mbps. Fique em %2$@, sem nada mais em execução."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимірює, що ця мережа тягне від %1$@: тестовий трафік приблизно 2 секунди на крок, до кількох сотень Mbps. Лишайся в мережі (%2$@) і нічого більше не запускай."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测量此网络从 %1$@ 可承载的速率：每一步发送约 2 秒测试流量，最高可达数百 Mbps。请保持连接 %2$@，并且不要运行其他程序。"
          }
        }
      }
    },
