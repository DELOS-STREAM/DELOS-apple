    "settings_native_pcgw_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Doklady o nativním HDR z PCGamingWiki (CC BY-NC-SA 3.0); odvozený stav je interpretace aplikace Delos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belege für natives HDR von PCGamingWiki (CC BY-NC-SA 3.0); der abgeleitete Status ist eine Interpretation von Delos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native HDR evidence from PCGamingWiki (CC BY-NC-SA 3.0); the derived status is Delos's interpretation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebas de HDR nativo de PCGamingWiki (CC BY-NC-SA 3.0); el estado derivado es una interpretación de Delos."
