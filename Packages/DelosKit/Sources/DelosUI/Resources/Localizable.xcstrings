      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádný stick neposouvá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Stick scrollt."
          }
        },
        "en": {
          "stringUnit": {
