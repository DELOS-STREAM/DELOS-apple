            "state": "translated",
            "value": "El Vibepollo de este PC no puede probar el enlace. Actualízalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Vibepollo de ce PC ne peut pas tester la liaison. Mets-le à jour."
