    "help_note_metalfx_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX na tomto zařízení není k dispozici: místo něj běží Jen zostření."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX ist auf diesem Gerät nicht verfügbar: Stattdessen läuft „Nur schärfen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX is not available on this device: Sharpen only runs instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX no está disponible en este dispositivo: se usa Solo nitidez en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX n’est pas disponible sur cet appareil : Netteté seule est utilisé à la place."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではMetalFXを使用できません。代わりに「シャープのみ」が動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 MetalFX를 쓸 수 없어요. 대신 선명화만 모드가 동작해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX não está disponível neste dispositivo: Apenas nitidez é usado no lugar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX недоступний на цьому пристрої: замість нього працює «Лише різкість»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备不支持 MetalFX：将改用仅锐化。"
          }
        }
      }
    },
