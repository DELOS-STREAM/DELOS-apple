    "devices_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "PC spárovaná s aplikací Delos. Názvy, které tu nastavíš, zůstávají jen na tomto zařízení."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Delos gekoppelte PCs. Namen, die du hier vergibst, gelten nur auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PCs paired with Delos. Names you set here stay on this device only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PC emparejados con Delos. Los nombres que pongas aquí solo se guardan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC associés à Delos. Les noms que tu définis ici restent sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Delosとペアリング済みのPCです。ここで付けた名前は、この端末にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos와 페어링된 PC예요. 여기서 정한 이름은 이 기기에만 적용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "PCs pareados com o app Delos. Os nomes definidos aqui ficam só neste dispositivo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ПК, спарені з Delos. Імена, які ти задаєш тут, діють лише на цьому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已与 Delos 配对的 PC。在此设置的名称仅保存在本设备上。"
          }
        }
      }
    },
