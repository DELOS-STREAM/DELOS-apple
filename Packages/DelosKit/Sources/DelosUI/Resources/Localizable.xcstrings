    "help_checkbox_enable_hdr": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požádá o HDR video. Vyžaduje podporu aplikace, grafické karty v PC, dekodéru i displeje (10bitové HEVC, AV1 nebo PyroWave)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fordert HDR-Video an. Erfordert Unterstützung durch App, Host-GPU, Decoder und Display (10-Bit-HEVC, AV1 oder PyroWave)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests HDR video. Needs app, host GPU, decoder and display support (10-bit HEVC, AV1 or PyroWave)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita vídeo HDR. Requiere compatibilidad de la app, la GPU del host, el decodificador y la pantalla (HEVC de 10 bits, AV1 o PyroWave)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande une vidéo HDR. Nécessite la prise en charge par l’appli, le GPU du PC, le décodeur et l’écran (HEVC 10 bits, AV1 ou PyroWave)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HDRビデオを要求します。アプリ、ホストのGPU、デコーダー、ディスプレイの対応が必要です（10ビットのHEVC、AV1、またはPyroWave）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HDR 비디오를 요청해요. 앱, 호스트 GPU, 디코더, 디스플레이가 모두 지원해야 해요 (10비트 HEVC, AV1 또는 PyroWave)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicita vídeo HDR. Requer suporte do app, da GPU do PC, do decodificador e da tela (HEVC 10 bits, AV1 ou PyroWave)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитує HDR-відео. Потрібна підтримка застосунку, GPU хоста, декодера й екрана (10-бітний HEVC, AV1 або PyroWave)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 HDR 视频。需要应用、电脑 GPU、解码器和屏幕均支持（10-bit HEVC、AV1 或 PyroWave）。"
          }
        }
      }
    },
    "help_checkbox_host_audio": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přehrává zvuk aplikace i na PC, nejen tady. Vypni, aby reproduktory PC mlčely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt den App-Ton auf dem PC und hier wieder. Ausschalten, damit die PC-Lautsprecher still bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays app audio on the PC as well as here. Turn off to keep the PC speakers quiet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el audio de la app también en el PC. Desactívalo para que los altavoces del PC no suenen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joue le son de l’appli sur le PC en plus d’ici. Désactive pour garder les haut-parleurs du PC silencieux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの音声を、こちらに加えてPCでも再生します。PCのスピーカーを静かにしたい場合はオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 오디오를 여기뿐 아니라 PC에서도 재생해요. PC 스피커를 조용히 두려면 꺼 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz o áudio do app no PC além daqui. Desative para manter as caixas de som do PC em silêncio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відтворює звук застосунку і на ПК, і тут. Вимкни, щоб динаміки ПК мовчали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用声音同时在 PC 上播放。关闭后 PC 扬声器保持安静。"
          }
        }
      }
    },
    "help_dynamic_resolution": {
      "extractionState": "manual",
      "localizations": {
