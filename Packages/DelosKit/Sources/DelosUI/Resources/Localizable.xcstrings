            "state": "translated",
            "value": "匹配应用配色"
          }
        }
      }
    },
    "settings_native_material_you_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používá jen barvy tvé tapety. Pro výběr palety vypni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutzt nur die Farben deines Hintergrundbilds. Zum Wählen einer Palette ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses only your wallpaper colors. Turn off to choose a palette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa solo los colores de tu fondo de pantalla. Desactívalo para elegir una paleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise uniquement les couleurs de ton fond d’écran. Désactive pour choisir une palette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁紙の色のみを使用します。パレットを選ぶにはオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경화면 색상만 사용해요. 끄면 팔레트를 고를 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa apenas as cores do seu papel de parede. Desative para escolher uma paleta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовує лише кольори шпалер. Вимкни, щоб вибрати палітру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅使用壁纸颜色。关闭后可选择调色板。"
          }
        }
      }
    },
    "settings_native_material_you_fallback_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto zařízení není paleta z tapety, proto se použijí barvy palety %1$@. Pro výběr palety vypni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat keine Hintergrundbild-Palette, daher werden die Farben von %1$@ genutzt. Zum Wählen einer Palette ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No wallpaper palette on this device, so %1$@'s colors are used. Turn off to choose a palette."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene paleta del fondo de pantalla, así que se usan los colores de %1$@. Desactívalo para elegir una paleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de palette de fond d’écran sur cet appareil : les couleurs de %1$@ sont utilisées. Désactive pour choisir une palette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には壁紙のパレットがないため、%1$@の色を使用します。パレットを選ぶにはオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 배경화면 팔레트가 없어서 %1$@ 색상을 사용해요. 끄면 팔레트를 고를 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem paleta de papel de parede, então são usadas as cores de %1$@. Desative para escolher uma paleta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої немає палітри шпалер, тому використано кольори палітри %1$@. Вимкни, щоб вибрати палітру."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有壁纸调色板，因此使用 %1$@ 的配色。关闭后可选择调色板。"
          }
        }
      }
    },
