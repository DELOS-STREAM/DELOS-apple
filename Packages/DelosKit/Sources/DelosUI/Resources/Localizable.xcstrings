    "debug_last_problem_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukáže, kdy poslední přehraná předvolba nemohla použít svou techniku a přehrála místo ní prostou amplitudu, a proč."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, wann das zuletzt gespielte Preset seine Technik nicht nutzen konnte und stattdessen den einfachen Amplitudenpfad spielte, und warum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows when the last played preset could not use its technique and played the plain amplitude path instead, and why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica cuándo el último ajuste preestablecido no pudo usar su técnica y reprodujo la amplitud simple en su lugar, y por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indique quand le dernier préréglage joué n’a pas pu utiliser sa technique et a joué le simple chemin d’amplitude à la place, et pourquoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に再生したプリセットが本来の方式を使えず、通常の振幅方式で再生した場合に、その理由を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막으로 재생한 프리셋이 자체 기법을 쓰지 못하고 기본 진폭 방식으로 재생된 경우 그 이유를 보여 줘요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra quando a última predefinição reproduzida não pôde usar sua técnica e usou o caminho simples de amplitude, e o motivo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує, коли останній відтворений пресет не зміг застосувати свою техніку й відтворився звичайною амплітудою, та чому."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示最近播放的预设无法使用其技术、改为播放普通振幅路径的情况及原因。"
          }
        }
      }
    },
