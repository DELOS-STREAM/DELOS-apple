            "value": "Weniger Bewegung in der Oberfläche. Die App-FPS bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Less interface motion. App FPS is unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos movimiento en la interfaz. Los FPS de la app no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de mouvement dans l’interface. Les FPS de l’appli ne changent pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターフェースの動きを抑えます。アプリのFPSは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 움직임이 줄어요. 앱 FPS는 그대로예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos movimento na interface. O FPS do app não muda."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Менше руху в інтерфейсі. FPS застосунку не змінюється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "减少界面动效。应用 FPS 不受影响。"
          }
        }
      }
