    "debug_live_amplitude_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Živě vypočtená amplituda zařízení včetně úvodního nárazu a vyhlazení, jak se ustalují."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live berechnete Geräteamplitude, einschließlich Start-Kick und Glättung beim Einpendeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live computed device amplitude, including the start kick and smoothing as they settle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitud del dispositivo calculada en vivo, incluidos el impulso inicial y el suavizado mientras se estabilizan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitude de l’appareil calculée en direct, avec le coup de départ et le lissage au fur et à mesure qu’ils se stabilisent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始時のキックと平滑化が落ち着く様子を含めた、端末の振幅のリアルタイム計算値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작 킥과 스무딩이 자리 잡는 과정을 포함해 실시간으로 계산한 기기 진폭이에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplitude do dispositivo calculada ao vivo, incluindo o impulso inicial e a suavização conforme se estabilizam."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Амплітуда пристрою в реальному часі, враховуючи стартовий поштовх і згладжування в міру стабілізації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时计算的设备振幅，包含起振冲击和逐渐稳定的平滑过程。"
          }
        }
      }
    },
    "debug_live_amplitude_details": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Režim: %1$@\nVzor: %2$@\nOba motory v PC dostávají uvedené procento vstupu; není to konečné procento výstupu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus: %1$@\nMuster: %2$@\nBeide Host-Motoren erhalten den angegebenen Eingangsprozentwert; das ist nicht der endgültige Ausgabewert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode: %1$@\nPattern: %2$@\nBoth host motors receive the labelled input percentage; this is not the final output percentage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo: %1$@\nPatrón: %2$@\nLos dos motores del host reciben el porcentaje de entrada indicado; no es el porcentaje de salida final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode : %1$@\nMotif : %2$@\nLes deux moteurs du PC reçoivent le pourcentage d’entrée indiqué ; ce n’est pas le pourcentage de sortie final."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モード：%1$@\nパターン：%2$@\nホストの両方のモーターに、表示された入力割合が送られます。最終的な出力割合ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드: %1$@\n패턴: %2$@\n두 호스트 모터 모두 표시된 입력 비율을 받아요. 최종 출력 비율이 아니에요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo: %1$@\nPadrão: %2$@\nOs dois motores do PC recebem a porcentagem de entrada indicada; esta não é a porcentagem final de saída."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим: %1$@\nШаблон: %2$@\nОбидва мотори ПК отримують зазначений відсоток вхідного сигналу; це не кінцевий відсоток виходу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模式：%1$@\n波形：%2$@\n电脑的两个马达都会收到所标注的输入百分比；这不是最终输出百分比。"
          }
        }
      }
    },
