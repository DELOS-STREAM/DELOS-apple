        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大入力の20 msパルスを、40 msの間隔を空けて20回行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 입력의 20 ms 맥박 스무 번이 이어지고, 각각 뒤에 40 ms의 정적이 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinte pulsos de 20 ms com entrada máxima, cada um seguido de 40 ms de silêncio."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двадцять імпульсів по 20 мс на повний сигнал, після кожного пауза 40 мс."
