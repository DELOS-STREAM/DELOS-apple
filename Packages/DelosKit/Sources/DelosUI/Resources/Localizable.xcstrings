    "debug_clear_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smaže záznam na tomto zařízení. Nové události se zase zaznamenávají, pokud není vypnutá volba „Ukládat diagnostické záznamy“ (Nastavení → O aplikaci)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht das Protokoll auf diesem Gerät. Neue Ereignisse werden wieder protokolliert, außer „Diagnoseprotokolle behalten“ ist aus (Einstellungen → Über)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes the log on this device. New events are logged again unless Keep diagnostic logs is off (Settings → About)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el registro de este dispositivo. Los eventos nuevos se vuelven a registrar salvo que Conservar registros de diagnóstico esté desactivado (Ajustes → Acerca de)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le journal de cet appareil. Les nouveaux événements sont de nouveau consignés, sauf si Conserver les journaux de diagnostic est désactivé (Réglages → À propos)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のログを削除します。「診断ログを保存」をオフにしていなければ、新しいイベントは再び記録されます（設定 → バージョン情報）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 로그를 삭제해요. 진단 로그 보관(설정 → 정보)이 꺼져 있지 않으면 새 이벤트는 다시 기록돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui o log deste dispositivo. Novos eventos voltam a ser registrados, a menos que Manter logs de diagnóstico esteja desativado (Configurações → Sobre)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє журнал на цьому пристрої. Нові події знову записуються, якщо не вимкнено «Вести журнали діагностики» (Налаштування > Про застосунок)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此设备上的日志。除非关闭“保留诊断日志”（设置 > 关于），否则新事件仍会继续记录。"
          }
        }
      }
    },
