            "value": "Не використовується в режимі «Лише різкість»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅锐化模式下不使用。"
          }
        }
      }
    },
    "help_note_supersampling_needs_native": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Supersampling platí jen pro stream ve velikosti displeje (%1$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Supersampling gilt nur für einen Stream in Displaygröße (%1$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supersampling applies only to a stream at the display's size (%1$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El supermuestreo solo se aplica a un stream del tamaño de la pantalla (%1$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le supersampling ne s’applique qu’à un stream à la taille de l’écran (%1$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スーパーサンプリングはディスプレイと同じサイズ（%1$@）のストリームにのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슈퍼샘플링은 디스플레이 크기(%1$@)의 스트림에만 적용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O supersampling vale só para um stream do tamanho da tela (%1$@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Суперсемплінг діє лише для стріму розміром із дисплей (%1$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超采样仅适用于与显示屏尺寸相同（%1$@）的串流。"
          }
        }
      }
    },
    "help_note_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená volba není dostupná"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Auswahl ist nicht verfügbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved choice is unavailable"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción guardada no está disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le choix enregistré est indisponible"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した選択肢は利用できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 선택을 사용할 수 없어요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A escolha salva está indisponível"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережений вибір недоступний"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的选项不可用"
          }
        }
      }
    },
    "help_note_upscaler_supersamples": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: vykreslí %1$@ v %2$@ a pak zmenší na %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: rendert %1$@ mit %2$@ und verkleinert dann auf %3$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: renders %1$@ at %2$@, then reduces it to %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalador: renderiza %1$@ a %2$@ y luego lo reduce a %3$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler : rend %1$@ en %2$@, puis le réduit à %3$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップスケーラー：%1$@を%2$@でレンダリングし、%3$@に縮小します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업스케일러: %1$@ 화면을 %2$@ 크기로 렌더링한 뒤 %3$@ 크기로 줄여요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: renderiza %1$@ em %2$@ e depois reduz para %3$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апскейлер: рендерить %1$@ у %2$@, а потім зменшує до %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超分：以 %2$@ 渲染 %1$@，再缩小到 %3$@。"
          }
        }
      }
    },
    "help_note_upscaler_unscaled": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ se na tomto displeji nezvětšuje (obraz %2$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ wird auf diesem Display nicht vergrößert (Bild %2$@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ is not enlarged on this display (picture %2$@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalador: %1$@ no se amplía en esta pantalla (imagen %2$@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler : %1$@ n’est pas agrandi sur cet écran (image %2$@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップスケーラー：このディスプレイでは%1$@は拡大されません（画像 %2$@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업스케일러: 이 디스플레이에서는 %1$@ 화면을 확대하지 않아요(화면 %2$@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ não é ampliado nesta tela (imagem %2$@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апскейлер: %1$@ не збільшується на цьому дисплеї (зображення %2$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超分：此显示屏上不放大 %1$@（画面 %2$@）。"
          }
        }
      }
    },
    "help_note_upscaler_upscales": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ → %2$@ na tomto displeji."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ → %2$@ auf diesem Display."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ → %2$@ on this display."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalador: %1$@ → %2$@ en esta pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler : %1$@ → %2$@ sur cet écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップスケーラー：このディスプレイでは%1$@ → %2$@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업스케일러: 이 디스플레이에서 %1$@ → %2$@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Upscaler: %1$@ → %2$@ nesta tela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Апскейлер: %1$@ → %2$@ на цьому дисплеї."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超分：此显示屏上 %1$@ → %2$@。"
          }
        }
      }
    },
    "help_onscreen_keyboard_autofit": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypne automatické přizpůsobení plné klávesnice, aby se uplatnila uložená šířka, výška a zarovnání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet das automatische Einpassen der Volltastatur aus, damit die gespeicherte Breite, Höhe und Ausrichtung gelten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turns off automatic fitting of the full keyboard so the saved width, height and alignment apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva el ajuste automático del teclado completo para que se apliquen la anchura, la altura y la alineación guardadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactive l’ajustement automatique du clavier complet pour que la largeur, la hauteur et l’alignement enregistrés s’appliquent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルキーボードの自動調整をオフにして、保存した幅、高さ、配置を適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 키보드의 자동 맞춤을 꺼서 저장된 너비, 높이, 정렬이 적용되게 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa o ajuste automático do teclado completo para que valham a largura, a altura e o alinhamento salvos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимикає автоматичне підлаштування повної клавіатури, щоб діяли збережені ширина, висота й вирівнювання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭完整键盘的自动适配，改用已保存的宽度、高度和对齐方式。"
          }
        }
      }
    },
    "help_option_help_custom_keys": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře návod k formátu souboru vlastních kláves. Výsledný soubor načti volbou „Importovat vlastní klávesy“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die Anleitung zum Dateiformat eigener Tasten. Lade die erzeugte Datei mit „Eigene Tasten importieren“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens instructions for the custom-key file format. Load the resulting file with Import Custom Keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre las instrucciones del formato de archivo de teclas personalizadas. Carga el archivo resultante con Importar teclas personalizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les instructions sur le format du fichier de touches personnalisées. Charge le fichier obtenu avec Importer des touches personnalisées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムキーのファイル形式の説明を開きます。できあがったファイルは「カスタムキーをインポート」で読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 키 파일 형식 안내를 열어요. 만든 파일은 사용자 지정 키 가져오기로 불러오세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre as instruções do formato de arquivo de teclas personalizadas. Carregue o arquivo resultante com Importar teclas personalizadas."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває інструкцію до формату файлу власних клавіш. Завантаж отриманий файл через «Імпортувати власні клавіші»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开自定义按键文件格式的说明。请用导入自定义按键加载生成的文件。"
          }
        }
      }
    },
    "help_option_reset_osc_preference": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžitě vrátí virtuální gamepad tohoto profilu na výchozí velikosti a pozice. Ostatní profily zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das virtuelle Gamepad dieses Profils sofort auf Standardgrößen und -positionen zurück. Andere Profile bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores this profile's virtual gamepad to default sizes and positions at once. Other profiles are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura al instante el mando virtual de este perfil a los tamaños y posiciones predeterminados. Los demás perfiles se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remet aussitôt la manette virtuelle de ce profil à ses tailles et positions par défaut. Les autres profils sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールの仮想コントローラーを、すぐに初期のサイズと位置に戻します。ほかのプロフィールはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필의 가상 게임패드를 기본 크기와 위치로 바로 되돌려요. 다른 프로필은 그대로예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura na hora o controle virtual deste perfil para os tamanhos e posições padrão. Os outros perfis são mantidos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одразу повертає віртуальний контролер цього профілю до типових розмірів і позицій. Інші профілі лишаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即将此个人资料的虚拟手柄恢复为默认大小和位置。其他个人资料不受影响。"
          }
        }
      }
    },
    "help_pref_debug_info": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře diagnostiku zařízení a gamepadů bez streamu: údaje o zařízení, ID a senzory gamepadů, test vibrací, náhled ovládání."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Geräte- und Controller-Diagnose ohne Stream: Gerätedetails, Controller-IDs und Sensoren, Vibrationstest, Steuerungsvorschau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens device and controller diagnostics without a stream: device details, controller IDs and sensors, vibration test, control preview."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el diagnóstico del dispositivo y los mandos sin un stream: datos del dispositivo, ID y sensores de los mandos, prueba de vibración, vista previa de los controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre les diagnostics de l’appareil et des manettes sans stream : détails de l’appareil, ID et capteurs des manettes, test de vibration, aperçu des commandes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリームなしで、端末とコントローラーの診断を開きます：端末の詳細、コントローラーのIDとセンサー、振動テスト、コントロールのプレビュー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트림 없이 기기 및 컨트롤러 진단을 열어요: 기기 정보, 컨트롤러 ID와 센서, 진동 테스트, 컨트롤 미리보기."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o diagnóstico do dispositivo e dos controles sem um stream: detalhes do dispositivo, IDs e sensores dos controles, teste de vibração, prévia dos controles."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває діагностику пристрою й контролерів без стріму: дані пристрою, ID і датчики контролерів, тест вібрації, перегляд керування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需串流即可打开设备和手柄诊断：设备详情、手柄 ID 与传感器、震动测试、控制预览。"
          }
        }
      }
    },
    "help_seekbar_bitrate_kbps": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate videa v Mbps. Příliš vysoký způsobí sekání na slabém spojení. Menu streamu → Bitrate: jen pro tento stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video-Bitrate in Mbps. Zu hoch ruckelt auf einer schwachen Verbindung. Stream-Menü → Bitrate: nur für diesen Stream."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video bitrate in Mbps. Too high stutters on a weak link. Stream menu → Bitrate: this stream only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate del vídeo en Mbps. Si es demasiado alto, se entrecorta en un enlace débil. Menú del stream → Bitrate: solo este stream."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débit vidéo en Mbps. Trop élevé, ça saccade sur une liaison faible. Menu du stream → Débit : ce stream seulement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオビットレート（Mbps）です。高すぎると、弱い回線でカクつきます。ストリームメニュー → ビットレート：このストリームのみ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbps 단위의 비디오 비트레이트예요. 연결이 약한데 너무 높으면 끊겨요. 스트림 메뉴 → 비트레이트: 이번 스트림에만 적용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate do vídeo em Mbps. Muito alto causa travadas em conexão fraca. Menu do stream → Bitrate: só neste stream."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бітрейт відео в Mbps. Завеликий викликає підвисання на слабкому з’єднанні. Меню стріму, Бітрейт: лише для цього стріму."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频码率，单位 Mbps。链路较弱时设置过高会卡顿。串流菜单 > 码率：仅对本次串流生效。"
          }
        }
      }
    },
    "help_seekbar_deadzone": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kladné hodnoty ignorují malé pohyby sticku u středu (drift). Záporné hodnoty vyrovnávají vlastní mrtvou zónu gamepadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive Werte ignorieren kleine Stick-Bewegungen nahe der Mitte (Drift). Negative Werte gleichen die eigene Deadzone eines Controllers aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive values ignore small stick movement near center (drift). Negative values offset a controller's own dead zone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores positivos ignoran los pequeños movimientos del stick cerca del centro (deriva). Los negativos compensan la zona muerta propia del mando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs positives ignorent les petits mouvements du stick près du centre (dérive). Les valeurs négatives compensent la zone morte propre à la manette."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値にすると、中央付近のスティックの小さな動き（ドリフト）を無視します。負の値は、コントローラー自体のデッドゾーンを打ち消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "양수는 중앙 근처의 작은 스틱 움직임(드리프트)을 무시해요. 음수는 컨트롤러 자체의 데드존을 상쇄해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos ignoram pequenos movimentos do analógico perto do centro (drift). Valores negativos compensam a zona morta do próprio controle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додатні значення ігнорують малі рухи стіка біля центру (дрейф). Від’ємні компенсують власну мертву зону контролера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值会忽略摇杆在中心附近的轻微移动（漂移）。负值用于抵消手柄自身的死区。"
          }
        }
      }
    },
    "help_seekbar_gyro_smoothing": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilizuje míření gyrem. 0 je vypnuto. Vyšší hodnoty odstraní víc chvění, ale lehce zpozdí pomalý pohyb; rychlé švihy zůstávají citlivé. Platí od příštího streamu; v menu streamu (Více) to jde měnit za chodu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beruhigt das Gyro-Zielen. 0 ist aus. Höhere Werte entfernen mehr Zittern, bringen aber eine kleine Verzögerung bei langsamer Bewegung; schnelle Schwenks bleiben direkt. Gilt für den nächsten Stream; das Stream-Menü (Mehr) ändert es live."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steadies gyro aiming. 0 is off. Higher values remove more jitter but add a little delay to slow movement; fast flicks stay responsive. Applies to the next stream; the stream menu (More) changes it live."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabiliza la puntería con giroscopio. 0 es desactivado. Los valores altos eliminan más vibración, pero añaden un poco de retardo al moverse despacio; los movimientos rápidos siguen respondiendo. Se aplica al próximo stream; el menú del stream (Más) lo cambia en directo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stabilise la visée au gyroscope. 0 = désactivé. Plus la valeur est haute, moins il y a de tremblements, mais un léger retard sur les mouvements lents ; les mouvements rapides restent réactifs. S’applique au prochain stream ; le menu du stream (Plus) le modifie en direct."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャイロ照準を安定させます。0でオフ。値を上げるとブレが減りますが、ゆっくりした動きにわずかな遅れが出ます。素早い動きはそのまま反応します。次回のストリームから適用され、ストリームメニュー（その他）ではリアルタイムに変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자이로 조준을 안정시켜요. 0은 꺼짐이에요. 값이 높을수록 떨림이 줄지만 느린 움직임에 약간의 지연이 생겨요. 빠른 플릭은 그대로 반응해요. 다음 스트림부터 적용되며, 스트림 메뉴(더보기)에서는 실시간으로 바꿀 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabiliza a mira com giroscópio. 0 é desativado. Valores maiores removem mais tremor, mas adicionam um pouco de atraso em movimentos lentos; movimentos rápidos continuam responsivos. Vale a partir do próximo stream; o menu do stream (Mais) altera na hora."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стабілізує прицілювання гіроскопом. 0 — вимкнено. Вищі значення прибирають більше тремтіння, але додають трохи затримки повільним рухам; швидкі помахи лишаються чутливими. Діє з наступного стріму; меню стріму (Ще) змінює це наживо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳定陀螺仪瞄准。0 表示关闭。值越高，抖动越少，但缓慢移动会略有延迟；快速甩动仍保持灵敏。下次串流生效；串流菜单（更多）可实时调整。"
          }
        }
      }
    },
    "help_seekbar_keyboard_axi_opacity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprůhlednost plné klávesnice na obrazovce. Nezávislá na neprůhlednosti virtuálního gamepadu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckkraft der Volltastatur auf dem Bildschirm. Getrennt von der Deckkraft des virtuellen Gamepads."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacity of the full on-screen keyboard. Separate from virtual gamepad opacity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacidad del teclado completo en pantalla. Independiente de la opacidad del mando virtual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacité du clavier complet à l’écran. Distincte de l’opacité de la manette virtuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のフルキーボードの不透明度です。仮想コントローラーの不透明度とは別です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면 키보드의 투명도예요. 가상 게임패드 투명도와는 별개예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacidade do teclado completo na tela. Separada da opacidade do controle virtual."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прозорість повної екранної клавіатури. Окрема від прозорості віртуального контролера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整屏幕键盘的不透明度。与虚拟手柄的不透明度相互独立。"
          }
        }
      }
    },
    "help_seekbar_metered_bitrate_kbps": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate v měřené síti (mobilní data, některé hotspoty). Hodnota 0 použije čtvrtinu běžného bitrate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate in einem getakteten Netzwerk (Mobilfunk, manche Hotspots). 0 nutzt ein Viertel der normalen Bitrate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate on a metered network (mobile data, some hotspots). 0 uses a quarter of the normal bitrate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate en una red de datos limitados (datos móviles, algunos puntos de acceso). Con 0 se usa una cuarta parte del bitrate normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débit sur un réseau limité (données mobiles, certains partages de connexion). 0 utilise un quart du débit normal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "従量制ネットワーク（モバイルデータ、一部のホットスポット）でのビットレートです。0にすると通常のビットレートの4分の1になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종량제 네트워크(모바일 데이터, 일부 핫스팟)에서의 비트레이트예요. 0이면 일반 비트레이트의 4분의 1을 사용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitrate em rede limitada (dados móveis, alguns hotspots). 0 usa um quarto do bitrate normal."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бітрейт у мережі з лімітом трафіку (мобільні дані, деякі точки доступу). 0 — чверть звичайного бітрейту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按流量计费网络（移动数据、部分热点）下的码率。0 表示使用常规码率的四分之一。"
          }
        }
      }
    },
    "help_seekbar_onscreen_keyboard_height": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výška plné klávesnice na obrazovce při vypnutém automatickém přizpůsobení. Vyšší: větší klávesy, víc zakryté aplikace."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höhe der Volltastatur auf dem Bildschirm bei ausgeschaltetem Einpassen. Höher: größere Tasten, mehr von der App verdeckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Height of the full on-screen keyboard when automatic fitting is off. Taller: larger keys, more of the app covered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura del teclado completo en pantalla cuando el ajuste automático está desactivado. Más alto: teclas más grandes, más de la app tapada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur du clavier complet à l’écran quand l’ajustement automatique est désactivé. Plus haut : touches plus grandes, plus d’appli masquée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動調整がオフのときの、画面上のフルキーボードの高さです。高いほどキーは大きくなりますが、アプリが隠れる範囲も広がります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 맞춤이 꺼져 있을 때 전체 화면 키보드의 높이예요. 높을수록 키가 커지지만 앱을 더 많이 가려요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura do teclado completo na tela quando o ajuste automático está desativado. Mais alto: teclas maiores, mais do app coberto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Висота повної екранної клавіатури, коли автопідлаштування вимкнено. Вища: більші клавіші, але більше закритого застосунку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭自动适配时完整屏幕键盘的高度。越高：按键越大，但遮挡的应用画面越多。"
          }
        }
      }
    },
    "help_seekbar_onscreen_keyboard_width": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šířka plné klávesnice na obrazovce při vypnutém automatickém přizpůsobení. Nech ji dosažitelnou na své obrazovce."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite der Volltastatur auf dem Bildschirm bei ausgeschaltetem Einpassen. Halte sie auf deinem Bildschirm erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Width of the full on-screen keyboard when automatic fitting is off. Keep it reachable on your screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchura del teclado completo en pantalla cuando el ajuste automático está desactivado. Mantenlo al alcance en tu pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Largeur du clavier complet à l’écran quand l’ajustement automatique est désactivé. Garde-le accessible sur ton écran."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動調整がオフのときの、画面上のフルキーボードの幅です。画面上で手が届く範囲に収めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 맞춤이 꺼져 있을 때 전체 화면 키보드의 너비예요. 화면에서 손이 닿는 크기로 유지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Largura do teclado completo na tela quando o ajuste automático está desativado. Mantenha ao alcance na sua tela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ширина повної екранної клавіатури, коли автопідлаштування вимкнено. Дотримуйся досяжності на твоєму екрані."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭自动适配时完整屏幕键盘的宽度。请确保在你的屏幕上能够够得到。"
          }
        }
      }
    },
    "help_seekbar_osc_free_analog_stick_opacity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Viditelnost pozadí volného virtuálního sticku v klidu. Nízká hodnota nechává obraz čistší; vysoká se snáz hledá."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichtbarkeit des Hintergrunds des freien virtuellen Sticks im Ruhezustand. Niedrig hält das Bild klarer; hoch ist leichter zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibility of the free virtual stick's background while idle. Low keeps the picture clearer; high is easier to find."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibilidad del fondo del stick virtual libre en reposo. Bajo deja la imagen más limpia; alto es más fácil de encontrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibilité de l’arrière-plan du stick virtuel libre au repos. Bas : image plus claire ; haut : plus facile à repérer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待機中のフリー仮想スティックの背景の見えやすさです。低いと映像が見やすく、高いと見つけやすくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리 가상 스틱을 쓰지 않을 때 배경이 얼마나 보일지 정해요. 낮으면 화면이 더 깨끗하고, 높으면 찾기 쉬워요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visibilidade do fundo do analógico virtual livre quando parado. Baixa deixa a imagem mais limpa; alta é mais fácil de achar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видимість тла вільного віртуального стіка в спокої. Низька робить картинку чистішою; висока — легше знайти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自由虚拟摇杆在空闲时背景的可见度。低则画面更清爽；高则更容易找到。"
          }
        }
      }
    },
    "help_seekbar_osc_opacity": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neprůhlednost virtuálního gamepadu a vlastních ovládacích prvků speciálních kláves. Nezávislá na neprůhlednosti plné klávesnice."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckkraft des virtuellen Gamepads und der eigenen Sondertasten. Getrennt von der Deckkraft der Volltastatur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacity of the virtual gamepad and custom special-key controls. Separate from full-keyboard opacity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacidad del mando virtual y de los controles de teclas especiales personalizados. Independiente de la opacidad del teclado completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacité de la manette virtuelle et des commandes de touches spéciales personnalisées. Distincte de l’opacité du clavier complet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮想コントローラーとカスタム特殊キーの不透明度です。フルキーボードの不透明度とは別です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가상 게임패드와 사용자 지정 특수 키 컨트롤의 투명도예요. 전체 키보드 투명도와는 별개예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opacidade do controle virtual e dos controles de teclas especiais personalizados. Separada da opacidade do teclado completo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прозорість віртуального контролера й власних елементів зі спеціальними клавішами. Окрема від прозорості повної клавіатури."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "虚拟手柄和自定义特殊按键的不透明度。与完整键盘的不透明度相互独立。"
          }
        }
      }
    },
    "help_seekbar_resolution_scale_factor": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změní měřítko virtuálního displeje PC: při 150 %% se 1920 × 1080 vykreslí v PC jako 2880 × 1620. Stojí výkon GPU v PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaliert das virtuelle Host-Display: Bei 150%% wird 1920 × 1080 auf dem PC als 2880 × 1620 gerendert. Kostet GPU-Leistung am PC."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scales the host virtual display: at 150%%, 1920 × 1080 renders as 2880 × 1620 on the PC. Costs PC GPU."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escala la pantalla virtual del host: al 150%%, 1920 × 1080 se renderiza como 2880 × 1620 en el PC. Consume GPU del PC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met à l’échelle l’écran virtuel du PC : à 150 %%, 1920 × 1080 s’affiche en 2880 × 1620 sur le PC. Coûte du GPU côté PC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストの仮想ディスプレイを拡大縮小します。150%%の場合、1920 × 1080はPC上で2880 × 1620としてレンダリングされます。PCのGPUに負荷がかかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호스트 가상 디스플레이를 확대해요. 150%%면 1920 × 1080이 PC에서 2880 × 1620으로 렌더링돼요. PC GPU를 더 써요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensiona a tela virtual do PC: com 150%%, 1920 × 1080 é renderizado como 2880 × 1620 no PC. Consome GPU do PC."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Масштабує віртуальний екран хоста: при 150%% 1920 × 1080 рендериться як 2880 × 1620 на ПК. Навантажує GPU ПК."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩放电脑端虚拟显示器：150%% 时，1920 × 1080 会在 PC 上以 2880 × 1620 渲染。会占用 PC 的 GPU。"
          }
        }
      }
    },
    "help_seekbar_touch_sensitivity_opacity_x": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodorovná citlivost multitouch vstupu do her; vyšší hodnota mění malý pohyb prstu ve větší pohyb ve hře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontale Empfindlichkeit der Multitouch-Spieleingabe; höher macht aus kleiner Fingerbewegung größere Bewegung im Spiel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal sensitivity of multi-touch game input; higher turns small finger movement into larger in-game movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidad horizontal de la entrada de juego multitáctil; más valor convierte pequeños movimientos del dedo en movimientos mayores en el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilité horizontale des entrées de jeu multitouch ; plus haut, un petit mouvement du doigt devient un plus grand mouvement dans le jeu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルチタッチのゲーム入力の横方向の感度です。高いほど、指の小さな動きがゲーム内で大きな動きになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀티터치 게임 입력의 가로 감도예요. 높을수록 작은 손가락 움직임이 게임에서 더 크게 움직여요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensibilidade horizontal da entrada multitoque do jogo; maior transforma um pequeno movimento do dedo em um movimento maior no jogo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Горизонтальна чутливість мультитач-введення в іграх; вища перетворює малий рух пальця на більший рух у грі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多点触控游戏输入的水平灵敏度；越高，手指的小幅移动会转化为越大的游戏内移动。"
          }
        }
      }
    },
    "help_seekbar_touch_sensitivity_opacity_y": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svislá citlivost multitouch vstupu do her; vyšší hodnota mění malý pohyb prstu ve větší pohyb ve hře."
