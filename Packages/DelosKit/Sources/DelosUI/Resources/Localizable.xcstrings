    "debug_display_virtual_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Překryvný, virtuální nebo soukromý displej. Delos na něj nikdy nedává stream."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Overlay-, virtuelles oder privates Display. Delos legt den Stream nie darauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An overlay, virtual or private display. Delos never puts the stream on it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una pantalla superpuesta, virtual o privada. Delos nunca pone el stream en ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un écran superposé, virtuel ou privé. Delos n’y place jamais le stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーバーレイ、仮想、またはプライベートなディスプレイです。Delosがストリームを表示することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오버레이, 가상 또는 비공개 디스플레이예요. Delos는 스트림을 표시하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tela sobreposta, virtual ou privada. Delos nunca coloca o stream nela."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Накладений, віртуальний або приватний екран. Delos ніколи не виводить на нього стрім."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "叠加层、虚拟或私有显示屏。Delos 绝不会把串流放到上面。"
          }
        }
      }
    },
    "debug_enabled_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnuto používá překlad Původní. Zapnuto uplatní tyto parametry na vibrace ve streamu i na vzory z laboratoře."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus nutzt die Original-Übersetzung. An wendet diese Parameter auf Stream-Vibration und Labormuster an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off uses Original translation. On applies these parameters to streaming rumble and lab patterns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado usa la traducción Original. Activado aplica estos parámetros a la vibración del stream y a los patrones del laboratorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : traduction Originale. Activé : applique ces paramètres aux vibrations du stream et aux motifs du labo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフではオリジナルの変換を使います。オンにすると、これらのパラメーターをストリーミング中の振動とラボのパターンに適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 Original 변환을 사용해요. 켜면 이 매개변수를 스트리밍 럼블과 실험실 패턴에 적용해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado usa a tradução Original. Ativado aplica estes parâmetros à vibração da transmissão e aos padrões do laboratório."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнено — оригінальна трансляція. Увімкнено — ці параметри застосовуються до вібрації стріму та шаблонів лабораторії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时使用原始转换。开启时，将这些参数应用于串流震动和实验室波形。"
          }
        }
      }
    },
