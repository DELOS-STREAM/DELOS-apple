    "debug_unavailable_tv": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Apple TV není k dispozici: neumí ukládat soubory, sdílet je ani kopírovat text."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Apple TV nicht verfügbar: Es kann keine Dateien speichern oder teilen und keinen Text kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available on Apple TV: it cannot save files, share them or copy text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible en Apple TV: no puede guardar archivos, compartirlos ni copiar texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible sur Apple TV : elle ne peut ni enregistrer ni partager de fichiers, ni copier du texte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TVでは使えません：ファイルの保存や共有、テキストのコピーができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV에서는 사용할 수 없어요: 파일을 저장하거나 공유할 수 없고 텍스트도 복사할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponível na Apple TV: ela não consegue salvar arquivos, compartilhá-los nem copiar texto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недоступно на Apple TV: вона не може зберігати файли, ділитися ними чи копіювати текст."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV 上不可用：它无法保存或分享文件，也无法复制文本。"
          }
        }
      }
    },
