    "summary_checkbox_enforce_display_mode": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vynutí, aby plocha vykreslování používala optimální režim displeje.\nVyžadují to některé systémy (například ColorOS), aby správně nastavily obnovovací frekvenci a rozlišení.\nNezapínej na ChromeCast 4K, mohlo by to vést k chybám."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwingt die Surface, den optimalen Display-Modus zu nutzen.\nVon manchen Systemen (z. B. ColorOS) benötigt, um Bildwiederholrate/Auflösung korrekt zu setzen.\nAuf dem ChromeCast 4K nicht aktivieren, da es zu Fehlern führen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Force surface to use the optimal display mode.\nRequired by some systems (such as ColorOS) to set refresh rate/resolution properly.\nDo not enable on ChromeCast 4K as it might lead to bugs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obliga a la superficie a usar el modo de pantalla óptimo.\nLo requieren algunos sistemas (como ColorOS) para fijar bien la frecuencia de actualización/resolución.\nNo lo actives en ChromeCast 4K, ya que puede causar errores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Force la surface à utiliser le mode d’affichage optimal.\nRequis par certains systèmes (comme ColorOS) pour régler correctement fréquence/résolution.\nNe l’active pas sur ChromeCast 4K : cela peut causer des bugs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーフェスに最適なディスプレイモードを強制的に使わせます。\nリフレッシュレートや解像度を正しく設定するために、一部のシステム（ColorOSなど）で必要です。\n不具合の原因になるため、ChromeCast 4Kでは有効にしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서피스가 최적의 디스플레이 모드를 사용하도록 강제해요.\n일부 시스템(예: ColorOS)에서 주사율/해상도를 제대로 설정하려면 필요해요.\n버그가 생길 수 있으니 ChromeCast 4K에서는 켜지 마세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Força a superfície a usar o modo de tela ideal.\nExigido por alguns sistemas (como o ColorOS) para definir corretamente a taxa de atualização/resolução.\nNão ative no ChromeCast 4K, pois pode causar bugs."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Примусово використовувати для поверхні оптимальний режим екрана.\nПотрібно в деяких системах (як-от ColorOS) для правильної частоти оновлення/роздільної здатності.\nНе вмикай на ChromeCast 4K, бо можливі збої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强制 Surface 使用最佳显示模式。\n部分系统（如 ColorOS）需要此项才能正确设置刷新率/分辨率。\n请勿在 ChromeCast 4K 上启用，否则可能出现问题。"
          }
        }
      }
    },
    "summary_checkbox_reduce_refresh_rate": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nižší obnovovací frekvence displeje může ušetřit energii za cenu mírně vyšší latence videa"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedrigere Bildwiederholraten können Strom sparen, auf Kosten etwas höherer Videolatenz"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower display refresh rates can save power at the expense of some additional video latency"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las frecuencias de actualización más bajas pueden ahorrar batería a costa de algo más de latencia de vídeo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fréquence d’écran plus basse économise de l’énergie, au prix d’un peu de latence vidéo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイのリフレッシュレートを下げると省電力になりますが、映像の遅延が少し増えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 주사율을 낮추면 전력을 아낄 수 있지만 영상 지연이 조금 늘어나요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxas de atualização menores da tela podem economizar energia, ao custo de um pouco mais de latência no vídeo"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижча частота оновлення екрана заощаджує заряд коштом трохи більшої затримки відео"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降低显示刷新率可以省电，但会增加一些视频延迟"
          }
        }
      }
    },
    "summary_debug_info": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Test vibrací gamepadu a další věci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste Gamepad-Vibration und mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test gamepad vibration and other stuff."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba la vibración del mando y otras cosas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste la vibration de la manette et d’autres choses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
