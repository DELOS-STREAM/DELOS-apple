    "settings_native_missing_artwork_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stáhne obrázky pro aplikace z PC %1$@, které je nemají."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt Artwork für die Apps von %1$@, die keins haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches artwork for the apps of %1$@ that have none."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtiene ilustraciones para las apps de %1$@ que no tienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupère les visuels des applis de %1$@ qui n’en ont pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@のアプリのうち、アートワークがないものを取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 아트워크가 없는 앱의 아트워크를 가져와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca arte para os apps de %1$@ que não têm nenhuma."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бере ілюстрації для застосунків на %1$@, у яких їх немає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %1$@ 中没有图片素材的应用获取素材。"
          }
        }
      }
    },
