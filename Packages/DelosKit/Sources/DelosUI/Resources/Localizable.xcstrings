    "settings_tab_about_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos je fork aplikací Artemis a Moonlight, licencovaný pod GPLv3."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos ist ein Fork von Artemis und Moonlight unter der GPLv3."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos is a fork of Artemis and Moonlight, licensed under the GPLv3."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos es una bifurcación de Artemis y Moonlight, con licencia GPLv3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos est un fork d’Artemis et Moonlight, sous licence GPLv3."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DelosはArtemisとMoonlightのフォークで、GPLv3でライセンスされています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos는 Artemis와 Moonlight의 포크이며 GPLv3 라이선스를 따라요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Delos é um fork do Artemis e do Moonlight, licenciado sob a GPLv3."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos — форк Artemis і Moonlight з ліцензією GPLv3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos 是 Artemis 和 Moonlight 的分支，采用 GPLv3 许可。"
