    "settings_tab_appearance_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Motiv, barvy a animované pozadí. Změny se projeví okamžitě."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme, Farben und animierter Hintergrund. Änderungen gelten sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Theme, colors and the animated background. Changes apply immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, colores y fondo animado. Los cambios se aplican al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème, couleurs et arrière-plan animé. Les changements s’appliquent tout de suite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ、色、アニメーション背景です。変更はすぐに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마, 색상, 움직이는 배경을 설정해요. 변경 사항은 바로 적용돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema, cores e plano de fundo animado. As mudanças valem na hora."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тема, кольори й анімоване тло. Зміни застосовуються одразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题、颜色和动态背景。更改立即生效。"
          }
        }
      }
    },
