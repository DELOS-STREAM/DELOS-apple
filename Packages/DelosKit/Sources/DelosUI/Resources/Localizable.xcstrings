    "help_list_video_scale_mode_fill": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyplní obrazovku; ořízne, když se poměry stran liší."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt den Bildschirm; beschneidet, wenn die Seitenverhältnisse abweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills the screen; crops if aspect ratios differ."
          }
