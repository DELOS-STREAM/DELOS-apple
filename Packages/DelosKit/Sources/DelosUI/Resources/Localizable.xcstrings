          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → カバー → SteamGridDB APIキー。steamgriddb.comで無料で取得できます（Preferences → API）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 커버 → SteamGridDB API 키. steamgriddb.com에서 무료로 받을 수 있어요 (Preferences → API)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurações → Capas → Chave de API do SteamGridDB. É grátis em steamgriddb.com (Preferences → API)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування > Обкладинки > Ключ API SteamGridDB. Він безкоштовний на steamgriddb.com (Preferences > API)."
