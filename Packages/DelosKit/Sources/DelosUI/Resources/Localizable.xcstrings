    "settings_native_sgdb_key_note": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdarma na steamgriddb.com: přihlas se a pak Preferences → API. Nech prázdné, pokud nechceš SteamGridDB používat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos auf steamgriddb.com: anmelden, dann Preferences → API. Leer lassen, um SteamGridDB nicht mehr zu nutzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free on steamgriddb.com: sign in, then Preferences → API. Leave it empty to stop using SteamGridDB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis en steamgriddb.com: inicia sesión y ve a Preferences → API. Déjala vacía para dejar de usar SteamGridDB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuite sur steamgriddb.com : connecte-toi, puis Preferences → API. Laisse vide pour ne plus utiliser SteamGridDB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "steamgriddb.comで無料で取得できます。サインインして、Preferences → APIを開いてください。空欄にするとSteamGridDBを使用しなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "steamgriddb.com에서 무료로 받을 수 있어요. 로그인한 뒤 Preferences → API로 이동하세요. 비워 두면 SteamGridDB를 사용하지 않아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis em steamgriddb.com: entre e vá em Preferences → API. Deixe vazio para parar de usar o SteamGridDB."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безкоштовно на steamgriddb.com: увійди, потім Preferences → API. Залиш порожнім, щоб не використовувати SteamGridDB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在 steamgriddb.com 免费获取：登录后进入 偏好设置 > API。留空则停止使用 SteamGridDB。"
          }
        }
      }
    },
