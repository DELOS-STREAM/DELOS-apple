    },
    "debug_no_pads_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připoj gamepad a hned se tady objeví. Vestavěné ovládání handheldu se počítá jako jeden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde einen Controller, er erscheint sofort hier. Die eingebaute Steuerung eines Handhelds zählt als einer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a controller and it shows up here at once. The built-in controls of a handheld count as one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un mando y aparecerá aquí al instante. Los controles integrados de una consola portátil cuentan como uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecte une manette et elle apparaît ici aussitôt. Les commandes intégrées d’une console portable comptent pour une."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コントローラーを接続すると、すぐにここに表示されます。携帯ゲーム機の内蔵コントロールは1台として扱われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨트롤러를 연결하면 바로 여기에 표시돼요. 휴대용 기기의 내장 컨트롤은 하나로 계산해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um controle e ele aparece aqui na hora. Os controles integrados de um portátil contam como um."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключи контролер, і він одразу з’явиться тут. Вбудовані елементи керування портативної консолі рахуються за один."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接手柄后会立即显示在这里。掌机的内置按键算作一个手柄。"
          }
        }
      }
    },
