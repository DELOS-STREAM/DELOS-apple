    "stream_result_decoder": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení nedokázalo spustit video dekodér."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät konnte den Videodecoder nicht starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device couldn't start the video decoder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no ha podido iniciar el decodificador de vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas pu démarrer le décodeur vidéo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末はビデオデコーダーを開始できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 비디오 디코더를 시작하지 못했어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não conseguiu iniciar o decodificador de vídeo."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не зміг запустити відеодекодер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法启动视频解码器。"
          }
        }
      }
    },
    "stream_result_decoder_details": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicializace video dekodéru selhala. Tvoje zařízení nemusí podporovat zvolené rozlišení nebo snímkovou frekvenci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Videodecoder konnte nicht initialisiert werden. Dein Gerät unterstützt die gewählte Auflösung oder Bildrate möglicherweise nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video decoder failed to initialize. Your device may not support the selected resolution or frame rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo inicializar el decodificador de vídeo. Puede que tu dispositivo no admita la resolución o la tasa de fotogramas elegidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’initialisation du décodeur vidéo. Ton appareil ne gère peut-être pas la résolution ou la fréquence d’images choisie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオデコーダーの初期化に失敗しました。端末が選択した解像度またはフレームレートに対応していない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 디코더를 초기화하지 못했어요. 기기가 선택한 해상도나 프레임 레이트를 지원하지 않을 수 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao inicializar o decodificador de vídeo. Seu dispositivo pode não suportar a resolução ou a taxa de quadros selecionada."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося ініціалізувати відеодекодер. Можливо, пристрій не підтримує вибрану роздільну здатність або частоту кадрів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
