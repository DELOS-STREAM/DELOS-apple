    "settings_native_refresh_artwork_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu vyhledá každou aplikaci a vezme nejlépe hodnocené obrázky; ručně vybrané obrázky zůstanou."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht jede App erneut und nimmt die bestbewerteten Bilder; von dir gewählte bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks up every app again and takes the best-rated images; ones you picked stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca de nuevo cada app y toma las imágenes mejor valoradas; las que hayas elegido se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche à nouveau chaque appli et prend les images les mieux notées ; celles que tu as choisies restent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリをもう一度検索し、最高評価の画像を使います。ご自身で選んだものはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 앱을 다시 검색해 평점이 가장 높은 이미지를 가져와요. 직접 고른 이미지는 그대로 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca todos os apps de novo e usa as imagens mais bem avaliadas; as que você escolheu permanecem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шукає кожен застосунок заново й бере найкраще оцінені зображення; обрані тобою залишаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新查找每个应用并选用评分最高的图片；你已选择的图片会保留。"
          }
        }
      }
    },
