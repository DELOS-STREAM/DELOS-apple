    "settings_native_welcome_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Znovu otevře uvítací obrazovku. Profily a spárovaná PC zůstanou zachovány."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Willkommensbildschirm erneut. Profile und gekoppelte PCs bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the welcome screen again. Profiles and paired PCs are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir la pantalla de bienvenida. Los perfiles y los PC emparejados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvre l’écran de bienvenue. Les profils et les PC associés sont conservés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェルカム画面をもう一度開きます。プロフィールとペアリング済みのPCは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환영 화면을 다시 열어요. 프로필과 페어링된 PC는 그대로 유지돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a tela de boas-vindas novamente. Perfis e PCs pareados são mantidos."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знову відкриває екран вітання. Профілі й спарені ПК зберігаються."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再次打开欢迎页。个人资料和已配对的 PC 会保留。"
          }
        }
      }
    },
