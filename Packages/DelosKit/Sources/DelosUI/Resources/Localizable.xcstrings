            "state": "translated",
            "value": "アプリの色に合わせる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 색상에 맞추기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Combinar com as cores do app"
          }
        },
        "uk": {
