    "debug_log_description": {
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Události a chyby, které si aplikace Delos uložila na tomto zařízení, s odstraněnými adresami a jmény. Přesně tohle odešle Sdílet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ereignisse und Fehler, die Delos auf diesem Gerät gespeichert hat, ohne Adressen und Namen. Das sendet „Teilen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Events and errors Delos kept on this device, with addresses and names removed. This is what Share sends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos y errores que Delos ha guardado en este dispositivo, sin direcciones ni nombres. Esto es lo que envía Compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Événements et erreurs que Delos a gardés sur cet appareil, sans adresses ni noms. C’est ce que Partager envoie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Delosがこの端末に保存したイベントとエラーです。アドレスと名前は削除されています。「共有」で送信されるのはこの内容です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소와 이름을 제거하고 Delos가 이 기기에 보관한 이벤트와 오류예요. 공유를 누르면 이 내용이 전송돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eventos e erros que o app Delos guardou neste dispositivo, sem endereços e nomes. É isto que Compartilhar envia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Події та помилки, які Delos зберіг на цьому пристрої, без адрес і імен. Саме це надсилає «Поділитися»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Delos 在此设备上保留的事件和错误，已去除地址和名称。分享时发送的就是这些内容。"
          }
        }
      }
    },
