#!/bin/sh
# Refuses to create a branch on the remote whose name is not valid (tools/hooks/check-branch-name.sh). A branch
# that already exists on the remote under an older name only gets a warning, so it can still be updated. Tags and
# deletions are not checked. Enable once per clone:  git config core.hooksPath tools/hooks
# git passes one line per pushed ref on standard input: <local ref> <local sha> <remote ref> <remote sha>.

check="$(cd "$(dirname "$0")" && pwd)/check-branch-name.sh"
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac
    # A deletion pushes the all-zero object name.
    [ -n "$(printf '%s' "$local_sha" | tr -d '0')" ] || continue
    if ! sh "$check" "${remote_ref#refs/heads/}"; then
        if [ -n "$(printf '%s' "$remote_sha" | tr -d '0')" ]; then
            echo "pre-push: warning only: the branch already exists on the remote" >&2
        else
            status=1
        fi
    fi
done
exit $status
